{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "Shell|Read|Write|Grep|Delete",
        "command": "node scripts/ide-pre-tool-hook.js",
        "failClosed": true,
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "type": "command",
        "matcher": "Write",
        "command": "node scripts/ide-post-edit-hook.js",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
