# ─────────────────────────────────────────────────────────────────────────────
# Studio DNA Engine — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependências ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build / Framework Caches ──────────────────────────────────────────────────
dist/
dist-community/
build/
out/
.output/
.next/
.nuxt/
.turbo/
.cache/
.parcel-cache/
.astro/
.svelte-kit/

# ── Copias (Awwwards scrapes brutos e pesados) ─────────────────────────────────
copias/
!copias/README.md

# ── Clientes de Produção & Projetos Customizados ──────────────────────────────
# Manter arquivos estruturais e DNA, ignorar dumps de assets pesados e screenshots
clientes/**/site/assets/
clientes/**/qa-reports/*.png
clientes/**/qa-reports/*.jpg
projetos/**/site/assets/
!clientes/README.md
!projetos/README.md

# ── Imagens e Mídias Binárias (Design Vault, Clientes, Scrapes e QA) ─────────
*.avif
*.webp
*.jpg
*.jpeg
*.png
*.gif
*.mp4
*.webm
*.mov

design-vault/*/tokens.json
design-vault/*/tailwind.config.js
design-vault/*/brand-spec.template.json
design-vault/**/site/assets/

# ── QA Reports & Screenshots de Auditoria ────────────────────────────────────
qa-reports/
playwright-report/
test-results/
blob-report/
.playwright/
coverage/
.nyc_output/

# ── Temporários & Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.bak
*.backup
*.tmp
*.temp
*~
*.swp
*.swo
temp-*/
.temp/
scratch/
.tempmediaStorage/

# ── Arquivos HTML soltos na raiz de copias (clone dumps antigos) ──────────────
copias/*.html

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Sistema Operacional & IDEs ────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
