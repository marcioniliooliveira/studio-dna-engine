# ─────────────────────────────────────────────────────────────────────────────
# Studio DNA Engine — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependências ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.worktrees/

# Standalone design/HTML exports belong inside external workspace client folders, not the repo root
/*.html

# ── Build / Framework Caches ──────────────────────────────────────────────────
dist/
dist-community/
build/
out/
.output/
.next/
.nuxt/
.turbo/
.cache/
.parcel-cache/
.astro/
.svelte-kit/

# ── Workspaces Locais (Copias & Clientes - untracked; prefira --workspace externo) ─
copias/*
!copias/README.md
clientes/*
!clientes/README.md
projetos/*
!projetos/README.md
design-vault/**/site/assets/

# ── Imagens e Mídias Binárias (Design Vault, Clientes, Scrapes e QA) ─────────
*.avif
*.webp
*.jpg
*.jpeg
*.png
*.gif
*.mp4
*.webm
*.mov

# Artefatos mínimos e reproduzíveis do template piloto Elyse
!design-vault/elyse-residence-dev-webflow-io/assets/**/*.avif
!design-vault/elyse-residence-dev-webflow-io/assets/**/*.jpg
!design-vault/elyse-residence-dev-webflow-io/assets/**/*.mp4
!design-vault/elyse-residence-dev-webflow-io/assets/**/*.webm

# ── QA Reports & Screenshots de Auditoria ────────────────────────────────────
qa-reports/
playwright-report/
test-results/
blob-report/
.playwright/
coverage/
.nyc_output/

# ── Temporários & Logs ────────────────────────────────────────────────────────
.staging/
.impeccable/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.bak
*.backup
*.tmp
*.temp
*~
*.swp
*.swo
temp-*/
.temp/
scratch/
.tempmediaStorage/
*-report.json
*_analysis.json
gemini-code-*.html
clientes/**/gemini-code-*.html
clientes/**/dist-*/
clientes/**/nextjs-dist/
clientes/**/build-manifest.json
preview-dump.json
chatorb-raw-decompiled.js

# ── Arquivos HTML soltos na raiz de copias (clone dumps antigos) ──────────────
copias/*.html

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Agent Teamwork Logs, Domscribe & Runtime Data Store ─────────────────────
.agents/teamwork/
.domscribe/
data/

# ── Sistema Operacional & IDEs ────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
