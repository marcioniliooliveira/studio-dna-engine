{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 2 },
    "contractKind": { "type": "string", "const": "reference-candidate" },
    "candidateId": { "type": "string", "minLength": 1 },
    "clientScope": { "type": "string", "minLength": 1 },
    "sourceType": {
      "type": "string",
      "enum": ["git-repository", "web-page", "uploaded-image", "local-capture", "figma-file", "penpot-file", "design-system", "client-asset"]
    },
    "roles": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "enum": ["composition", "typography", "motion", "material", "image-treatment", "interaction", "conversion", "accessibility", "code-pattern"] }
    },
    "usageIntent": { "type": "string", "enum": ["inspiration-only", "code-candidate", "asset-candidate"] },
    "provenance": {
      "type": "object",
      "properties": {
        "canonicalUri": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "license": {
          "type": "object",
          "properties": {
            "spdxId": { "type": "string", "minLength": 1 },
            "evidenceUri": { "type": "string", "format": "uri" }
          },
          "required": ["spdxId", "evidenceUri"],
          "additionalProperties": false
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "contentSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["canonicalUri"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "contractKind", "candidateId", "clientScope", "sourceType", "roles", "usageIntent", "provenance"],
  "additionalProperties": false
}
