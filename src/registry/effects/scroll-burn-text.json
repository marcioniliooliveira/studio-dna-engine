{
  "id": "scroll-burn-text",
  "name": "Scroll Burn Reveal",
  "category": "typography-transition",
  "author": "ruixen.ui / Studio DNA Engine",
  "version": "1.0.0",
  "description": "Kinetic typography reveal where active text scales toward the lens, separates red/cyan chromatic edges, and burns off glyph-by-glyph from the middle out to reveal the next phrase.",
  "prerequisites": {
    "cssClasses": ["burn-text", "burn-char", "burning"],
    "svgFilters": []
  },
  "bindings": {
    "targetAttribute": "data-transition-style",
    "attributeValue": "burn",
    "supportedSelectors": ["#strip", "#engines", "[data-dna-effect]"]
  },
  "parameters": [
    {
      "id": "burnSpread",
      "type": "slider",
      "label": "Burn Middle-Out Spread",
      "min": 0.05,
      "max": 0.45,
      "step": 0.01,
      "default": 0.16
    },
    {
      "id": "chromaticOffset",
      "type": "slider",
      "label": "Chromatic Split (px)",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "default": 3.0
    },
    {
      "id": "expansionScale",
      "type": "slider",
      "label": "Approaching Lens Scale",
      "min": 1.05,
      "max": 1.6,
      "step": 0.05,
      "default": 1.3
    }
  ]
}
