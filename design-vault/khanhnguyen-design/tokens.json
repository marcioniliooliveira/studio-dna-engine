{
  "name": "Khanh Nguyen Portfolio Design Tokens",
  "slug": "khanhnguyen-design",
  "colors": {
    "palette": {
      "charcoal": "#262220",
      "charcoalDark": "#2E2B28",
      "obsidian": "#1F1D1B",
      "warmGraphite": "#3A3632",
      "headerBorderDark": "#5A524D",
      "linenPaper": "#FAF9F6",
      "sandGray": "#EDEAE6",
      "ivoryText": "#F3EEE8",
      "mutedAccent": "#8A8178",
      "lightBorder": "#B8B3AC",
      "lightPaperBorder": "#E2DED9"
    },
    "bySection": {
      "loading": { "bg": "#262220", "text": "#F3EEE8", "headerBg": "#3A3632", "headerBorder": "#5A524D" },
      "about": { "bg": "#FAF9F6", "text": "#2E2B28", "headerBg": "#FAF9F6", "headerBorder": "#B8B3AC" },
      "moreWork": { "bg": "#FAF9F6", "text": "#2E2B28", "headerBg": "#FAF9F6", "headerBorder": "#B8B3AC" },
      "selectedWork": { "bg": "#EDEAE6", "text": "#2E2B28", "headerBg": "#EDEAE6", "headerBorder": "#B8B3AC" },
      "services": { "bg": "#2E2B28", "text": "#FAF9F6", "headerBg": "#2E2B28", "headerBorder": "#5A524D" },
      "clients": { "bg": "#EDEAE6", "text": "#2E2B28", "headerBg": "#EDEAE6", "headerBorder": "#B8B3AC" },
      "contact": { "bg": "#1F1D1B", "text": "#CCCCCC", "headerBg": "#1F1D1B", "headerBorder": "#5A524D" }
    }
  },
  "typography": {
    "fonts": {
      "display": "\"PP Editorial Old\", serif",
      "body": "\"PP Neue Montreal\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"PP Neue Montreal\", monospace"
    },
    "scaleFormula": "calc(10vw / 14.4)",
    "rules": {
      "heroName": "calc(18.1 * var(--scale))",
      "yearStrip": "calc(18.1 * var(--scale))",
      "mobileHeroName": "calc(9 * var(--scale))",
      "menuNav": "min(20vh, 15vw)",
      "tagline": "calc(1.8 * var(--scale))",
      "bodyText": "14.6667px",
      "buttonText": "16px"
    },
    "letterSpacing": {
      "display": "-0.04em",
      "body": "0.025em"
    }
  },
  "motion": {
    "engine": "GSAP 3 + Lenis",
    "easings": {
      "snappyCinematic": "cubic-bezier(0.22, 1, 0.36, 1)",
      "yearStripEase": "power4.inOut",
      "menuReveal": "power3.out",
      "menuClose": "power3.in",
      "lineReveal": "power2.out"
    },
    "durations": {
      "yearStrip": 2.85,
      "heroSlide": 1.78,
      "menuOpen": 0.88,
      "menuClose": 0.58,
      "hoverWorkScale": 0.45
    }
  }
}
