      { "name": "summaryBarSlot", "description": "Nome da ferramenta, ícone de status e duração em ms", "optional": false },
      { "name": "payloadInspectorSlot", "description": "Bloco colapsável com argumentos de entrada e resposta", "optional": true }
    ]
  },
  "stateContract": {
