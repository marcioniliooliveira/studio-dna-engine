        "h": 798
      },
      "html": "<div data-kid=\"1\" data-name=\"hero-only container\" style=\"width:100%;min-height:800px;background:#fff;overflow:hidden;\">\n    <iframe allow=\"autoplay; fullscreen\" data-kid=\"1-1\" data-name=\"external hero iframe\" loading=\"eager\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.jumpflex.com/\" style=\"display:block;width:100%;height:800px;border:0;\" title=\"Jumpflex original hero reference\">\n    </iframe>\n</div>\n",
      "comments": [],
      "created": "2026-09-03T17:55:08.651848+00:00",
