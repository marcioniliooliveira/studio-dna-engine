    "var_28920fd59965": {
      "type": "variant",
      "label": "Family joy — bounce dispatch",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6944,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  :root { --red:#da0000; --navy:#17222d; --lime:#a9e52c; --blue:#1677ff; --white:#ffffff; }\n  .dispatch { min-height:800px; overflow:clip; background:var(--navy); color:var(--white); font-family:'Space Grotesk',sans-serif; position:relative; isolation:isolate; }\n  .dispatch * { box-sizing:border-box; }\n  .dispatch-display { font-family:'Bebas Neue',Impact,sans-serif; }\n  .dispatch-visual { will-change:transform,opacity; }\n  .dispatch-lines { background-image:linear-gradient(90deg,transparent 0,transparent calc(20% - 1px),rgba(255,255,255,.14) 20%,transparent calc(20% + 1px),transparent calc(40% - 1px),rgba(255,255,255,.14) 40%,transparent calc(40% + 1px),transparent calc(60% - 1px),rgba(255,255,255,.14) 60%,transparent calc(60% + 1px),transparent calc(80% - 1px),rgba(255,255,255,.14) 80%,transparent calc(80% + 1px)),linear-gradient(0deg,transparent 0,transparent calc(50% - 1px),rgba(255,255,255,.12) 50%,transparent calc(50% + 1px)); }\n  .dispatch-hero { min-height:758px; position:relative; overflow:clip; }\n  .dispatch-panel { position:absolute; left:13%; right:13%; top:74px; bottom:126px; overflow:hidden; border:1px solid rgba(255,255,255,.3); background:#31404a; transform:rotate(-1.1deg); }\n  .dispatch-photo { position:absolute; inset:-7%; width:114%; height:114%; object-fit:cover; object-position:center 48%; filter:saturate(1.05) contrast(1.08); will-change:transform; }\n  .dispatch-panel:after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,rgba(23,34,45,.9) 0%,rgba(23,34,45,.27) 38%,rgba(23,34,45,.4) 66%,rgba(23,34,45,.96) 100%),linear-gradient(90deg,rgba(23,34,45,.6),transparent 42%,rgba(23,34,45,.26)); }\n  .dispatch-grain { position:absolute; inset:0; background-image:radial-gradient(rgba(255,255,255,.18) .6px,transparent .6px); background-size:5px 5px; mix-blend-mode:soft-light; opacity:.17; z-index:2; pointer-events:none; }\n  .dispatch-sale { min-height:42px; position:relative; z-index:20; display:flex; align-items:center; justify-content:center; gap:18px; padding:9px 20px; background:var(--red); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.15em; text-align:center; }\n  .dispatch-sale strong { color:var(--lime); }\n  .dispatch-nav { position:relative; z-index:20; height:76px; display:flex; align-items:center; justify-content:space-between; padding:0 48px; border-bottom:1px solid rgba(255,255,255,.2); background:rgba(23,34,45,.62); }\n  .dispatch-logo { color:white; text-decoration:none; font-size:29px; font-weight:700; font-style:italic; letter-spacing:-.09em; }\n  .dispatch-logo span { color:var(--lime); }\n  .dispatch-menu { display:flex; gap:30px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.13em; }\n  .dispatch-menu a,.dispatch-tools a { color:white; text-decoration:none; }\n  .dispatch-tools { display:flex; align-items:center; gap:17px; font-size:10px; font-weight:700; letter-spacing:.08em; }\n  .dispatch-dot { width:7px; height:7px; border-radius:50%; background:var(--lime); }\n  .dispatch-copy { position:relative; z-index:8; width:100%; padding-top:50px; text-align:center; }\n  .dispatch-kicker { display:flex; justify-content:center; align-items:center; gap:12px; color:var(--lime); font-size:10px; font-weight:700; letter-spacing:.28em; text-transform:uppercase; }\n  .dispatch-kicker i { width:34px; height:2px; background:var(--lime); display:block; }\n  .dispatch-title { margin:19px auto 0; font-size:clamp(86px,11vw,154px); line-height:.68; letter-spacing:.01em; text-transform:uppercase; text-shadow:5px 7px 0 rgba(23,34,45,.8); }\n  .dispatch-word { display:block; will-change:transform,opacity; }\n  .dispatch-word-joy { color:var(--lime); margin-left:12%; }\n  .dispatch-word-air { margin-left:-11%; }\n  .dispatch-subcopy { max-width:395px; margin:27px auto 0; color:rgba(255,255,255,.9); font-size:14px; line-height:1.5; }\n  .dispatch-actions { display:flex; justify-content:center; align-items:center; gap:13px; margin-top:25px; position:relative; z-index:15; }\n  .dispatch-cta { min-height:54px; display:inline-flex; align-items:center; justify-content:center; gap:22px; padding:0 25px; text-decoration:none; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.14em; will-change:transform; }\n  .dispatch-primary { background:var(--lime); color:var(--navy); box-shadow:6px 6px 0 var(--blue); }\n  .dispatch-outline { border:1px solid rgba(255,255,255,.82); background:rgba(23,34,45,.52); color:white; }\n  .dispatch-outline b { color:var(--blue); }\n  .dispatch-ribbon { position:absolute; z-index:12; left:30px; top:240px; padding:16px 10px; background:var(--blue); color:white; writing-mode:vertical-rl; transform:rotate(-8deg); font-size:11px; font-weight:700; letter-spacing:.18em; line-height:1.2; will-change:transform,opacity; }\n  .dispatch-ribbon span { color:var(--lime); }\n  .dispatch-count { position:absolute; z-index:11; top:128px; right:48px; display:flex; flex-direction:column; align-items:flex-end; gap:6px; font-size:10px; font-weight:700; letter-spacing:.16em; }\n  .dispatch-count strong { font-family:'Bebas Neue',Impact,sans-serif; color:var(--lime); font-size:33px; line-height:.8; letter-spacing:.04em; }\n  .dispatch-count em { width:56px; height:2px; background:rgba(255,255,255,.5); position:relative; }\n  .dispatch-count em:after { content:''; position:absolute; left:0; top:0; height:2px; width:25%; background:var(--lime); }\n  .dispatch-tabs { position:absolute; z-index:14; left:7%; right:7%; bottom:0; display:flex; border-top:1px solid rgba(255,255,255,.3); background:rgba(23,34,45,.72); }\n  .dispatch-tab { flex:1; min-width:0; min-height:108px; padding:19px 22px 16px; display:flex; justify-content:space-between; align-items:flex-end; border-right:1px solid rgba(255,255,255,.16); will-change:transform,opacity; }\n  .dispatch-tab:last-child { border-right:0; }\n  .dispatch-tab.active { background:linear-gradient(90deg,rgba(169,229,44,.15),transparent); }\n  .dispatch-tab h2 { margin:0 0 4px; font-size:39px; line-height:.8; letter-spacing:.04em; }\n  .dispatch-tab.active h2 { color:var(--lime); }\n  .dispatch-tab small { color:rgba(255,255,255,.6); font-size:9px; font-weight:700; letter-spacing:.14em; }\n  .dispatch-tab-meta { text-align:right; font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; }\n  .dispatch-tab-meta a { display:block; color:white; text-decoration:none; margin-bottom:8px; }\n  .dispatch-tab-meta span { color:rgba(255,255,255,.55); }\n  @media (max-width:900px) { .dispatch-nav{padding:0 22px}.dispatch-menu{display:none}.dispatch-tools span{display:none}.dispatch-panel{left:4%;right:4%;top:100px;bottom:168px}.dispatch-copy{padding:40px 22px 0}.dispatch-title{font-size:clamp(78px,18vw,130px)}.dispatch-word-joy{margin-left:7%}.dispatch-word-air{margin-left:-5%}.dispatch-ribbon{left:12px;top:190px;font-size:9px;padding:12px 8px}.dispatch-count{right:22px;top:106px}.dispatch-subcopy{max-width:335px;font-size:13px}.dispatch-actions{flex-direction:column;gap:10px}.dispatch-cta{width:min(100%,330px)}.dispatch-tabs{left:0;right:0;overflow-x:auto}.dispatch-tab{flex:0 0 255px}.dispatch-sale span{display:none} }\n  @media (prefers-reduced-motion:reduce) { .dispatch-photo{transform:none!important} }\n</style>\n<div aria-label=\"Jumpflex Family joy hero\" class=\"dispatch\" data-kid=\"1\" data-name=\"page layout container\" id=\"jumpflex-dispatch\">\n    <div class=\"dispatch-sale\" data-kid=\"1-1\" data-name=\"sale banner container\">\n        <strong data-kid=\"1-1-1\" data-name=\"sale header text\">\n            LABOR DAY SALE\n        </strong>\n        <span data-kid=\"1-1-2\" data-name=\"sale subheadline text\">\n            Make room for more family joy\n        </span>\n        <span aria-label=\"Sale countdown\" data-dynamic=\"true\" data-kid=\"1-1-3\" data-name=\"countdown timer\" data-reason=\"text replaced every second by countdown script\">\n            04 D   13 H   16 M\n        </span>\n    </div>\n    <section class=\"dispatch-hero\" data-kid=\"1-2\" data-name=\"hero section\" id=\"top\">\n        <div class=\"dispatch-lines absolute inset-0 opacity-50\" data-kid=\"1-2-1\" data-name=\"decorative background grid lines\">\n        </div>\n        <div aria-label=\"Child jumping on a trampoline — Ron Lach on Pexels\" class=\"dispatch-panel dispatch-visual\" data-kid=\"1-2-2\" data-name=\"hero background visual container\" role=\"img\">\n            <img alt=\"Child jumping on a trampoline — Ron Lach on Pexels\" class=\"dispatch-photo\" data-kid=\"1-2-2-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/10045070/pexels-photo-10045070.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\"/>\n            <div class=\"dispatch-grain\" data-kid=\"1-2-2-2\" data-name=\"grain overlay effect\">\n            </div>\n        </div>\n        <header class=\"dispatch-nav\" data-kid=\"1-2-3\" data-name=\"navigation bar\">\n            <a aria-label=\"Jumpflex home\" class=\"dispatch-logo\" data-kid=\"1-2-3-1\" data-name=\"logo link\" href=\"#top\">\n                Jump\n                <span data-kid=\"1-2-3-1-1\" data-name=\"logo emphasis text\">\n                    flex\n                </span>\n                <sup class=\"text-[8px]\" data-kid=\"1-2-3-1-2\" data-name=\"registered trademark symbol\">\n                    ®\n                </sup>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"dispatch-menu\" data-kid=\"1-2-3-2\" data-name=\"main navigation menu\">\n                <a data-kid=\"1-2-3-2-1\" data-name=\"trampolines link\" href=\"#range\">\n                    Trampolines\n                </a>\n                <a data-kid=\"1-2-3-2-2\" data-name=\"accessories link\" href=\"#range\">\n                    Accessories\n                </a>\n                <a data-kid=\"1-2-3-2-3\" data-name=\"support link\" href=\"#support\">\n                    Support\n                </a>\n                <a data-kid=\"1-2-3-2-4\" data-name=\"about link\" href=\"#about\">\n                    About\n                </a>\n                <a data-kid=\"1-2-3-2-5\" data-name=\"contact link\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"dispatch-tools\" data-kid=\"1-2-3-3\" data-name=\"navigation tools container\">\n                <span class=\"dispatch-dot\" data-kid=\"1-2-3-3-1\" data-name=\"status indicator dot\">\n                </span>\n                <span data-kid=\"1-2-3-3-2\" data-name=\"language indicator text\">\n                    US / EN\n                </span>\n                <a aria-label=\"Search\" data-kid=\"1-2-3-3-3\" data-name=\"search icon link\" href=\"#search\">\n                    ⌕\n                </a>\n                <a aria-label=\"Shopping bag\" data-kid=\"1-2-3-3-4\" data-name=\"shopping bag icon link\" href=\"#bag\">\n                    ◌\n                </a>\n                <button aria-label=\"Open menu\" class=\"lg:hidden text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"1-2-3-3-5\" data-name=\"open menu button\">\n                    Menu\n                </button>\n            </div>\n        </header>\n        <div aria-label=\"Play outside live more\" class=\"dispatch-ribbon dispatch-visual\" data-kid=\"1-2-4\" data-name=\"ribbon text banner\">\n            PLAY OUTSIDE\n            <span data-kid=\"1-2-4-1\" data-name=\"ribbon separator\">\n                /\n            </span>\n            LIVE MORE\n        </div>\n        <div aria-label=\"Slide 1 of 4\" class=\"dispatch-count\" data-kid=\"1-2-5\" data-name=\"slide counter indicator\">\n            <strong data-kid=\"1-2-5-1\" data-name=\"counter text\">\n                01 / 04\n            </strong>\n            <em data-kid=\"1-2-5-2\" data-name=\"loading progress bar\">\n            </em>\n            <span data-kid=\"1-2-5-3\" data-name=\"current slide title text\">\n                Family joy\n            </span>\n        </div>\n        <main class=\"dispatch-copy\" data-kid=\"1-2-6\" data-name=\"main copy container\" id=\"range\">\n            <div class=\"dispatch-kicker dispatch-visual\" data-kid=\"1-2-6-1\" data-name=\"kicker text container\">\n                <i data-kid=\"1-2-6-1-1\" data-name=\"kicker left line\">\n                </i>\n                <span data-kid=\"1-2-6-1-2\" data-name=\"kicker text\">\n                    Family joy / Jumpflex\n                </span>\n                <i data-kid=\"1-2-6-1-3\" data-name=\"kicker right line\">\n                </i>\n            </div>\n            <h1 aria-label=\"More joy. More air.\" class=\"dispatch-display dispatch-title\" data-kid=\"1-2-6-2\" data-name=\"main hero headline\">\n                <span class=\"dispatch-word dispatch-visual\" data-kid=\"1-2-6-2-1\" data-name=\"main headline first line\">\n                    MORE\n                    <span class=\"dispatch-word-joy\" data-kid=\"1-2-6-2-1-1\" data-name=\"highlighted joy text\">\n                        JOY.\n                    </span>\n                </span>\n                <span class=\"dispatch-word dispatch-word-air dispatch-visual\" data-kid=\"1-2-6-2-2\" data-name=\"main headline second line\">\n                    MORE AIR.\n                </span>\n            </h1>\n            <p class=\"dispatch-subcopy dispatch-visual\" data-kid=\"1-2-6-3\" data-name=\"hero subheadline description text\">\n                Turn the backyard into the place everyone wants to be. Big jumps, better memories, made for everyday play.\n            </p>\n            <div class=\"dispatch-actions dispatch-visual\" data-kid=\"1-2-6-4\" data-name=\"hero call to action container\">\n                <a class=\"dispatch-cta dispatch-primary\" data-kid=\"1-2-6-4-1\" data-name=\"primary action button\" href=\"#range\">\n                    VIEW RANGE\n                    <b class=\"text-lg\" data-kid=\"1-2-6-4-1-1\" data-name=\"arrow icon\">\n                        ↗\n                    </b>\n                </a>\n                <a class=\"dispatch-cta dispatch-outline\" data-kid=\"1-2-6-4-2\" data-name=\"secondary action button\" href=\"#bulk\">\n                    BUY IN QUANTITY\n                    <b data-kid=\"1-2-6-4-2-1\" data-name=\"action button separator\">\n                        /\n                    </b>\n                    GET A BULK QUOTE\n                </a>\n            </div>\n        </main>\n        <div aria-label=\"Product range\" class=\"dispatch-tabs\" data-kid=\"1-2-7\" data-name=\"product range tab container\">\n            <div class=\"dispatch-tab dispatch-visual\" data-kid=\"1-2-7-1\" data-name=\"flex product tab\">\n                <div data-kid=\"1-2-7-1-1\" data-name=\"flex tab content\">\n                    <h2 class=\"dispatch-display\" data-kid=\"1-2-7-1-1-1\" data-name=\"flex tab title\">\n                        FLEX™\n                    </h2>\n                    <small data-kid=\"1-2-7-1-1-2\" data-name=\"flex tab subtitle\">\n                        EVERYDAY PLAY\n                    </small>\n                </div>\n                <div class=\"dispatch-tab-meta\" data-kid=\"1-2-7-1-2\" data-name=\"flex tab meta container\">\n                    <a data-kid=\"1-2-7-1-2-1\" data-name=\"flex view range link\" href=\"#flex\">\n                        View range ↗\n                    </a>\n                    <span data-kid=\"1-2-7-1-2-2\" data-name=\"flex bulk buy link\">\n                        Buy in quantity\n                    </span>\n                </div>\n            </div>\n            <div class=\"dispatch-tab dispatch-visual\" data-kid=\"1-2-7-2\" data-name=\"hero product tab\">\n                <div data-kid=\"1-2-7-2-1\" data-name=\"hero tab content\">\n                    <h2 class=\"dispatch-display\" data-kid=\"1-2-7-2-1-1\" data-name=\"hero tab title\">\n                        HERO™\n                    </h2>\n                    <small data-kid=\"1-2-7-2-1-2\" data-name=\"hero tab subtitle\">\n                        MORE AIR. MORE FUN.\n                    </small>\n                </div>\n                <div class=\"dispatch-tab-meta\" data-kid=\"1-2-7-2-2\" data-name=\"hero tab meta container\">\n                    <a data-kid=\"1-2-7-2-2-1\" data-name=\"hero view range link\" href=\"#hero\">\n                        View range ↗\n                    </a>\n                    <span data-kid=\"1-2-7-2-2-2\" data-name=\"hero bulk buy link\">\n                        Buy in quantity\n                    </span>\n                </div>\n            </div>\n            <div class=\"dispatch-tab dispatch-visual active\" data-kid=\"1-2-7-3\" data-name=\"mega product tab\">\n                <div data-kid=\"1-2-7-3-1\" data-name=\"mega tab content\">\n                    <h2 class=\"dispatch-display\" data-kid=\"1-2-7-3-1-1\" data-name=\"mega tab title\">\n                        MEGA™\n                    </h2>\n                    <small data-kid=\"1-2-7-3-1-2\" data-name=\"mega tab subtitle\">\n                        BIG FAMILY DAYS\n                    </small>\n                </div>\n                <div class=\"dispatch-tab-meta\" data-kid=\"1-2-7-3-2\" data-name=\"mega tab meta container\">\n                    <a data-kid=\"1-2-7-3-2-1\" data-name=\"mega view range link\" href=\"#mega\">\n                        View range ↗\n                    </a>\n                    <span data-kid=\"1-2-7-3-2-2\" data-name=\"mega bulk buy link\">\n                        Buy in quantity\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);(()=>{const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;if(!reduce){const intro=gsap.timeline({defaults:{ease:'power3.out'}});intro.fromTo('.dispatch-kicker',{y:24,opacity:0},{y:0,opacity:1,duration:.45}).fromTo('.dispatch-word',{y:120,opacity:0,rotation:3},{y:0,opacity:1,rotation:0,duration:.82,stagger:.1,ease:'bounce.out'},'-=.15').fromTo('.dispatch-subcopy',{y:25,opacity:0},{y:0,opacity:1,duration:.45},'-=.2').fromTo('.dispatch-actions',{y:26,opacity:0},{y:0,opacity:1,duration:.5},'-=.18').fromTo('.dispatch-ribbon',{x:-45,opacity:0,rotation:-20},{x:0,opacity:1,rotation:-8,duration:.7,ease:'back.out(1.4)'},'-=.35').fromTo('.dispatch-tab',{y:75,opacity:0},{y:0,opacity:1,duration:.5,stagger:.13},'-=.25');gsap.to('.dispatch-photo',{yPercent:8,ease:'none',scrollTrigger:{trigger:'.dispatch-hero',start:'top top',end:'bottom top',scrub:.8}});document.querySelectorAll('.dispatch-cta').forEach(el=>{el.addEventListener('mouseenter',()=>gsap.to(el,{scale:1.035,duration:.18}));el.addEventListener('mouseleave',()=>gsap.to(el,{scale:1,duration:.18}))});document.addEventListener('visibilitychange',()=>document.hidden?gsap.globalTimeline.pause():gsap.globalTimeline.resume())}})();\n</script>\n",
      "comments": [],
      "created": "2026-09-03T19:10:52.162170+00:00",
