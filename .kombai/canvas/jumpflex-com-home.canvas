    "var_9ba8bfeba8ab": {
      "type": "variant",
      "label": "Jumpflex hero — Made for every backyard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1424,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  .jf-page{--sale:#da0000;--navy:#17222d;--lime:#a9e52c;--cobalt:#1954d1;--paper:#f2f0eb;font-family:'Space Grotesk',sans-serif;background:var(--paper);color:var(--navy);min-height:100vh;overflow:hidden}\n  .jf-display{font-family:'Bebas Neue',sans-serif;letter-spacing:.018em}\n  .jf-sale{background:var(--sale);color:#fff;min-height:38px;display:flex;align-items:center;justify-content:center;padding:8px 24px;font-size:11px;font-weight:700;letter-spacing:.12em;text-align:center}\n  .jf-nav{height:74px;background:rgba(23,34,45,.97);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 40px;position:relative;z-index:5}\n  .jf-logo{font-family:'Bebas Neue',sans-serif;font-size:30px;letter-spacing:.02em;line-height:1;color:#fff;font-style:italic}\n  .jf-logo b{color:var(--lime);font-weight:400}\n  .jf-links{display:flex;gap:28px;align-items:center;font-size:11px;font-weight:700;letter-spacing:.1em}\n  .jf-links span{opacity:.78}\n  .jf-icons{display:flex;gap:16px;align-items:center;font-size:13px;letter-spacing:.06em}\n  .jf-icon{width:24px;height:24px;border:1px solid rgba(255,255,255,.3);display:grid;place-items:center;font-size:10px}\n  .jf-hero{position:relative;min-height:628px;padding:62px 40px 38px;display:grid;grid-template-columns:minmax(420px,.9fr) minmax(520px,1.1fr);gap:48px;align-items:center;background:linear-gradient(135deg,#f2f0eb 0%,#e8e5df 64%,#d8dce0 100%)}\n  .jf-hero:before{content:'';position:absolute;right:-160px;top:-130px;width:560px;height:560px;border:1px solid rgba(25,84,209,.18);border-radius:50%;box-shadow:0 0 0 36px rgba(25,84,209,.035),0 0 0 72px rgba(25,84,209,.025);pointer-events:none}\n  .jf-kicker{display:flex;align-items:center;gap:12px;font-size:11px;font-weight:700;letter-spacing:.18em;color:var(--sale);margin-bottom:20px}\n  .jf-kicker i{display:block;width:36px;height:4px;background:var(--sale)}\n  .jf-title{font-size:clamp(68px,6.4vw,98px);line-height:.82;margin:0 0 26px;max-width:520px;position:relative;z-index:2}\n  .jf-title .line{display:block;overflow:visible;white-space:nowrap}\n  .jf-title .fit{display:inline-block;background:var(--lime);padding:2px 22px 4px 14px;color:var(--navy);transform:skew(-5deg);box-shadow:10px 10px 0 var(--cobalt)}\n  .jf-copy{max-width:410px;font-size:15px;line-height:1.55;color:rgba(23,34,45,.76);margin:0 0 30px}\n  .jf-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}\n  .jf-primary{display:inline-flex;align-items:center;gap:16px;background:var(--lime);color:var(--navy);padding:16px 20px 15px;font-size:12px;font-weight:800;letter-spacing:.13em;text-decoration:none;box-shadow:6px 6px 0 var(--navy);will-change:transform,opacity}\n  .jf-primary b{font-size:19px;line-height:.5}\n  .jf-secondary{color:var(--navy);font-size:11px;font-weight:800;letter-spacing:.1em;text-decoration:none;border-bottom:2px solid var(--navy);padding-bottom:5px;will-change:transform,opacity}\n  .jf-note{margin-top:26px;display:flex;gap:16px;align-items:center;color:rgba(23,34,45,.58);font-size:10px;letter-spacing:.08em;font-weight:700}\n  .jf-note strong{color:var(--cobalt);font-size:15px}\n  .jf-product{height:500px;position:relative;overflow:hidden;background:var(--navy);box-shadow:14px 14px 0 var(--cobalt);will-change:transform,opacity}\n  .jf-product img{width:100%;height:100%;object-fit:cover;display:block;opacity:.72;will-change:transform,opacity}\n  .jf-product:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(23,34,45,.86) 0%,rgba(23,34,45,.12) 65%,rgba(23,34,45,.38) 100%);pointer-events:none}\n  .jf-product-top{position:absolute;z-index:2;left:24px;top:22px;right:24px;display:flex;justify-content:space-between;align-items:flex-start;color:#fff}\n  .jf-product-label{font-size:10px;letter-spacing:.17em;font-weight:700;line-height:1.5}\n  .jf-product-label em{display:block;color:var(--lime);font-style:normal;font-size:18px;letter-spacing:.04em}\n  .jf-stamp{border:1px solid var(--lime);color:var(--lime);font-size:10px;font-weight:800;letter-spacing:.1em;padding:8px 10px;transform:rotate(4deg)}\n  .jf-selector{position:absolute;z-index:3;bottom:28px;left:24px;right:24px;display:flex;align-items:flex-end;justify-content:space-between;gap:14px;color:#fff}\n  .jf-sizes{display:flex;gap:8px;flex-wrap:wrap}\n  .jf-size{border:1px solid rgba(255,255,255,.45);padding:9px 11px;font-size:10px;font-weight:700;letter-spacing:.1em;will-change:transform,opacity}\n  .jf-size.active{background:var(--lime);border-color:var(--lime);color:var(--navy)}\n  .jf-models{display:flex;gap:10px;font-size:10px;font-weight:700;letter-spacing:.12em;white-space:nowrap}\n  .jf-models span{color:#fff}.jf-models span:nth-child(2){color:var(--lime)}.jf-models span:nth-child(3){color:#78a0ff}\n  .jf-benefits{position:absolute;z-index:4;left:-24px;bottom:62px;background:#fff;color:var(--navy);display:flex;gap:18px;padding:13px 18px;border-left:5px solid var(--lime);box-shadow:8px 8px 0 rgba(23,34,45,.2);font-size:9px;font-weight:800;letter-spacing:.1em;will-change:transform,opacity}\n  .jf-benefits span{display:flex;gap:6px;align-items:center}.jf-benefits b{color:var(--cobalt);font-size:12px}\n  .jf-scroll{height:42px;background:var(--lime);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:10px;font-weight:800;letter-spacing:.16em;gap:10px}\n  .jf-scroll b{font-size:16px;line-height:1}\n  @media(max-width:900px){.jf-nav{padding:0 22px}.jf-links{display:none}.jf-hero{grid-template-columns:1fr;padding:42px 22px 66px;gap:40px}.jf-title{font-size:clamp(78px,17vw,128px)}.jf-product{height:420px;box-shadow:9px 9px 0 var(--cobalt)}.jf-benefits{left:14px;bottom:54px}.jf-selector{bottom:20px;display:block}.jf-models{margin-top:12px}.jf-scroll{text-align:center;padding:0 12px;font-size:9px}}\n  @media(max-width:520px){.jf-sale{font-size:9px;padding:8px 12px}.jf-nav{height:62px}.jf-logo{font-size:27px}.jf-icons{gap:7px}.jf-hero{padding-top:34px}.jf-copy{font-size:14px}.jf-actions{gap:18px}.jf-primary{padding:15px 17px}.jf-product{height:390px}.jf-benefits{right:12px;left:12px;justify-content:space-between;gap:7px;font-size:8px;padding:12px 10px}.jf-benefits span{gap:4px}.jf-sizes{gap:5px}.jf-size{padding:8px 8px}}\n</style>\n<section aria-label=\"Jumpflex Made for every backyard hero\" class=\"jf-page\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"jf-sale\" data-kid=\"1-1\" data-name=\"sale banner container\">\n        <span data-kid=\"1-1-1\" data-name=\"sale banner text\">\n            LABOR DAY SALE  ·   UP TO $300 OFF FLEX™ & HERO™  ·   UP TO $900 OFF MEGA™\n        </span>\n    </div>\n    <header class=\"jf-nav\" data-kid=\"1-2\" data-name=\"header navigation container\">\n        <div class=\"jf-logo\" data-kid=\"1-2-1\" data-name=\"brand logo\">\n            Jump\n            <b data-kid=\"1-2-1-1\" data-name=\"brand logo bold segment\">\n                flex\n            </b>\n            <sup data-kid=\"1-2-1-2\" data-name=\"registered trademark symbol\">\n                ®\n            </sup>\n        </div>\n        <nav class=\"jf-links\" data-kid=\"1-2-2\" data-name=\"navigation menu links\">\n            <span data-kid=\"1-2-2-1\" data-name=\"nav link trampolines\">\n                TRAMPOLINES\n            </span>\n            <span data-kid=\"1-2-2-2\" data-name=\"nav link accessories\">\n                ACCESSORIES\n            </span>\n            <span data-kid=\"1-2-2-3\" data-name=\"nav link support\">\n                SUPPORT⌄\n            </span>\n            <span data-kid=\"1-2-2-4\" data-name=\"nav link about\">\n                ABOUT\n            </span>\n            <span data-kid=\"1-2-2-5\" data-name=\"nav link contact\">\n                CONTACT\n            </span>\n        </nav>\n        <div class=\"jf-icons\" data-kid=\"1-2-3\" data-name=\"nav utility icons and contact\">\n            <span data-kid=\"1-2-3-1\" data-name=\"phone number text\">\n                +1 (866) 305 7238\n            </span>\n            <i class=\"jf-icon\" data-kid=\"1-2-3-2\" data-name=\"search icon\">\n                ⌕\n            </i>\n            <i class=\"jf-icon\" data-kid=\"1-2-3-3\" data-name=\"account icon\">\n                ◌\n            </i>\n            <i class=\"jf-icon\" data-kid=\"1-2-3-4\" data-name=\"cart icon\">\n                ▢\n            </i>\n        </div>\n    </header>\n    <main class=\"jf-hero\" data-kid=\"1-3\" data-name=\"hero content section\">\n        <div class=\"jf-copy-col\" data-kid=\"1-3-1\" data-name=\"copy and actions column\">\n            <div class=\"jf-kicker\" data-kid=\"1-3-1-1\" data-name=\"hero kicker container\">\n                <i data-kid=\"1-3-1-1-1\" data-name=\"kicker accent line\">\n                </i>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"kicker text\">\n                    MADE FOR EVERY BACKYARD\n                </span>\n            </div>\n            <h1 class=\"jf-title\" data-kid=\"1-3-1-2\" data-name=\"hero main headline\">\n                <span class=\"line\" data-kid=\"1-3-1-2-1\" data-name=\"headline line 1\">\n                    FIND YOUR\n                </span>\n                <span class=\"line\" data-kid=\"1-3-1-2-2\" data-name=\"headline line 2\">\n                    <span class=\"fit\" data-kid=\"1-3-1-2-2-1\" data-name=\"headline fit highlight\">\n                        FIT.\n                    </span>\n                </span>\n            </h1>\n            <p class=\"jf-copy\" data-kid=\"1-3-1-3\" data-name=\"hero introductory paragraph\">\n                From first bounce to all-day energy, choose a Jumpflex built for your space, your setup and the way your family moves.\n            </p>\n            <div class=\"jf-actions\" data-kid=\"1-3-1-4\" data-name=\"call to action buttons container\">\n                <a class=\"jf-primary\" data-kid=\"1-3-1-4-1\" data-name=\"primary action button\" href=\"#range\">\n                    VIEW RANGE\n                    <b data-kid=\"1-3-1-4-1-1\" data-name=\"primary action arrow icon\">\n                        ↗\n                    </b>\n                </a>\n                <a class=\"jf-secondary\" data-kid=\"1-3-1-4-2\" data-name=\"secondary action link\" href=\"#bulk\">\n                    BUY IN QUANTITY / GET A BULK QUOTE\n                </a>\n            </div>\n            <div class=\"jf-note\" data-kid=\"1-3-1-5\" data-name=\"hero info note container\">\n                <strong data-kid=\"1-3-1-5-1\" data-name=\"star icon\">\n                    ★\n                </strong>\n                <span data-kid=\"1-3-1-5-2\" data-name=\"note descriptive text\">\n                    FLEX™ · HERO™ · MEGA™\n                    <br data-kid=\"1-3-1-5-2-1\" data-name=\"note text line break\"/>\n                    Compare the range below\n                </span>\n            </div>\n        </div>\n        <div class=\"jf-product\" data-kid=\"1-3-2\" data-name=\"featured product card\" id=\"range\">\n            <img alt=\"Modern backyard lifestyle — Max Vakhtbovych on Pexels\" data-kid=\"1-3-2-1\" data-name=\"featured product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8134751/pexels-photo-8134751.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n            <div class=\"jf-product-top\" data-kid=\"1-3-2-2\" data-name=\"product top info bar\">\n                <div class=\"jf-product-label\" data-kid=\"1-3-2-2-1\" data-name=\"product label text\">\n                    YOUR SPACE.\n                    <em data-kid=\"1-3-2-2-1-1\" data-name=\"product label emphasized text\">\n                        YOUR BOUNCE.\n                    </em>\n                </div>\n                <div class=\"jf-stamp\" data-kid=\"1-3-2-2-2\" data-name=\"product smart choice stamp\">\n                    SMART\n                    <br data-kid=\"1-3-2-2-2-1\" data-name=\"stamp line break\"/>\n                    CHOICE\n                </div>\n            </div>\n            <div class=\"jf-benefits\" data-kid=\"1-3-2-3\" data-name=\"product benefits box\">\n                <span data-kid=\"1-3-2-3-1\" data-name=\"benefit item safe\">\n                    <b data-kid=\"1-3-2-3-1-1\" data-name=\"benefit icon safe\">\n                        ✦\n                    </b>\n                    SAFE\n                </span>\n                <span data-kid=\"1-3-2-3-2\" data-name=\"benefit item durable\">\n                    <b data-kid=\"1-3-2-3-2-1\" data-name=\"benefit icon durable\">\n                        ◈\n                    </b>\n                    DURABLE\n                </span>\n                <span data-kid=\"1-3-2-3-3\" data-name=\"benefit item move\">\n                    <b data-kid=\"1-3-2-3-3-1\" data-name=\"benefit icon move\">\n                        ↗\n                    </b>\n                    MADE TO MOVE\n                </span>\n            </div>\n            <div class=\"jf-selector\" data-kid=\"1-3-2-4\" data-name=\"product selector and model info\">\n                <div class=\"jf-sizes\" data-kid=\"1-3-2-4-1\" data-name=\"size options container\">\n                    <span class=\"jf-size active\" data-kid=\"1-3-2-4-1-1\" data-name=\"size 8ft option\">\n                        8 FT\n                    </span>\n                    <span class=\"jf-size\" data-kid=\"1-3-2-4-1-2\" data-name=\"size 10ft option\">\n                        10 FT\n                    </span>\n                    <span class=\"jf-size\" data-kid=\"1-3-2-4-1-3\" data-name=\"size 12ft option\">\n                        12 FT\n                    </span>\n                    <span class=\"jf-size\" data-kid=\"1-3-2-4-1-4\" data-name=\"size 14ft option\">\n                        14 FT\n                    </span>\n                </div>\n                <div class=\"jf-models\" data-kid=\"1-3-2-4-2\" data-name=\"models listed\">\n                    <span data-kid=\"1-3-2-4-2-1\" data-name=\"model flex\">\n                        FLEX™\n                    </span>\n                    <span data-kid=\"1-3-2-4-2-2\" data-name=\"model hero\">\n                        HERO™\n                    </span>\n                    <span data-kid=\"1-3-2-4-2-3\" data-name=\"model mega\">\n                        MEGA™\n                    </span>\n                </div>\n            </div>\n        </div>\n    </main>\n    <div class=\"jf-scroll\" data-kid=\"1-4\" data-name=\"scroll prompt footer\">\n        <b data-kid=\"1-4-1\" data-name=\"scroll prompt arrow top\">\n            ↓\n        </b>\n        SCROLL TO COMPARE FLEX™ / HERO™ / MEGA™\n        <b data-kid=\"1-4-2\" data-name=\"scroll prompt arrow bottom\">\n            ↓\n        </b>\n    </div>\n    <div aria-hidden=\"true\" data-kid=\"1-5\" data-name=\"bulk section anchor\" id=\"bulk\">\n    </div>\n</section>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);window.addEventListener('DOMContentLoaded',function(){\n  var tl=gsap.timeline({defaults:{ease:'back.out(1.55)'}});\n  tl.from('.jf-kicker',{autoAlpha:0,y:18,duration:.38})\n    .from('.jf-title .line',{autoAlpha:0,y:70,rotation:2,stagger:.12,duration:.68},'-=.12')\n    .from('.jf-copy',{autoAlpha:0,y:22,duration:.45},'-=.26')\n    .from('.jf-actions',{autoAlpha:0,y:18,duration:.42},'-=.22')\n    .from('.jf-note',{autoAlpha:0,y:14,duration:.35},'-=.2')\n    .from('.jf-product',{autoAlpha:0,x:36,scale:.96,duration:.72},'-=.46')\n    .from('.jf-product-top',{autoAlpha:0,y:-15,duration:.3},'-=.25')\n    .from('.jf-benefits',{autoAlpha:0,x:-24,duration:.42},'-=.18')\n    .from('.jf-size',{autoAlpha:0,y:18,stagger:.06,duration:.3},'-=.2');\n  gsap.to('.jf-product img',{yPercent:-8,ease:'none',scrollTrigger:{trigger:'.jf-product',start:'top bottom',end:'bottom top',scrub:.7}});\n  gsap.to('.jf-size.active',{y:-4,repeat:-1,yoyo:true,duration:.75,ease:'sine.inOut'});\n  document.querySelectorAll('.jf-primary,.jf-secondary').forEach(function(el){var hover=gsap.to(el,{y:-3,scale:1.03,duration:.18,paused:true,ease:'power2.out'});el.addEventListener('pointerenter',function(){hover.play()});el.addEventListener('pointerleave',function(){hover.reverse()});});\n});\n</script>\n",
      "comments": [],
      "created": "2026-09-03T18:54:46.279625+00:00",
      "modified": "2026-09-03T18:58:26.760094+00:00",
