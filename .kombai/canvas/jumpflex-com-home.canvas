        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  :root { --jf-red:#da0000; --jf-ink:#17222d; --jf-lime:#a9e52c; --jf-blue:#2589ff; --jf-white:#f8fafc; }\n  .jf-hero { font-family:'Space Grotesk',sans-serif; background:var(--jf-ink); color:var(--jf-white); }\n  .jf-display { font-family:'Bebas Neue',Impact,sans-serif; letter-spacing:.015em; }\n  .jf-animated { will-change:transform,opacity; }\n  .jf-grain { background-image:radial-gradient(rgba(255,255,255,.15) .6px,transparent .6px); background-size:5px 5px; mix-blend-mode:soft-light; }\n  .jf-hero-image { transform:scale(1.08); }\n  @media (max-width: 760px) { .jf-display { letter-spacing:.01em; } }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<div class=\"jf-hero min-h-[800px] overflow-hidden\" data-kid=\"1\">\n    <div class=\"flex min-h-[42px] items-center justify-center gap-4 bg-[var(--jf-red)] px-4 py-2 text-center text-[11px] font-bold uppercase tracking-[0.16em] sm:text-xs\" data-kid=\"1-1\" data-name=\"top promotional announcement bar\">\n        <span data-kid=\"1-1-1\" data-name=\"promotional offer headline text\">\n            LABOR DAY SALE!\n        </span>\n        <span class=\"hidden h-3 w-px bg-white/50 sm:block\" data-kid=\"1-1-2\">\n        </span>\n        <span class=\"font-medium tracking-[0.08em]\" data-kid=\"1-1-3\" data-name=\"promotional discount details text\">\n            Up to $300 off FLEX™ & HERO™ · MEGA™ savings\n        </span>\n        <span class=\"hidden items-center gap-2 font-mono text-[10px] sm:flex\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"live countdown timer\" data-reason=\"text replaced every second by countdown script\">\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-1\" data-name=\"countdown days segment\" data-reason=\"number replaced every second by countdown script\">\n                04\n            </b>\n            D\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-2\" data-name=\"countdown hours segment\" data-reason=\"number replaced every second by countdown script\">\n                13\n            </b>\n            H\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-3\" data-name=\"countdown minutes segment\" data-reason=\"number replaced every second by countdown script\">\n                16\n            </b>\n            M\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-4\" data-name=\"countdown seconds segment\" data-reason=\"number replaced every second by countdown script\">\n                17\n            </b>\n            S\n        </span>\n    </div>\n    <section class=\"relative flex min-h-[758px] flex-col overflow-hidden\" data-kid=\"1-2\">\n        <div aria-label=\"Child jumping on a trampoline — Ron Lach on Pexels\" class=\"jf-hero-image absolute inset-0 bg-cover bg-center\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"hero background image container\" data-reason=\"background image scale and position animated by scroll script\" role=\"img\" style=\"background-image:url('https://images.pexels.com/photos/10045070/pexels-photo-10045070.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80');\">\n        </div>\n        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(23,34,45,.96)_0%,rgba(23,34,45,.62)_24%,rgba(23,34,45,.22)_54%,rgba(23,34,45,.88)_100%)]\" data-kid=\"1-2-2\">\n        </div>\n        <div class=\"jf-grain pointer-events-none absolute inset-0 opacity-20\" data-kid=\"1-2-3\">\n        </div>\n        <header class=\"relative z-10 flex h-[78px] items-center justify-between border-b border-white/20 bg-[rgba(23,34,45,.5)] px-5 backdrop-blur-md md:px-10\" data-kid=\"1-2-4\">\n            <a class=\"jf-display text-3xl leading-none tracking-wide text-white\" data-kid=\"1-2-4-1\" href=\"#top\">\n                Jump\n                <span class=\"text-[var(--jf-lime)]\" data-kid=\"1-2-4-1-1\">\n                    flex\n                </span>\n                <sup class=\"ml-0.5 align-top font-sans text-[8px]\" data-kid=\"1-2-4-1-2\">\n                    ®\n                </sup>\n            </a>\n            <nav class=\"hidden items-center gap-7 text-[11px] font-bold uppercase tracking-[0.12em] lg:flex\" data-kid=\"1-2-4-2\">\n                <a data-kid=\"1-2-4-2-1\" href=\"#range\">\n                    Trampolines\n                </a>\n                <a data-kid=\"1-2-4-2-2\" href=\"#range\">\n                    Accessories\n                </a>\n                <a data-kid=\"1-2-4-2-3\" href=\"#support\">\n                    Support\n                </a>\n                <a data-kid=\"1-2-4-2-4\" href=\"#about\">\n                    About\n                </a>\n                <a data-kid=\"1-2-4-2-5\" href=\"#contact\">\n                    Contact\n                </a>\n                <a data-kid=\"1-2-4-2-6\" href=\"#journal\">\n                    Blog\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4 text-white\" data-kid=\"1-2-4-3\">\n                <span class=\"hidden text-[11px] font-semibold xl:block\" data-kid=\"1-2-4-3-1\">\n                    +1 (866) 305 7238\n                </span>\n                <i class=\"size-4\" data-kid=\"1-2-4-3-2\" data-lucide=\"search\" data-name=\"search icon\">\n                </i>\n                <i class=\"size-4\" data-kid=\"1-2-4-3-3\" data-lucide=\"shopping-bag\" data-name=\"shopping bag icon\">\n                </i>\n                <button aria-label=\"Open menu\" class=\"text-[11px] font-bold uppercase tracking-[0.14em] lg:hidden\" data-kid=\"1-2-4-3-4\">\n                    Menu\n                </button>\n            </div>\n        </header>\n        <main class=\"relative z-10 flex flex-1 flex-col items-center justify-center px-5 pb-20 pt-12 text-center md:pt-16\" data-kid=\"1-2-5\" id=\"top\">\n            <div class=\"jf-animated mb-5 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--jf-lime)] opacity-0\" data-kid=\"1-2-5-1\" data-name=\"hero sub-headline group\">\n                <span class=\"h-px w-8 bg-[var(--jf-lime)]\" data-kid=\"1-2-5-1-1\">\n                </span>\n                <span data-kid=\"1-2-5-1-2\">\n                    Family joy / Jumpflex\n                </span>\n                <span class=\"h-px w-8 bg-[var(--jf-lime)]\" data-kid=\"1-2-5-1-3\">\n                </span>\n            </div>\n            <h1 class=\"jf-display jf-animated max-w-4xl text-[clamp(4.8rem,12vw,10.5rem)] leading-[.78] text-white drop-shadow-[0_8px_0_rgba(23,34,45,.65)]\" data-kid=\"1-2-5-2\" data-name=\"hero main headline\">\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-5-2-1\">\n                    MORE\n                </span>\n                <span class=\"jf-word inline-block text-[var(--jf-lime)]\" data-kid=\"1-2-5-2-2\">\n                    JOY.\n                </span>\n                <br data-kid=\"1-2-5-2-3\"/>\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-5-2-4\">\n                    MORE\n                </span>\n                <span class=\"jf-word inline-block text-white\" data-kid=\"1-2-5-2-5\">\n                    AIR.\n                </span>\n            </h1>\n            <p class=\"jf-animated mt-7 max-w-md text-sm leading-6 text-white/85 opacity-0 md:text-base\" data-kid=\"1-2-5-3\" data-name=\"hero description text\">\n                Turn the backyard into the place everyone wants to be. Big jumps, better memories, built for the everyday.\n            </p>\n            <div class=\"jf-animated mt-8 flex w-full max-w-[560px] flex-col items-stretch justify-center gap-3 opacity-0 sm:flex-row sm:items-center\" data-kid=\"1-2-5-4\" data-name=\"hero call-to-action button group\">\n                <a class=\"group inline-flex min-h-14 items-center justify-center gap-4 bg-[var(--jf-lime)] px-8 text-xs font-bold uppercase tracking-[0.16em] text-[var(--jf-ink)] shadow-[6px_6px_0_var(--jf-blue)]\" data-kid=\"1-2-5-4-1\" data-name=\"primary view range button\" href=\"#range\">\n                    <span data-kid=\"1-2-5-4-1-1\">\n                        View range\n                    </span>\n                    <span class=\"text-lg leading-none\" data-kid=\"1-2-5-4-1-2\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"inline-flex min-h-14 items-center justify-center border border-white/75 bg-[rgba(23,34,45,.25)] px-7 text-[11px] font-bold uppercase tracking-[0.12em] text-white backdrop-blur-sm\" data-kid=\"1-2-5-4-2\" data-name=\"secondary bulk quote button\" href=\"#bulk\">\n                    Buy in quantity\n                    <span class=\"mx-2 text-[var(--jf-blue)]\" data-kid=\"1-2-5-4-2-1\">\n                        /\n                    </span>\n                    Get a bulk quote\n                </a>\n            </div>\n            <div class=\"jf-animated mt-8 flex flex-wrap items-center justify-center gap-2 opacity-0\" data-kid=\"1-2-5-5\" data-name=\"hero footer status tags\">\n                <span class=\"border border-white/35 bg-[rgba(23,34,45,.45)] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.14em]\" data-kid=\"1-2-5-5-1\">\n                    FLEX™ · HERO™ · MEGA™\n                </span>\n                <span class=\"border border-white/20 bg-[rgba(23,34,45,.35)] px-3 py-2 text-[10px] font-medium tracking-[0.04em] text-white/75\" data-kid=\"1-2-5-5-2\">\n                    Reviews + warranty details coming soon\n                </span>\n            </div>\n        </main>\n        <div class=\"relative z-10 flex items-center justify-between border-t border-white/20 px-5 py-5 text-[10px] font-bold uppercase tracking-[0.2em] md:px-10\" data-kid=\"1-2-6\" data-name=\"hero section footer\">\n            <span data-kid=\"1-2-6-1\">\n                01 / 04\n            </span>\n            <span class=\"flex items-center gap-3 text-white/75\" data-kid=\"1-2-6-2\">\n                <span class=\"h-px w-10 bg-white/50\" data-kid=\"1-2-6-2-1\">\n                </span>\n                Scroll to find your fit\n                <span class=\"text-[var(--jf-lime)]\" data-kid=\"1-2-6-2-2\">\n                    ↓\n                </span>\n            </span>\n            <span class=\"hidden md:block\" data-kid=\"1-2-6-3\">\n                Play outside / live more\n            </span>\n        </div>\n    </section>\n</div>\n<script>\n    if (window.lucide) lucide.createIcons();\n  const intro = gsap.timeline({ defaults:{ ease:'power3.out' } });\n  intro.fromTo('.jf-hero-image',{scale:1.16,opacity:.45},{scale:1.08,opacity:1,duration:1.6,ease:'power2.out'},0);\n  intro.fromTo('.jf-animated:first-child',{y:42,opacity:0},{y:0,opacity:1,duration:.55},.12);\n  intro.fromTo('.jf-word',{y:150,opacity:0,rotation:3},{y:0,opacity:1,rotation:0,duration:.95,stagger:.09,ease:'bounce.out'},.2);\n  intro.fromTo('.jf-animated.mt-7',{y:24,opacity:0},{y:0,opacity:1,duration:.5},.86);\n  intro.fromTo('.jf-animated.mt-8',{y:28,opacity:0},{y:0,opacity:1,duration:.55,stagger:.12},1.02);\n  gsap.to('.jf-hero-image',{yPercent:8,ease:'none',scrollTrigger:{trigger:'.jf-hero',start:'top top',end:'bottom top',scrub:.7}});\n</script>\n",
      "comments": [],
      "created": "2026-09-03T18:54:48.245501+00:00",
