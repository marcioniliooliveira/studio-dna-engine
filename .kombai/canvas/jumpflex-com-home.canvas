    "var_000a400cd7c9": {
      "type": "variant",
      "label": "Family joy — orbit sale",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8324,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n.jf-orbit { --red:#da0000; --navy:#17222d; --lime:#a9e52c; --blue:#2589ff; font-family:'Space Grotesk',sans-serif; background:var(--navy); color:#f8fafc; }\n.jf-display { font-family:'Bebas Neue',Impact,sans-serif; }\n.jf-orbit-image { transform:scale(1.08); will-change:transform; }\n.jf-orbit-badge { will-change:transform; }\n.jf-word,.jf-reveal,.jf-rail-item { will-change:transform,opacity; }\n.jf-ring { position:absolute; width:min(45vw,560px); height:min(45vw,560px); border:1px solid rgba(37,137,255,.64); border-radius:9999px; box-shadow:0 0 55px rgba(37,137,255,.16), inset 0 0 38px rgba(37,137,255,.08); pointer-events:none; }\n.jf-grain { background-image:radial-gradient(rgba(255,255,255,.16) .6px,transparent .6px); background-size:5px 5px; mix-blend-mode:soft-light; }\n@media (max-width:760px){ .jf-ring{width:78vw;height:78vw}.jf-orbit-badge{transform:scale(.68);right:3%;top:2%} }\n</style>\n<div class=\"jf-orbit min-h-[800px] overflow-x-clip\" data-kid=\"1\" data-name=\"page layout container\" id=\"top\">\n    <div class=\"flex min-h-[42px] items-center justify-center gap-4 bg-[var(--red)] px-4 py-2 text-center text-[10px] font-bold uppercase tracking-[.16em] sm:text-xs\" data-kid=\"1-1\" data-name=\"top promotion banner\">\n        <strong class=\"text-[var(--lime)]\" data-kid=\"1-1-1\" data-name=\"promotion title text\">\n            LABOR DAY SALE\n        </strong>\n        <span class=\"hidden h-3 w-px bg-white/50 sm:block\" data-kid=\"1-1-2\" data-name=\"banner separator\">\n        </span>\n        <span class=\"hidden font-medium tracking-[.08em] sm:inline\" data-kid=\"1-1-3\" data-name=\"banner description text\">\n            Explore the Jumpflex range\n        </span>\n    </div>\n    <section class=\"relative flex min-h-[758px] flex-col overflow-hidden\" data-kid=\"1-2\" data-name=\"hero section\">\n        <img alt=\"Child jumping on a trampoline — Ron Lach on Pexels\" class=\"jf-orbit-image absolute inset-0 h-full w-full object-cover object-center\" data-kid=\"1-2-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/10045070/pexels-photo-10045070.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\"/>\n        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(23,34,45,.95)_0%,rgba(23,34,45,.66)_23%,rgba(23,34,45,.3)_55%,rgba(23,34,45,.96)_100%)]\" data-kid=\"1-2-2\" data-name=\"hero overlay gradient\">\n        </div>\n        <div class=\"jf-grain pointer-events-none absolute inset-0 opacity-20\" data-kid=\"1-2-3\" data-name=\"hero grain texture overlay\">\n        </div>\n        <header class=\"relative z-20 flex h-[78px] items-center justify-between border-b border-white/20 bg-[rgba(23,34,45,.5)] px-5 backdrop-blur-md md:px-10\" data-kid=\"1-2-4\" data-name=\"header navigation bar\">\n            <a aria-label=\"Jumpflex home\" class=\"jf-display text-3xl leading-none tracking-wide text-white\" data-kid=\"1-2-4-1\" data-name=\"site logo link\" href=\"#top\">\n                Jump\n                <span class=\"text-[var(--lime)]\" data-kid=\"1-2-4-1-1\" data-name=\"logo text part\">\n                    flex\n                </span>\n                <sup class=\"ml-0.5 align-top font-sans text-[8px]\" data-kid=\"1-2-4-1-2\" data-name=\"logo trademark symbol\">\n                    ®\n                </sup>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"hidden items-center gap-7 text-[11px] font-bold uppercase tracking-[.12em] lg:flex\" data-kid=\"1-2-4-2\" data-name=\"main navigation list\">\n                <a data-kid=\"1-2-4-2-1\" data-name=\"navigation link trampolines\" href=\"#range\">\n                    Trampolines\n                </a>\n                <a data-kid=\"1-2-4-2-2\" data-name=\"navigation link accessories\" href=\"#range\">\n                    Accessories\n                </a>\n                <a data-kid=\"1-2-4-2-3\" data-name=\"navigation link support\" href=\"#support\">\n                    Support\n                </a>\n                <a data-kid=\"1-2-4-2-4\" data-name=\"navigation link about\" href=\"#about\">\n                    About\n                </a>\n                <a data-kid=\"1-2-4-2-5\" data-name=\"navigation link contact\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-5 text-white\" data-kid=\"1-2-4-3\" data-name=\"header actions container\">\n                <span class=\"hidden text-[11px] font-semibold xl:block\" data-kid=\"1-2-4-3-1\" data-name=\"language selector text\">\n                    US / EN\n                </span>\n                <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-2-4-3-2\" data-name=\"search icon\">\n                    ⌕\n                </span>\n                <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-2-4-3-3\" data-name=\"account icon\">\n                    ◌\n                </span>\n                <button aria-controls=\"mobile-menu\" aria-expanded=\"false\" class=\"text-[11px] font-bold uppercase tracking-[.14em] lg:hidden\" data-dynamic=\"true\" data-kid=\"1-2-4-3-4\" data-name=\"mobile menu toggle button\" data-reason=\"aria-expanded attribute toggled by click script\" id=\"menu-toggle\">\n                    Menu\n                </button>\n            </div>\n        </header>\n        <div class=\"absolute right-4 top-[92px] z-30 hidden w-48 border border-white/25 bg-[var(--navy)] p-4 shadow-[5px_5px_0_var(--red)] lg:hidden\" data-dynamic=\"true\" data-kid=\"1-2-5\" data-name=\"mobile menu navigation container\" data-reason=\"hidden class toggled by click script\" id=\"mobile-menu\">\n            <nav aria-label=\"Mobile navigation\" class=\"grid gap-4 text-[11px] font-bold uppercase tracking-[.12em]\" data-kid=\"1-2-5-1\" data-name=\"mobile navigation list\">\n                <a data-kid=\"1-2-5-1-1\" data-name=\"mobile nav link trampolines\" href=\"#range\">\n                    Trampolines\n                </a>\n                <a data-kid=\"1-2-5-1-2\" data-name=\"mobile nav link accessories\" href=\"#range\">\n                    Accessories\n                </a>\n                <a data-kid=\"1-2-5-1-3\" data-name=\"mobile nav link support\" href=\"#support\">\n                    Support\n                </a>\n                <a data-kid=\"1-2-5-1-4\" data-name=\"mobile nav link about\" href=\"#about\">\n                    About\n                </a>\n                <a data-kid=\"1-2-5-1-5\" data-name=\"mobile nav link contact\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n        </div>\n        <main class=\"relative z-10 flex flex-1 flex-col items-center justify-center px-5 pb-10 pt-12 text-center md:pt-16\" data-kid=\"1-2-6\" data-name=\"hero content container\" id=\"range\">\n            <div aria-hidden=\"true\" class=\"jf-ring\" data-kid=\"1-2-6-1\" data-name=\"hero background ring decoration\">\n            </div>\n            <div class=\"jf-reveal relative mb-4 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[.28em] text-[var(--lime)]\" data-kid=\"1-2-6-2\" data-name=\"hero eyebrow container\">\n                <span class=\"h-px w-8 bg-[var(--lime)]\" data-kid=\"1-2-6-2-1\" data-name=\"eyebrow left line\">\n                </span>\n                <span data-kid=\"1-2-6-2-2\" data-name=\"eyebrow text\">\n                    Family joy / Jumpflex\n                </span>\n                <span class=\"h-px w-8 bg-[var(--lime)]\" data-kid=\"1-2-6-2-3\" data-name=\"eyebrow right line\">\n                </span>\n            </div>\n            <h1 class=\"jf-display relative max-w-4xl text-[clamp(4.8rem,12vw,10.5rem)] leading-[.78] tracking-[.015em] drop-shadow-[0_8px_0_rgba(23,34,45,.65)]\" data-kid=\"1-2-6-3\" data-name=\"hero headline text\">\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-6-3-1\" data-name=\"headline word more\">\n                    MORE\n                </span>\n                <span class=\"jf-word inline-block text-[var(--lime)]\" data-kid=\"1-2-6-3-2\" data-name=\"headline word joy\">\n                    JOY.\n                </span>\n                <br data-kid=\"1-2-6-3-3\" data-name=\"headline break\"/>\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-6-3-4\" data-name=\"headline word more\">\n                    MORE\n                </span>\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-6-3-5\" data-name=\"headline word air\">\n                    AIR.\n                </span>\n            </h1>\n            <p class=\"jf-reveal mt-7 max-w-md text-sm leading-6 text-white/85 md:text-base\" data-kid=\"1-2-6-4\" data-name=\"hero description text\">\n                Turn the backyard into the place everyone wants to be. Big jumps, better memories, built for the everyday.\n            </p>\n            <div class=\"jf-reveal mt-8 flex w-full max-w-[610px] flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center\" data-kid=\"1-2-6-5\" data-name=\"hero actions container\">\n                <a class=\"inline-flex min-h-14 items-center justify-center gap-4 bg-[var(--lime)] px-8 text-xs font-bold uppercase tracking-[.16em] text-[var(--navy)] shadow-[6px_6px_0_var(--blue)]\" data-kid=\"1-2-6-5-1\" data-name=\"primary call-to-action button\" href=\"#products\">\n                    VIEW RANGE\n                    <span class=\"text-lg leading-none\" data-kid=\"1-2-6-5-1-1\" data-name=\"button arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"inline-flex min-h-14 items-center justify-center border border-white/75 bg-[rgba(23,34,45,.28)] px-7 text-[11px] font-bold uppercase tracking-[.1em] text-white backdrop-blur-sm\" data-kid=\"1-2-6-5-2\" data-name=\"secondary call-to-action button\" href=\"#bulk\">\n                    BUY IN QUANTITY\n                    <span class=\"mx-2 text-[var(--blue)]\" data-kid=\"1-2-6-5-2-1\" data-name=\"button slash separator\">\n                        /\n                    </span>\n                    GET A BULK QUOTE\n                </a>\n            </div>\n            <div class=\"jf-reveal relative mt-8 flex flex-wrap items-center justify-center gap-7 text-[10px] font-bold uppercase tracking-[.14em] text-white/85\" data-kid=\"1-2-6-6\" data-name=\"product model info container\">\n                <span class=\"absolute -left-14 -top-5 hidden text-[var(--lime)] md:block\" data-kid=\"1-2-6-6-1\" data-name=\"model tag flex\">\n                    FLEX™\n                </span>\n                <span class=\"border border-white/35 bg-[rgba(23,34,45,.45)] px-3 py-2\" data-kid=\"1-2-6-6-2\" data-name=\"model list text\">\n                    FLEX™ · HERO™ · MEGA™\n                </span>\n                <span class=\"absolute -right-14 -bottom-4 hidden text-[var(--blue)] md:block\" data-kid=\"1-2-6-6-3\" data-name=\"model tag hero\">\n                    HERO™\n                </span>\n            </div>\n            <div class=\"jf-orbit-badge absolute right-[7%] top-[3%] grid size-[112px] place-content-center rounded-full bg-[var(--lime)] text-center text-[var(--navy)] shadow-[8px_8px_0_var(--red)]\" data-dynamic=\"true\" data-kid=\"1-2-6-7\" data-name=\"labor day badge container\" data-reason=\"rotation applied via infinite CSS keyframe animation\">\n                <b class=\"jf-display text-[27px] leading-[.82]\" data-kid=\"1-2-6-7-1\" data-name=\"badge text\">\n                    LABOR\n                    <br data-kid=\"1-2-6-7-1-1\" data-name=\"badge title line break\"/>\n                    DAY\n                </b>\n                <small class=\"mt-2 text-[9px] font-bold uppercase tracking-[.08em]\" data-kid=\"1-2-6-7-2\" data-name=\"badge sale label\">\n                    sale\n                </small>\n            </div>\n        </main>\n        <div class=\"relative z-10 flex items-center justify-between border-t border-white/20 px-5 py-5 text-[10px] font-bold uppercase tracking-[.2em] md:px-10\" data-kid=\"1-2-7\" data-name=\"hero footer bar\">\n            <span class=\"text-[var(--lime)]\" data-kid=\"1-2-7-1\" data-name=\"slide counter text\">\n                01 / 04\n            </span>\n            <span class=\"flex items-center gap-3 text-white/75\" data-kid=\"1-2-7-2\" data-name=\"scroll guide container\">\n                <span class=\"h-px w-10 bg-white/50\" data-kid=\"1-2-7-2-1\" data-name=\"scroll line\">\n                </span>\n                Scroll to explore\n                <span class=\"text-[var(--lime)]\" data-kid=\"1-2-7-2-2\" data-name=\"down arrow icon\">\n                    ↓\n                </span>\n            </span>\n            <span class=\"hidden md:block\" data-kid=\"1-2-7-3\" data-name=\"footer branding slogan\">\n                Play outside / live more\n            </span>\n        </div>\n    </section>\n    <section class=\"border-t border-white/10 bg-[var(--navy)] px-5 py-6 md:px-10\" data-kid=\"1-3\" data-name=\"product range section\" id=\"products\">\n        <div class=\"flex items-end justify-between border-b border-white/20 pb-5\" data-kid=\"1-3-1\" data-name=\"section header container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"section title group\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[.2em] text-[var(--lime)]\" data-kid=\"1-3-1-1-1\" data-name=\"section eyebrow text\">\n                    Choose your bounce\n                </p>\n                <h2 class=\"jf-display mt-2 text-5xl leading-none\" data-kid=\"1-3-1-1-2\" data-name=\"section title heading\">\n                    Find your fit\n                </h2>\n            </div>\n            <span class=\"hidden text-[10px] uppercase tracking-[.2em] text-white/60 sm:block\" data-kid=\"1-3-1-2\" data-name=\"view models link text\">\n                Explore models ↘\n            </span>\n        </div>\n        <div aria-label=\"Jumpflex products\" class=\"flex overflow-x-auto border-b border-white/15\" data-kid=\"1-3-2\" data-name=\"products tablist container\" role=\"tablist\">\n            <a class=\"jf-rail-item min-w-[240px] border-r border-white/15 bg-[rgba(169,229,44,.11)] p-5\" data-kid=\"1-3-2-1\" data-name=\"flex product card\" href=\"#flex\" role=\"tab\">\n                <b class=\"jf-display text-4xl text-[var(--lime)]\" data-kid=\"1-3-2-1-1\" data-name=\"product title\">\n                    FLEX™\n                </b>\n                <span class=\"mt-1 block text-[10px] font-bold uppercase tracking-[.15em] text-white/60\" data-kid=\"1-3-2-1-2\" data-name=\"product description\">\n                    Everyday play\n                </span>\n            </a>\n            <a class=\"jf-rail-item min-w-[240px] border-r border-white/15 p-5\" data-kid=\"1-3-2-2\" data-name=\"hero product card\" href=\"#hero\" role=\"tab\">\n                <b class=\"jf-display text-4xl\" data-kid=\"1-3-2-2-1\" data-name=\"product title\">\n                    HERO™\n                </b>\n                <span class=\"mt-1 block text-[10px] font-bold uppercase tracking-[.15em] text-white/60\" data-kid=\"1-3-2-2-2\" data-name=\"product description\">\n                    More air. More fun.\n                </span>\n            </a>\n            <a class=\"jf-rail-item min-w-[240px] p-5\" data-kid=\"1-3-2-3\" data-name=\"mega product card\" href=\"#mega\" role=\"tab\">\n                <b class=\"jf-display text-4xl\" data-kid=\"1-3-2-3-1\" data-name=\"product title\">\n                    MEGA™\n                </b>\n                <span class=\"mt-1 block text-[10px] font-bold uppercase tracking-[.15em] text-white/60\" data-kid=\"1-3-2-3-2\" data-name=\"product description\">\n                    The biggest days\n                </span>\n            </a>\n        </div>\n    </section>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;const words=document.querySelectorAll('.jf-word'), reveals=document.querySelectorAll('.jf-reveal'), rails=document.querySelectorAll('.jf-rail-item');if(!reduce){const intro=gsap.timeline({defaults:{ease:'power3.out'}});intro.fromTo(words,{y:130,opacity:0,rotation:3},{y:0,opacity:1,rotation:0,duration:.9,stagger:.1,ease:'bounce.out'}).fromTo(reveals,{y:25,opacity:0},{y:0,opacity:1,duration:.5,stagger:.1},'-=.45').fromTo(rails,{y:30,opacity:0},{y:0,opacity:1,duration:.45,stagger:.1},'-=.2');gsap.to('.jf-orbit-image',{yPercent:8,ease:'none',scrollTrigger:{trigger:'.jf-orbit',start:'top top',end:'bottom top',scrub:.7}});gsap.to('.jf-orbit-badge',{rotation:360,repeat:-1,duration:12,ease:'none'});}document.addEventListener('visibilitychange',()=>{document.hidden?gsap.globalTimeline.pause():gsap.globalTimeline.resume()});document.getElementById('menu-toggle').addEventListener('click',e=>{const b=e.currentTarget,m=document.getElementById('mobile-menu'),open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));m.classList.toggle('hidden',open)});\n</script>\n",
      "comments": [],
      "created": "2026-09-03T19:10:52.157508+00:00",
      "modified": "2026-09-03T19:10:52.157508+00:00",
      "id": "var_000a400cd7c9",
      "viewportScrollY": 241
    },
    "var_890d9e6bc60b": {
      "type": "variant",
      "label": "Family reveal — kinetic range",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 9704,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n:root{--red:#da0000;--navy:#17222d;--lime:#a9e52c;--blue:#1677ff;--white:#f8fafc}\n.jf-page{font-family:'Space Grotesk',sans-serif;background:var(--navy);color:var(--white);min-height:800px;overflow-x:clip}\n.jf-display{font-family:'Bebas Neue',Impact,sans-serif}\n.jf-hero{position:relative;min-height:672px;isolation:isolate;overflow:hidden}\n.jf-photo{will-change:transform;transform:scale(1.1)}\n.jf-word,.jf-intro,.jf-badge,.jf-tab{will-change:transform,opacity}\n.jf-grain{background-image:radial-gradient(rgba(255,255,255,.13) .6px,transparent .6px);background-size:5px 5px;mix-blend-mode:soft-light}\n.jf-tabs{scrollbar-width:none}.jf-tabs::-webkit-scrollbar{display:none}\n@media(max-width:760px){.jf-navlinks{display:none}.jf-hero{min-height:758px}.jf-main{padding:42px 18px 26px}.jf-title{font-size:clamp(4.9rem,22vw,7.7rem)}.jf-actions{flex-direction:column;width:min(100%,360px)}.jf-action{width:100%}.jf-tabs{left:0;right:0;overflow-x:auto;padding-left:18px;padding-right:18px}.jf-tab{min-width:245px}.jf-countdown{right:18px}.jf-progress{left:12px}.jf-badge{right:18px;top:138px;width:92px;height:92px}.jf-badge b{font-size:21px}}\n@media(prefers-reduced-motion:reduce){.jf-photo{transform:scale(1.04)}.jf-word,.jf-intro,.jf-badge,.jf-tab{will-change:auto}}\n</style>\n<div class=\"jf-page\" data-kid=\"1\" data-name=\"main page container\" id=\"family-reveal\">\n    <div class=\"flex min-h-[42px] items-center justify-center gap-3 bg-[var(--red)] px-4 py-2 text-center text-[10px] font-bold uppercase tracking-[.14em] sm:gap-5 sm:text-[11px]\" data-kid=\"1-1\" data-name=\"labor day sale banner\">\n        <strong class=\"text-[var(--lime)]\" data-kid=\"1-1-1\" data-name=\"labor day sale text\">\n            LABOR DAY SALE\n        </strong>\n        <span class=\"hidden h-3 w-px bg-white/50 sm:block\" data-kid=\"1-1-2\" data-name=\"vertical separator\">\n        </span>\n        <span class=\"hidden font-medium tracking-[.07em] sm:inline\" data-kid=\"1-1-3\" data-name=\"promo message text\">\n            Up to $300 off FLEX™ & HERO™ · Up to $900 off MEGA™\n        </span>\n        <span class=\"font-mono text-[10px] text-white/85\" data-dynamic=\"true\" data-kid=\"1-1-4\" data-name=\"countdown timer digits container\" data-reason=\"digits replaced every second by countdown script\">\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-1\" data-name=\"sale days digits\" data-reason=\"number replaced by countdown script\" id=\"sale-days\">\n                04\n            </b>\n            D\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-2\" data-name=\"sale hours digits\" data-reason=\"number replaced by countdown script\" id=\"sale-hours\">\n                13\n            </b>\n            H\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-3\" data-name=\"sale minutes digits\" data-reason=\"number replaced by countdown script\" id=\"sale-minutes\">\n                16\n            </b>\n            M\n            <b data-dynamic=\"true\" data-kid=\"1-1-4-4\" data-name=\"sale seconds digits\" data-reason=\"number replaced by countdown script\" id=\"sale-seconds\">\n                17\n            </b>\n            S\n        </span>\n    </div>\n    <section class=\"jf-hero\" data-kid=\"1-2\" data-name=\"hero section\">\n        <img alt=\"Child jumping on a trampoline — Ron Lach on Pexels\" class=\"jf-photo absolute inset-0 h-full w-full object-cover object-center\" data-kid=\"1-2-1\" data-name=\"background hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/10045070/pexels-photo-10045070.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\"/>\n        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(23,34,45,.96)_0%,rgba(23,34,45,.58)_25%,rgba(23,34,45,.18)_57%,rgba(23,34,45,.96)_100%)]\" data-kid=\"1-2-2\" data-name=\"gradient overlay\">\n        </div>\n        <div class=\"jf-grain pointer-events-none absolute inset-0 opacity-20\" data-kid=\"1-2-3\" data-name=\"grain texture overlay\">\n        </div>\n        <header class=\"relative z-20 flex h-[78px] items-center justify-between border-b border-white/20 bg-[rgba(23,34,45,.54)] px-5 backdrop-blur-md md:px-10\" data-kid=\"1-2-4\" data-name=\"main navigation header\">\n            <a class=\"jf-display text-3xl leading-none tracking-wide text-white\" data-kid=\"1-2-4-1\" data-name=\"logo link\" href=\"#family-reveal\">\n                Jump\n                <span class=\"text-[var(--lime)]\" data-kid=\"1-2-4-1-1\" data-name=\"logo flex text\">\n                    flex\n                </span>\n                <sup class=\"ml-0.5 align-top font-sans text-[8px]\" data-kid=\"1-2-4-1-2\" data-name=\"registered trademark symbol\">\n                    ®\n                </sup>\n            </a>\n            <nav class=\"jf-navlinks flex items-center gap-7 text-[11px] font-bold uppercase tracking-[.12em]\" data-kid=\"1-2-4-2\" data-name=\"navlinks navigation menu\">\n                <a data-kid=\"1-2-4-2-1\" data-name=\"trampolines category link\" href=\"#range\">\n                    Trampolines\n                </a>\n                <a data-kid=\"1-2-4-2-2\" data-name=\"accessories category link\" href=\"#range\">\n                    Accessories\n                </a>\n                <a data-kid=\"1-2-4-2-3\" data-name=\"support category link\" href=\"#support\">\n                    Support\n                </a>\n                <a data-kid=\"1-2-4-2-4\" data-name=\"about category link\" href=\"#about\">\n                    About\n                </a>\n                <a data-kid=\"1-2-4-2-5\" data-name=\"contact category link\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4 text-white\" data-kid=\"1-2-4-3\" data-name=\"header actions container\">\n                <span class=\"hidden text-[11px] font-semibold xl:block\" data-kid=\"1-2-4-3-1\" data-name=\"phone number text\">\n                    +1 (866) 305 7238\n                </span>\n                <button aria-label=\"Search\" class=\"text-lg leading-none\" data-kid=\"1-2-4-3-2\" data-name=\"search button\">\n                    ⌕\n                </button>\n                <button aria-label=\"Shopping bag\" class=\"text-base leading-none\" data-kid=\"1-2-4-3-3\" data-name=\"shopping bag button\">\n                    ◌\n                </button>\n                <button aria-label=\"Open menu\" class=\"text-[11px] font-bold uppercase tracking-[.14em] lg:hidden\" data-kid=\"1-2-4-3-4\" data-name=\"menu toggle button\">\n                    Menu\n                </button>\n            </div>\n        </header>\n        <main class=\"jf-main relative z-10 flex min-h-[594px] flex-col items-center justify-center px-5 pb-24 pt-12 text-center\" data-kid=\"1-2-5\" data-name=\"main section\" id=\"range\">\n            <div class=\"jf-intro mb-4 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[.28em] text-[var(--lime)]\" data-kid=\"1-2-5-1\" data-name=\"intro container\">\n                <span class=\"h-px w-8 bg-[var(--lime)]\" data-kid=\"1-2-5-1-1\" data-name=\"decorative line\">\n                </span>\n                <span data-kid=\"1-2-5-1-2\" data-name=\"brand intro text\">\n                    Family joy / Jumpflex\n                </span>\n                <span class=\"h-px w-8 bg-[var(--lime)]\" data-kid=\"1-2-5-1-3\" data-name=\"decorative line\">\n                </span>\n            </div>\n            <h1 aria-label=\"More joy. More air.\" class=\"jf-display jf-title max-w-5xl text-[clamp(5rem,13vw,10.5rem)] leading-[.76] drop-shadow-[0_8px_0_rgba(23,34,45,.72)]\" data-kid=\"1-2-5-2\" data-name=\"hero title text\">\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-5-2-1\" data-name=\"more joy first word\">\n                    MORE\n                </span>\n                <span class=\"jf-word inline-block text-[var(--lime)]\" data-kid=\"1-2-5-2-2\" data-name=\"joy second word\">\n                    JOY.\n                </span>\n                <br data-kid=\"1-2-5-2-3\" data-name=\"line break\"/>\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-5-2-4\" data-name=\"more third word\">\n                    MORE\n                </span>\n                <span class=\"jf-word inline-block\" data-kid=\"1-2-5-2-5\" data-name=\"air fourth word\">\n                    AIR.\n                </span>\n            </h1>\n            <p class=\"jf-intro mt-6 max-w-[430px] text-sm leading-6 text-white/85 md:text-base\" data-kid=\"1-2-5-3\" data-name=\"hero subtitle text\">\n                Turn the backyard into the place everyone wants to be. Big jumps, better memories, built for the everyday.\n            </p>\n            <div class=\"jf-actions jf-intro mt-7 flex items-center justify-center gap-3\" data-kid=\"1-2-5-4\" data-name=\"call to action container\">\n                <a class=\"jf-action inline-flex min-h-14 items-center justify-center gap-4 bg-[var(--lime)] px-8 text-xs font-bold uppercase tracking-[.16em] text-[var(--navy)] shadow-[6px_6px_0_var(--blue)]\" data-kid=\"1-2-5-4-1\" data-name=\"primary view range button\" href=\"#products\">\n                    VIEW RANGE\n                    <span class=\"text-lg leading-none\" data-kid=\"1-2-5-4-1-1\" data-name=\"external link arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"jf-action inline-flex min-h-14 items-center justify-center border border-white/75 bg-[rgba(23,34,45,.35)] px-7 text-[11px] font-bold uppercase tracking-[.11em] text-white backdrop-blur-sm\" data-kid=\"1-2-5-4-2\" data-name=\"secondary bulk quote button\" href=\"#bulk\">\n                    BUY IN QUANTITY\n                    <span class=\"mx-2 text-[var(--blue)]\" data-kid=\"1-2-5-4-2-1\" data-name=\"slash separator\">\n                        /\n                    </span>\n                    GET A BULK QUOTE\n                </a>\n            </div>\n            <div class=\"jf-intro mt-7 flex flex-wrap justify-center gap-2 text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"1-2-5-5\" data-name=\"product feature tags container\">\n                <span class=\"border border-white/40 bg-[rgba(23,34,45,.45)] px-3 py-2\" data-kid=\"1-2-5-5-1\" data-name=\"product models tag\">\n                    FLEX™ · HERO™ · MEGA™\n                </span>\n                <span class=\"border border-white/25 bg-[rgba(23,34,45,.35)] px-3 py-2 text-white/75\" data-kid=\"1-2-5-5-2\" data-name=\"family play tag\">\n                    Built for family play\n                </span>\n            </div>\n        </main>\n        <div class=\"jf-badge absolute right-[9%] top-[105px] z-20 flex h-[116px] w-[116px] rotate-[12deg] flex-col items-center justify-center rounded-full bg-[var(--lime)] text-center text-[var(--navy)] shadow-[8px_8px_0_var(--red)]\" data-kid=\"1-2-6\" data-name=\"floating labor day badge\">\n            <b class=\"jf-display text-[27px] leading-[.82] tracking-wide\" data-kid=\"1-2-6-1\" data-name=\"labor day text\">\n                LABOR\n                <br data-kid=\"1-2-6-1-1\" data-name=\"line break\"/>\n                DAY\n            </b>\n            <small class=\"mt-1.5 text-[9px] font-bold uppercase tracking-[.08em]\" data-kid=\"1-2-6-2\" data-name=\"sale status text\">\n                Sale on now\n            </small>\n        </div>\n        <div class=\"jf-progress absolute bottom-[116px] left-[3.6%] z-20 flex flex-col items-center gap-3 text-[10px] uppercase tracking-[.1em] text-white/70\" data-kid=\"1-2-7\" data-name=\"page progress tracker\">\n            <span data-kid=\"1-2-7-1\" data-name=\"progress index text\">\n                01 / 04\n            </span>\n            <span class=\"relative h-[70px] w-px bg-white/35 after:absolute after:left-[-1px] after:top-0 after:h-6 after:w-[3px] after:bg-[var(--lime)]\" data-kid=\"1-2-7-2\" data-name=\"progress indicator bar\">\n            </span>\n            <span data-kid=\"1-2-7-3\" data-name=\"progress label text\">\n                Explore\n            </span>\n        </div>\n        <div class=\"jf-countdown absolute bottom-[112px] right-[7%] z-20 flex gap-4 text-[10px] uppercase tracking-[.12em] text-white/70\" data-dynamic=\"true\" data-kid=\"1-2-8\" data-name=\"countdown timer container\" data-reason=\"digits updated every second by countdown script\">\n            <span data-dynamic=\"true\" data-kid=\"1-2-8-1\" data-name=\"days countdown group\" data-reason=\"days number updated by script\">\n                <b class=\"text-[15px] text-white\" data-dynamic=\"true\" data-kid=\"1-2-8-1-1\" data-name=\"days digit value\" data-reason=\"number updated by script\">\n                    04\n                </b>\n                days\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-2-8-2\" data-name=\"hours countdown group\" data-reason=\"hours number updated by script\">\n                <b class=\"text-[15px] text-white\" data-dynamic=\"true\" data-kid=\"1-2-8-2-1\" data-name=\"hours digit value\" data-reason=\"number updated by script\">\n                    13\n                </b>\n                hrs\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-2-8-3\" data-name=\"minutes countdown group\" data-reason=\"minutes number updated by script\">\n                <b class=\"text-[15px] text-white\" data-dynamic=\"true\" data-kid=\"1-2-8-3-1\" data-name=\"minutes digit value\" data-reason=\"number updated by script\">\n                    16\n                </b>\n                min\n            </span>\n        </div>\n        <div class=\"jf-tabs absolute bottom-0 left-0 right-0 z-20 flex border-t border-white/25 px-[7.8%]\" data-kid=\"1-2-9\" data-name=\"product tabs container\" id=\"products\">\n            <article class=\"jf-tab flex flex-1 items-end justify-between border-r border-white/15 bg-[linear-gradient(90deg,rgba(169,229,44,.12),transparent)] py-5 pr-5\" data-kid=\"1-2-9-1\" data-name=\"flex product tab\">\n                <div data-kid=\"1-2-9-1-1\" data-name=\"flex product title container\">\n                    <h2 class=\"jf-display text-5xl leading-none text-[var(--lime)]\" data-kid=\"1-2-9-1-1-1\" data-name=\"flex title heading\">\n                        FLEX™\n                    </h2>\n                    <p class=\"text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"1-2-9-1-1-2\" data-name=\"flex description text\">\n                        EVERYDAY PLAY\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-2-9-1-2\" data-name=\"flex action links\">\n                    <a class=\"block text-[10px] font-bold uppercase tracking-[.1em]\" data-kid=\"1-2-9-1-2-1\" data-name=\"flex view range link\" href=\"#flex\">\n                        View range ↗\n                    </a>\n                    <a class=\"mt-2 block text-[9px] text-white/60\" data-kid=\"1-2-9-1-2-2\" data-name=\"flex bulk buy link\" href=\"#bulk\">\n                        Buy in quantity\n                    </a>\n                </div>\n            </article>\n            <article class=\"jf-tab flex flex-1 items-end justify-between border-r border-white/15 px-5 py-5\" data-kid=\"1-2-9-2\" data-name=\"hero product tab\">\n                <div data-kid=\"1-2-9-2-1\" data-name=\"hero product title container\">\n                    <h2 class=\"jf-display text-5xl leading-none\" data-kid=\"1-2-9-2-1-1\" data-name=\"hero title heading\">\n                        HERO™\n                    </h2>\n                    <p class=\"text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"1-2-9-2-1-2\" data-name=\"hero description text\">\n                        MORE AIR. MORE FUN.\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-2-9-2-2\" data-name=\"hero action links\">\n                    <a class=\"block text-[10px] font-bold uppercase tracking-[.1em]\" data-kid=\"1-2-9-2-2-1\" data-name=\"hero view range link\" href=\"#hero\">\n                        View range ↗\n                    </a>\n                    <a class=\"mt-2 block text-[9px] text-white/60\" data-kid=\"1-2-9-2-2-2\" data-name=\"hero bulk buy link\" href=\"#bulk\">\n                        Buy in quantity\n                    </a>\n                </div>\n            </article>\n            <article class=\"jf-tab flex flex-1 items-end justify-between px-5 py-5\" data-kid=\"1-2-9-3\" data-name=\"mega product tab\">\n                <div data-kid=\"1-2-9-3-1\" data-name=\"mega product title container\">\n                    <h2 class=\"jf-display text-5xl leading-none\" data-kid=\"1-2-9-3-1-1\" data-name=\"mega title heading\">\n                        MEGA™\n                    </h2>\n                    <p class=\"text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"1-2-9-3-1-2\" data-name=\"mega description text\">\n                        THE BIGGEST DAYS\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-2-9-3-2\" data-name=\"mega action links\">\n                    <a class=\"block text-[10px] font-bold uppercase tracking-[.1em]\" data-kid=\"1-2-9-3-2-1\" data-name=\"mega view range link\" href=\"#mega\">\n                        View range ↗\n                    </a>\n                    <a class=\"mt-2 block text-[9px] text-white/60\" data-kid=\"1-2-9-3-2-2\" data-name=\"mega bulk buy link\" href=\"#bulk\">\n                        Buy in quantity\n                    </a>\n                </div>\n            </article>\n        </div>\n        <span class=\"absolute bottom-5 right-[3.7%] z-20 hidden text-[9px] font-bold uppercase tracking-[.16em] text-white/55 [writing-mode:vertical-rl] lg:block\" data-kid=\"1-2-10\" data-name=\"scroll instruction label\">\n            Scroll to explore\n        </span>\n    </section>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);(()=>{const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;const els={words:'.jf-word',intro:'.jf-intro',badge:'.jf-badge',tabs:'.jf-tab',photo:'.jf-photo'};if(!reduce){const tl=gsap.timeline({defaults:{ease:'power3.out'}});tl.fromTo(els.words,{y:120,opacity:0,rotation:3},{y:0,opacity:1,rotation:0,duration:.85,stagger:.1,ease:'bounce.out'}).fromTo('.jf-intro',{y:24,opacity:0},{y:0,opacity:1,duration:.48,stagger:.08},'-=.38').fromTo(els.badge,{scale:.35,opacity:0,rotation:-38},{scale:1,opacity:1,rotation:12,duration:.68,ease:'back.out(1.8)'},'-=.4').fromTo(els.tabs,{y:34,opacity:0},{y:0,opacity:1,duration:.45,stagger:.1},'-=.25');gsap.to(els.photo,{yPercent:8,ease:'none',scrollTrigger:{trigger:'.jf-hero',start:'top top',end:'bottom top',scrub:.8}});gsap.to(els.badge,{rotation:'+=8',repeat:-1,yoyo:true,duration:2.8,ease:'sine.inOut'});}document.addEventListener('visibilitychange',()=>{if(reduce)return;document.hidden?gsap.globalTimeline.pause():gsap.globalTimeline.resume()});})();\n</script>\n",
