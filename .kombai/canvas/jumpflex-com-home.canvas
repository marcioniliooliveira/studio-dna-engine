    },
    "var_2f6c78ce5417": {
      "type": "variant",
      "label": "Jumpflex hero — Product reveal",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4184,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n:root { --red:#da0000; --navy:#17222d; --lime:#a9e52c; --blue:#1677ff; --paper:#f7f7f2; }\n* { box-sizing:border-box; }\nbody { margin:0; background:var(--navy); color:white; font-family:'Space Grotesk',sans-serif; }\n.product-reveal { min-height:800px; position:relative; overflow:hidden; isolation:isolate; background:var(--navy); }\n.top-sale { height:42px; background:var(--red); display:flex; align-items:center; justify-content:center; gap:20px; padding:0 24px; font-size:12px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; position:relative; z-index:10; }\n.top-sale strong { color:var(--lime); }\n.nav { height:86px; position:relative; z-index:10; display:flex; align-items:center; justify-content:space-between; padding:0 52px; background:rgba(23,34,45,.78); border-bottom:1px solid rgba(255,255,255,.16); }\n.logo { font-weight:700; font-size:25px; letter-spacing:-.08em; font-style:italic; }\n.logo span { color:var(--lime); }\n.nav-links { display:flex; align-items:center; gap:32px; font-size:12px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }\n.nav-links a { color:white; text-decoration:none; }\n.nav-tools { display:flex; align-items:center; gap:18px; font-size:12px; font-weight:700; }\n.nav-tools .dot { width:7px; height:7px; background:var(--lime); border-radius:50%; }\n.hero { min-height:672px; position:relative; display:flex; align-items:center; padding:60px 7.8% 130px; }\n.grid-lines { position:absolute; inset:0; opacity:.12; background-image:linear-gradient(90deg,transparent 0,transparent calc(25% - 1px),#fff 25%,transparent calc(25% + 1px),transparent calc(50% - 1px),#fff 50%,transparent calc(50% + 1px),transparent calc(75% - 1px),#fff 75%,transparent calc(75% + 1px)),linear-gradient(0deg,transparent 0,transparent calc(50% - 1px),#fff 50%,transparent calc(50% + 1px)); pointer-events:none; }\n.copy { position:relative; z-index:4; width:53%; padding-top:4px; }\n.eyebrow { display:inline-flex; align-items:center; gap:10px; color:var(--lime); font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; margin-bottom:18px; }\n.eyebrow:before { content:''; width:28px; height:3px; background:var(--lime); display:block; }\nh1 { margin:0; font-family:'Bebas Neue',Impact,sans-serif; font-size:clamp(76px,9.2vw,142px); line-height:.78; letter-spacing:.015em; text-transform:uppercase; max-width:620px; }\nh1 .word { display:block; width:max-content; will-change:transform,opacity; }\nh1 .outline { color:transparent; -webkit-text-stroke:2px var(--blue); text-shadow:5px 5px 0 rgba(22,119,255,.18); }\n.lede { max-width:420px; margin:25px 0 26px; font-size:15px; line-height:1.55; color:rgba(255,255,255,.78); }\n.actions { display:flex; align-items:center; gap:16px; position:relative; z-index:12; }\n.primary { display:inline-flex; align-items:center; gap:18px; padding:16px 22px; background:var(--lime); color:var(--navy); text-decoration:none; font-size:12px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }\n.primary i { font-style:normal; font-size:18px; line-height:0; }\n.secondary { color:white; text-decoration:none; font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; border-bottom:1px solid rgba(255,255,255,.55); padding-bottom:7px; }\n.art-wrap { position:absolute; right:4.8%; top:72px; width:49%; height:548px; z-index:2; clip-path:polygon(11% 0,100% 0,92% 100%,0 92%); background:var(--blue); will-change:transform,opacity; }\n.art-wrap:before { content:''; position:absolute; inset:0; z-index:2; background:linear-gradient(135deg,rgba(218,0,0,.8) 0 13%,transparent 13% 74%,rgba(22,119,255,.52) 74%); mix-blend-mode:screen; pointer-events:none; }\n.art-wrap:after { content:''; position:absolute; left:-8%; bottom:10%; width:57%; height:24%; background:var(--red); transform:skewX(-20deg); opacity:.8; z-index:3; mix-blend-mode:multiply; }\n.art { width:100%; height:100%; object-fit:cover; filter:saturate(1.08) contrast(1.12); display:block; will-change:transform,opacity; }\n.sale-badge { position:absolute; z-index:5; right:10%; top:35px; width:116px; height:116px; border-radius:50%; background:var(--lime); color:var(--navy); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; transform:rotate(12deg); will-change:transform,opacity; box-shadow:8px 8px 0 var(--red); }\n.sale-badge b { font-family:'Bebas Neue',Impact,sans-serif; font-size:27px; line-height:.85; letter-spacing:.04em; }\n.sale-badge small { font-size:9px; font-weight:700; letter-spacing:.08em; margin-top:6px; }\n.countdown { position:absolute; right:7%; bottom:84px; z-index:5; display:flex; gap:14px; color:rgba(255,255,255,.62); font-size:10px; letter-spacing:.12em; text-transform:uppercase; }\n.countdown b { color:white; font-size:15px; letter-spacing:0; margin-right:3px; }\n.progress { position:absolute; left:3.6%; bottom:108px; z-index:8; display:flex; flex-direction:column; align-items:center; gap:12px; color:rgba(255,255,255,.62); font-size:10px; letter-spacing:.1em; }\n.progress .line { width:1px; height:76px; background:rgba(255,255,255,.32); position:relative; }\n.progress .line:after { content:''; width:3px; height:24px; background:var(--lime); position:absolute; top:0; left:-1px; }\n.tabs { position:absolute; left:7.8%; right:7.8%; bottom:0; z-index:9; min-height:106px; display:flex; border-top:1px solid rgba(255,255,255,.22); }\n.tab { flex:1; min-width:0; padding:22px 24px 18px 0; display:flex; justify-content:space-between; align-items:flex-end; border-right:1px solid rgba(255,255,255,.15); opacity:.62; will-change:transform,opacity; }\n.tab + .tab { padding-left:24px; }\n.tab.active { opacity:1; background:linear-gradient(90deg,rgba(169,229,44,.12),transparent); }\n.tab h2 { font-family:'Bebas Neue',Impact,sans-serif; font-size:42px; line-height:.8; margin:0; letter-spacing:.04em; }\n.tab.active h2 { color:var(--lime); }\n.tab-meta { text-align:right; }\n.tab-meta a { display:block; color:white; text-decoration:none; font-size:10px; font-weight:700; letter-spacing:.1em; margin-bottom:9px; }\n.tab-meta span { color:rgba(255,255,255,.48); font-size:9px; letter-spacing:.12em; }\n.scroll-note { position:absolute; right:3.7%; bottom:24px; z-index:10; color:rgba(255,255,255,.5); font-size:9px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; writing-mode:vertical-rl; transform:rotate(180deg); }\n@media (max-width:900px) { .nav { padding:0 22px; }.nav-links { display:none; }.hero { min-height:770px; padding:44px 24px 220px; align-items:flex-start; }.copy { width:100%; padding-top:30px; }.art-wrap { top:210px; right:0; width:80%; height:390px; opacity:.65; }.copy h1 { font-size:clamp(72px,17vw,122px); }.lede { max-width:330px; }.actions { margin-top:20px; }.tabs { left:0; right:0; overflow-x:auto; min-height:126px; }.tab { min-width:235px; padding-left:18px; }.tab + .tab { padding-left:18px; }.countdown { right:24px; bottom:154px; }.progress { left:12px; bottom:166px; }.scroll-note { display:none; }.sale-badge { right:8%; top:182px; width:92px; height:92px; }.sale-badge b { font-size:21px; } }\n</style>\n<div class=\"product-reveal\" data-kid=\"1\">\n    <div class=\"top-sale\" data-kid=\"1-1\">\n        <strong data-kid=\"1-1-1\">\n            LABOR DAY SALE\n        </strong>\n        <span data-kid=\"1-1-2\">\n            Up to $300 off FLEX™ & HERO™ · Up to $900 off MEGA™\n        </span>\n    </div>\n    <header class=\"nav\" data-kid=\"1-2\">\n        <div class=\"logo\" data-kid=\"1-2-1\">\n            Jump\n            <span data-kid=\"1-2-1-1\">\n                flex\n            </span>\n            <sup data-kid=\"1-2-1-2\">\n                ®\n            </sup>\n        </div>\n        <nav class=\"nav-links\" data-kid=\"1-2-2\">\n            <a data-kid=\"1-2-2-1\" href=\"#range\">\n                Trampolines\n            </a>\n            <a data-kid=\"1-2-2-2\" href=\"#accessories\">\n                Accessories\n            </a>\n            <a data-kid=\"1-2-2-3\" href=\"#support\">\n                Support\n            </a>\n            <a data-kid=\"1-2-2-4\" href=\"#about\">\n                About\n            </a>\n            <a data-kid=\"1-2-2-5\" href=\"#contact\">\n                Contact\n            </a>\n        </nav>\n        <div class=\"nav-tools\" data-kid=\"1-2-3\">\n            <span class=\"dot\" data-kid=\"1-2-3-1\">\n            </span>\n            <span data-kid=\"1-2-3-2\">\n                US / EN\n            </span>\n            <span data-kid=\"1-2-3-3\">\n                ⌕\n            </span>\n            <span data-kid=\"1-2-3-4\">\n                ◌\n            </span>\n        </div>\n    </header>\n    <main class=\"hero\" data-kid=\"1-3\" id=\"range\">\n        <div class=\"grid-lines\" data-kid=\"1-3-1\">\n        </div>\n        <div class=\"copy\" data-kid=\"1-3-2\">\n            <div class=\"eyebrow\" data-kid=\"1-3-2-1\">\n                The Jumpflex range\n            </div>\n            <h1 aria-label=\"Pick your perfect bounce\" data-kid=\"1-3-2-2\">\n                <span class=\"word\" data-kid=\"1-3-2-2-1\">\n                    Pick your\n                </span>\n                <span class=\"word\" data-kid=\"1-3-2-2-2\">\n                    perfect\n                </span>\n                <span class=\"word outline\" data-kid=\"1-3-2-2-3\">\n                    bounce.\n                </span>\n            </h1>\n            <p class=\"lede\" data-kid=\"1-3-2-3\">\n                FLEX™ for everyday play. HERO™ for more. MEGA™ for the biggest days.\n            </p>\n            <div class=\"actions\" data-kid=\"1-3-2-4\">\n                <a class=\"primary\" data-kid=\"1-3-2-4-1\" href=\"#products\">\n                    View range\n                    <i data-kid=\"1-3-2-4-1-1\">\n                        ↗\n                    </i>\n                </a>\n                <a class=\"secondary\" data-kid=\"1-3-2-4-2\" href=\"#bulk\">\n                    Buy in quantity\n                </a>\n            </div>\n        </div>\n        <div class=\"art-wrap\" data-kid=\"1-3-3\">\n            <img alt=\"Athlete jumping in an indoor trampoline park — Francisco Delgado on Unsplash\" class=\"art\" data-kid=\"1-3-3-1\" data-name=\"hero product feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1575872215089-72e0be32019e?auto=format&w=1400&q=80&fit=crop\"/>\n        </div>\n        <div class=\"sale-badge\" data-kid=\"1-3-4\">\n            <b data-kid=\"1-3-4-1\">\n                Labor\n                <br data-kid=\"1-3-4-1-1\"/>\n                Day\n            </b>\n            <small data-kid=\"1-3-4-2\">\n                Sale on now\n            </small>\n        </div>\n        <div class=\"countdown\" data-dynamic=\"true\" data-kid=\"1-3-5\" data-name=\"countdown timer\" data-reason=\"text replaced every second by countdown script\">\n            <span data-kid=\"1-3-5-1\">\n                <b data-dynamic=\"true\" data-kid=\"1-3-5-1-1\" data-name=\"days countdown value\" data-reason=\"number replaced by countdown script\">\n                    04\n                </b>\n                days\n            </span>\n            <span data-kid=\"1-3-5-2\">\n                <b data-dynamic=\"true\" data-kid=\"1-3-5-2-1\" data-name=\"hours countdown value\" data-reason=\"number replaced by countdown script\">\n                    13\n                </b>\n                hrs\n            </span>\n            <span data-kid=\"1-3-5-3\">\n                <b data-dynamic=\"true\" data-kid=\"1-3-5-3-1\" data-name=\"minutes countdown value\" data-reason=\"number replaced by countdown script\">\n                    16\n                </b>\n                min\n            </span>\n        </div>\n        <div class=\"progress\" data-kid=\"1-3-6\">\n            <span data-kid=\"1-3-6-1\">\n                01 / 04\n            </span>\n            <span class=\"line\" data-kid=\"1-3-6-2\" data-name=\"progress bar track\">\n            </span>\n            <span data-kid=\"1-3-6-3\">\n                Explore\n            </span>\n        </div>\n        <div class=\"scroll-note\" data-kid=\"1-3-7\">\n            Scroll to explore\n        </div>\n        <div class=\"tabs\" data-kid=\"1-3-8\" id=\"products\">\n            <div class=\"tab\" data-kid=\"1-3-8-1\">\n                <div data-kid=\"1-3-8-1-1\">\n                    <h2 data-kid=\"1-3-8-1-1-1\">\n                        FLEX™\n                    </h2>\n                    <span data-kid=\"1-3-8-1-1-2\">\n                        EVERYDAY PLAY\n                    </span>\n                </div>\n                <div class=\"tab-meta\" data-kid=\"1-3-8-1-2\">\n                    <a data-kid=\"1-3-8-1-2-1\" href=\"#flex\">\n                        View range ↗\n                    </a>\n                    <span data-kid=\"1-3-8-1-2-2\">\n                        Buy in quantity\n                    </span>\n                </div>\n            </div>\n            <div class=\"tab\" data-kid=\"1-3-8-2\">\n                <div data-kid=\"1-3-8-2-1\">\n                    <h2 data-kid=\"1-3-8-2-1-1\">\n                        HERO™\n                    </h2>\n                    <span data-kid=\"1-3-8-2-1-2\">\n                        MORE AIR. MORE FUN.\n                    </span>\n                </div>\n                <div class=\"tab-meta\" data-kid=\"1-3-8-2-2\">\n                    <a data-kid=\"1-3-8-2-2-1\" href=\"#hero\">\n                        View range ↗\n                    </a>\n                    <span data-kid=\"1-3-8-2-2-2\">\n                        Buy in quantity\n                    </span>\n                </div>\n            </div>\n            <div class=\"tab active\" data-kid=\"1-3-8-3\">\n                <div data-kid=\"1-3-8-3-1\">\n                    <h2 data-kid=\"1-3-8-3-1-1\">\n                        MEGA™\n                    </h2>\n                    <span data-kid=\"1-3-8-3-1-2\">\n                        THE BIGGEST DAYS\n                    </span>\n                </div>\n                <div class=\"tab-meta\" data-kid=\"1-3-8-3-2\">\n                    <a data-kid=\"1-3-8-3-2-1\" href=\"#mega\">\n                        View range ↗\n                    </a>\n                    <span data-kid=\"1-3-8-3-2-2\">\n                        Buy in quantity\n                    </span>\n                </div>\n            </div>\n        </div>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger); const intro=gsap.timeline({defaults:{ease:'power3.out'}}); intro.from('.word',{opacity:0,y:-110,rotation:gsap.utils.random(-7,7),stagger:.12,duration:.78,ease:'bounce.out'}).from('.eyebrow,.lede,.actions',{opacity:0,y:24,stagger:.09,duration:.42},'-=.34').from('.art-wrap',{opacity:0,scale:1.16,x:70,duration:1.05,ease:'expo.out'},'-=.72').from('.sale-badge',{opacity:0,scale:.35,rotation:-38,duration:.65,ease:'back.out(1.8)'},'-=.5').from('.tab',{opacity:0,y:42,stagger:.11,duration:.48},'-=.3'); gsap.to('.art',{yPercent:-7,scale:1.06,ease:'none',scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}}); gsap.to('.sale-badge',{rotation:'+=8',repeat:-1,yoyo:true,duration:2.8,ease:'sine.inOut'}); document.addEventListener('visibilitychange',()=>{document.hidden?gsap.globalTimeline.pause():gsap.globalTimeline.resume();});\n</script>\n",
