      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n:root{--red:#da0000;--ink:#17222d;--lime:#a9e52c;--blue:#2374ff;--paper:#f3f2ee}\n.hero-shell,.hero-shell section,.hero-shell header,.hero-shell main,.hero-shell footer,.hero-shell div,.hero-shell nav,.hero-shell a,.hero-shell p,.hero-shell h1,.hero-shell span,.hero-shell img{box-sizing:border-box}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:'Space Grotesk',sans-serif}\n.gf{font-family:'Bebas Neue',Impact,sans-serif}\n.hero-shell{min-height:800px;overflow:hidden;background:var(--paper)}\n.sale{height:42px;background:var(--red);color:#fff;display:flex;align-items:center;justify-content:center;gap:18px;text-transform:uppercase;font-size:12px;font-weight:700;letter-spacing:.08em}\n.sale b{font-size:13px}.sale .sale-dot{width:7px;height:7px;background:var(--lime);border-radius:50%;display:inline-block}\n.nav{height:78px;background:rgba(23,34,45,.97);color:#fff;display:flex;align-items:center;padding:0 42px;gap:34px;position:relative;z-index:4}\n.logo{font-size:30px;font-weight:700;letter-spacing:-.08em;font-style:italic;line-height:1}.logo span{color:var(--lime)}\n.nav-links{display:flex;gap:27px;align-items:center;margin-left:auto;text-transform:uppercase;font-size:11px;font-weight:700;letter-spacing:.08em}.nav-links a{color:#fff;text-decoration:none;opacity:.88}.nav-actions{display:flex;gap:18px;align-items:center;border-left:1px solid rgba(255,255,255,.25);padding-left:25px;font-size:11px;font-weight:700}.nav-actions .circle{width:28px;height:28px;border:1px solid rgba(255,255,255,.7);border-radius:50%;display:grid;place-items:center;font-size:13px}\n.main{position:relative;min-height:590px;display:grid;grid-template-columns:48% 52%;padding:64px 54px 40px;gap:20px;background:linear-gradient(120deg,#f3f2ee 0%,#f3f2ee 62%,#e4e9eb 100%)}\n.main:before{content:'JF / 2025';position:absolute;right:43px;top:24px;color:rgba(23,34,45,.36);font-size:10px;font-weight:700;letter-spacing:.16em}\n.copy{position:relative;z-index:2;padding:13px 0 0 22px;max-width:610px}.eyebrow{color:var(--red);font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;margin:0 0 20px}.title{font-size:clamp(64px,7vw,112px);line-height:.84;letter-spacing:-.035em;margin:0;color:var(--ink)}.title .accent{color:var(--red);display:block}.body{max-width:440px;font-size:16px;line-height:1.45;margin:28px 0 26px;color:#37434c}.actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.primary{display:inline-flex;align-items:center;gap:18px;background:var(--lime);color:var(--ink);padding:16px 22px;text-decoration:none;font-weight:700;font-size:12px;letter-spacing:.12em;border:0;box-shadow:7px 7px 0 var(--ink)}.primary .arrow{font-size:17px}.bulk{color:var(--ink);font-size:11px;font-weight:700;letter-spacing:.1em;text-decoration:none;text-transform:uppercase;border-bottom:2px solid var(--red);padding-bottom:6px}.micro-proof{display:flex;gap:24px;margin-top:43px;padding-top:15px;border-top:1px solid rgba(23,34,45,.24);width:max-content;max-width:100%;font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:700}.micro-proof span{display:flex;align-items:center;gap:7px}.micro-proof i{width:8px;height:8px;background:var(--blue);display:inline-block}\n.visual{position:relative;min-height:450px;margin:0 15px 0 0}.photo-frame{position:absolute;right:32px;top:8px;width:min(74%,490px);height:480px;overflow:hidden;background:#84909a;box-shadow:17px 17px 0 var(--ink)}.photo-frame img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.9) contrast(1.04)}.photo-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(23,34,45,.03),rgba(23,34,45,.25))}.red-panel{position:absolute;left:5px;bottom:17px;width:194px;min-height:242px;background:var(--red);color:#fff;padding:24px 21px;z-index:2;transform:rotate(-6deg)}.red-panel:after{content:'';position:absolute;right:-14px;top:18px;width:28px;height:28px;background:var(--blue);transform:rotate(45deg)}.panel-kicker{font-size:9px;letter-spacing:.18em;font-weight:700;opacity:.8}.panel-lines{font-family:'Bebas Neue',sans-serif;font-size:38px;line-height:.86;margin:17px 0 27px}.panel-lines div:nth-child(2){color:var(--lime)}.panel-lines div:nth-child(3){color:#fff}.panel-stat{font-size:9px;line-height:1.35;font-weight:700;letter-spacing:.08em;border-top:1px solid rgba(255,255,255,.55);padding-top:11px}.number{position:absolute;right:0;top:69px;width:76px;height:76px;border:2px solid var(--ink);border-radius:50%;display:grid;place-items:center;font-size:13px;font-weight:700;letter-spacing:.03em;transform:rotate(12deg);background:var(--lime);z-index:3}.scribble{position:absolute;right:6px;bottom:16px;color:var(--blue);font-family:'Bebas Neue';font-size:22px;letter-spacing:.06em;transform:rotate(-12deg)}\n.trust{height:88px;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 56px;position:relative}.trust-label{font-size:10px;letter-spacing:.16em;color:rgba(255,255,255,.56);text-transform:uppercase}.trust-items{display:flex;gap:0}.trust-item{min-width:145px;padding:10px 27px;border-left:1px solid rgba(255,255,255,.24);font-family:'Bebas Neue';font-size:25px;letter-spacing:.05em}.trust-item:last-child{border-right:1px solid rgba(255,255,255,.24)}\n@media(max-width:800px){.sale{height:auto;min-height:44px;padding:10px 15px;text-align:center;line-height:1.3;font-size:10px}.sale .sale-dot{display:none}.nav{height:64px;padding:0 20px}.logo{font-size:27px}.nav-links{display:none}.nav-actions{margin-left:auto;border:0;padding:0}.main{display:flex;flex-direction:column;padding:34px 20px 28px;gap:30px}.main:before{right:20px;top:17px}.copy{padding:0}.eyebrow{margin-bottom:16px}.title{font-size:clamp(58px,16vw,90px)}.body{font-size:15px;margin:22px 0}.micro-proof{margin-top:28px;gap:13px}.visual{min-height:395px;margin:0}.photo-frame{left:19%;right:0;top:0;width:81%;height:370px}.red-panel{left:0;bottom:10px;width:165px;min-height:207px;padding:19px 16px}.panel-lines{font-size:33px;margin:13px 0 19px}.number{right:4px;top:12px;width:62px;height:62px;font-size:11px}.trust{height:auto;display:block;padding:20px}.trust-label{display:block;margin-bottom:14px}.trust-items{display:grid;grid-template-columns:1fr 1fr}.trust-item{min-width:0;padding:8px 14px;font-size:22px}.trust-item:last-child{border-right:0}}\n</style>\n<section class=\"hero-shell\" data-kid=\"1\" data-name=\"hero layout container\">\n    <div class=\"sale\" data-kid=\"1-1\" data-name=\"sale banner container\">\n        <span class=\"sale-dot\" data-kid=\"1-1-1\" data-name=\"sale decorative dot\">\n        </span>\n        <b data-kid=\"1-1-2\" data-name=\"sale headline\">\n            Labor Day Sale\n        </b>\n        <span data-kid=\"1-1-3\" data-name=\"sale promotional text\">\n            Up to $300 off FLEX™ & HERO™ · Up to $900 off MEGA™\n        </span>\n        <span class=\"sale-dot\" data-kid=\"1-1-4\" data-name=\"sale decorative dot\">\n        </span>\n    </div>\n    <header class=\"nav\" data-kid=\"1-2\" data-name=\"navigation header\">\n        <div class=\"logo\" data-kid=\"1-2-1\" data-name=\"brand logo\">\n            Jump\n            <span data-kid=\"1-2-1-1\" data-name=\"logo accent text\">\n                flex\n            </span>\n            <sup data-kid=\"1-2-1-2\" data-name=\"registered trademark symbol\">\n                ®\n            </sup>\n        </div>\n        <nav class=\"nav-links\" data-kid=\"1-2-2\" data-name=\"main navigation links\">\n            <a data-kid=\"1-2-2-1\" data-name=\"trampolines category link\" href=\"#range\">\n                Trampolines\n            </a>\n            <a data-kid=\"1-2-2-2\" data-name=\"accessories category link\" href=\"#accessories\">\n                Accessories\n            </a>\n            <a data-kid=\"1-2-2-3\" data-name=\"support menu link\" href=\"#support\">\n                Support⌄\n            </a>\n            <a data-kid=\"1-2-2-4\" data-name=\"about us link\" href=\"#about\">\n                About\n            </a>\n            <a data-kid=\"1-2-2-5\" data-name=\"contact link\" href=\"#contact\">\n                Contact\n            </a>\n            <a data-kid=\"1-2-2-6\" data-name=\"blog link\" href=\"#journal\">\n                Blog\n            </a>\n        </nav>\n        <div class=\"nav-actions\" data-kid=\"1-2-3\" data-name=\"navigation actions container\">\n            <span data-kid=\"1-2-3-1\" data-name=\"phone number text\">\n                +1 (866) 305 7238\n            </span>\n            <span class=\"circle\" data-kid=\"1-2-3-2\" data-name=\"search icon button\">\n                ⌕\n            </span>\n            <span class=\"circle\" data-kid=\"1-2-3-3\" data-name=\"account icon button\">\n                ⌑\n            </span>\n            <span class=\"circle\" data-kid=\"1-2-3-4\" data-name=\"cart icon button\">\n                □\n            </span>\n        </div>\n    </header>\n    <main class=\"main\" data-kid=\"1-3\" data-name=\"main content area\">\n        <div class=\"copy\" data-kid=\"1-3-1\" data-name=\"hero copy block\">\n            <p class=\"eyebrow\" data-kid=\"1-3-1-1\" data-name=\"hero eyebrow text\">\n                One standard of play\n            </p>\n            <h1 class=\"title\" data-kid=\"1-3-1-2\" data-name=\"hero main headline\" data-split=\"\">\n                FOR YOUR KIDS.\n                <span class=\"accent\" data-kid=\"1-3-1-2-1\" data-name=\"hero headline accent span\">\n                    FOR THEIR\n                    <br data-kid=\"1-3-1-2-1-1\" data-name=\"headline line break\"/>\n                    CUSTOMERS.\n                </span>\n            </h1>\n            <p class=\"body\" data-kid=\"1-3-1-3\" data-name=\"hero body text\">\n                Built for the backyard, the school, the park — wherever the next generation gets to move.\n            </p>\n            <div class=\"actions\" data-kid=\"1-3-1-4\" data-name=\"call to action container\">\n                <a class=\"primary\" data-kid=\"1-3-1-4-1\" data-name=\"primary action button\" href=\"#range\">\n                    VIEW RANGE\n                    <span class=\"arrow\" data-kid=\"1-3-1-4-1-1\" data-name=\"button arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"bulk\" data-kid=\"1-3-1-4-2\" data-name=\"bulk quote call to action\" href=\"#bulk\">\n                    BUY IN QUANTITY\n                    <span data-kid=\"1-3-1-4-2-1\" data-name=\"quote separator slash\">\n                        /\n                    </span>\n                    GET A BULK QUOTE\n                </a>\n            </div>\n            <div class=\"micro-proof\" data-kid=\"1-3-1-5\" data-name=\"micro-proof trust container\">\n                <span data-kid=\"1-3-1-5-1\" data-name=\"proof point one container\">\n                    <i data-kid=\"1-3-1-5-1-1\" data-name=\"proof point icon\">\n                    </i>\n                    Family-first design\n                </span>\n                <span data-kid=\"1-3-1-5-2\" data-name=\"proof point two container\">\n                    <i data-kid=\"1-3-1-5-2-1\" data-name=\"proof point icon\">\n                    </i>\n                    Commercial-ready\n                </span>\n            </div>\n        </div>\n        <div class=\"visual\" data-kid=\"1-3-2\" data-name=\"visual showcase container\">\n            <div class=\"photo-frame parallax\" data-kid=\"1-3-2-1\" data-name=\"hero image frame\">\n                <img alt=\"Child enjoying a trampoline in a backyard — Ron Lach on Pexels\" data-kid=\"1-3-2-1-1\" data-name=\"hero product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/10045070/pexels-photo-10045070.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80\"/>\n                <div class=\"photo-overlay\" data-kid=\"1-3-2-1-2\" data-name=\"image overlay gradient\">\n                </div>\n            </div>\n            <div class=\"red-panel panel\" data-kid=\"1-3-2-2\" data-name=\"promotional information panel\">\n                <div class=\"panel-kicker\" data-kid=\"1-3-2-2-1\" data-name=\"panel kicker label\">\n                    THE RANGE\n                </div>\n                <div class=\"panel-lines\" data-kid=\"1-3-2-2-2\" data-name=\"product list container\">\n                    <div data-kid=\"1-3-2-2-2-1\" data-name=\"product item flex\">\n                        FLEX™\n                    </div>\n                    <div data-kid=\"1-3-2-2-2-2\" data-name=\"product item hero\">\n                        HERO™\n                    </div>\n                    <div data-kid=\"1-3-2-2-2-3\" data-name=\"product item mega\">\n                        MEGA™\n                    </div>\n                </div>\n                <div class=\"panel-stat\" data-kid=\"1-3-2-2-3\" data-name=\"panel footer stats\">\n                    REVIEWS + WARRANTY\n                    <br data-kid=\"1-3-2-2-3-1\" data-name=\"stat footer line break\"/>\n                    APPROVED COPY PENDING\n                </div>\n            </div>\n            <div class=\"number\" data-kid=\"1-3-2-3\" data-name=\"page counter circle\">\n                01—04\n            </div>\n            <div class=\"scribble\" data-dynamic=\"true\" data-kid=\"1-3-2-4\" data-name=\"decorative text scribble\" data-reason=\"text rotated and translated by repeating script animation\">\n                BUILT TO MOVE →\n            </div>\n        </div>\n    </main>\n    <footer class=\"trust\" data-kid=\"1-4\" data-name=\"trust footer container\">\n        <div class=\"trust-label\" data-kid=\"1-4-1\" data-name=\"trust label\">\n            Made for every kind of play\n        </div>\n        <div class=\"trust-items\" data-kid=\"1-4-2\" data-name=\"trust items list\">\n            <div class=\"trust-item\" data-kid=\"1-4-2-1\" data-name=\"trust item home\">\n                HOME\n            </div>\n            <div class=\"trust-item\" data-kid=\"1-4-2-2\" data-name=\"trust item school\">\n                SCHOOL\n            </div>\n            <div class=\"trust-item\" data-kid=\"1-4-2-3\" data-name=\"trust item park\">\n                PARK\n            </div>\n            <div class=\"trust-item\" data-kid=\"1-4-2-4\" data-name=\"trust item gym\">\n                GYM\n            </div>\n        </div>\n    </footer>\n</section>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);window.addEventListener('load',function(){var tl=gsap.timeline({defaults:{ease:'bounce.out'}});tl.from('.eyebrow',{autoAlpha:0,y:18,duration:.35}).from('.title .accent',{autoAlpha:0,y:-72,rotation:-2,stagger:.08,duration:.72},'-=.1').from('.title',{autoAlpha:0,y:34,duration:.5,ease:'power3.out'},'-=.56').from('.body',{autoAlpha:0,y:18,duration:.38},'-=.28').from('.actions',{autoAlpha:0,y:16,duration:.32},'-=.18').from('.micro-proof',{autoAlpha:0,y:12,duration:.3},'-=.12').from('.photo-frame',{autoAlpha:0,scale:1.08,rotation:2,duration:.75,ease:'power3.out'},'-=.55').from('.panel',{autoAlpha:0,x:-54,rotation:-18,duration:.7,ease:'back.out(1.8)'},'-=.48').from('.number',{autoAlpha:0,scale:.3,rotation:-30,duration:.45,ease:'back.out(2)'},'-=.36');gsap.to('.parallax',{yPercent:-8,ease:'none',scrollTrigger:{trigger:'.main',start:'top bottom',end:'bottom top',scrub:.7}});gsap.to('.scribble',{rotation:'-=8',y:-6,duration:1.8,repeat:-1,yoyo:true,ease:'sine.inOut'});});\n</script>\n",
