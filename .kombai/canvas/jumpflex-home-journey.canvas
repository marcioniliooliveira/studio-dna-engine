    "var_47a45989be71": {
      "type": "variant",
      "label": "04 — Comparação de produtos",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap');\n  :root{--navy:#071522;--navy-2:#0d2232;--ink:#f5f7f2;--muted:#a7b6bc;--lime:#b8f31b;--red:#ef3f32;--blue:#2188ff;--line:#38515d;}\n  .jf-page{font-family:'DM Sans',sans-serif;background:var(--navy);color:var(--ink);min-height:800px;overflow-x:clip;}\n  .jf-display{font-family:'Barlow Condensed',sans-serif;}\n  .jf-grid{background-image:linear-gradient(to right,rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.04) 1px,transparent 1px);background-size:80px 80px;}\n  .jf-row{border-top:1px solid rgba(80,112,124,.78);}\n  .jf-cell{border-left:1px solid rgba(80,112,124,.72);}\n  .jf-outline{box-shadow:4px 4px 0 var(--blue);}\n  .jf-cta-row{background:linear-gradient(90deg,rgba(184,243,27,.05),transparent 42%,rgba(33,136,255,.04));}\n  .jf-mobile-line{background:linear-gradient(90deg,var(--lime) 0 44%,var(--blue) 44% 72%,var(--red) 72%);}\n  .jf-focus{outline:2px solid var(--lime);outline-offset:3px;}\n</style>\n<div class=\"jf-page jf-grid relative\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"absolute -right-24 top-28 h-72 w-72 rounded-full border border-[var(--blue)]/30\" data-kid=\"1-1\" data-name=\"decorative background circle\">\n    </div>\n    <div class=\"absolute right-[-70px] top-44 h-44 w-44 rounded-full border-[12px] border-[var(--red)]/20\" data-kid=\"1-2\" data-name=\"decorative background ring\">\n    </div>\n    <header class=\"relative z-10 flex h-[74px] items-center justify-between border-b border-white/15 px-12\" data-kid=\"1-3\" data-name=\"header bar\">\n        <div class=\"flex items-center gap-4\" data-kid=\"1-3-1\" data-name=\"brand and navigation group\">\n            <div class=\"jf-display text-[28px] font-900 tracking-[-.04em]\" data-kid=\"1-3-1-1\" data-name=\"brand logo text\">\n                JUMP\n                <span class=\"text-[var(--lime)]\" data-kid=\"1-3-1-1-1\" data-name=\"brand logo accent text\">\n                    FLEX\n                </span>\n            </div>\n            <span class=\"hidden border-l border-white/25 pl-4 text-[10px] font-bold uppercase tracking-[.2em] text-white/55 md:block\" data-kid=\"1-3-1-2\" data-name=\"breadcrumb navigation text\">\n                Home / escolha guiada\n            </span>\n        </div>\n        <div class=\"flex items-center gap-8\" data-kid=\"1-3-2\" data-name=\"utility navigation group\">\n            <div class=\"hidden items-center gap-7 text-[10px] font-bold uppercase tracking-[.16em] text-white/70 md:flex\" data-kid=\"1-3-2-1\" data-name=\"secondary navigation links\">\n                <span data-kid=\"1-3-2-1-1\" data-name=\"trampolines link\">\n                    TRAMPOLINS\n                </span>\n                <span data-kid=\"1-3-2-1-2\" data-name=\"accessories link\">\n                    ACESSÓRIOS\n                </span>\n                <span data-kid=\"1-3-2-1-3\" data-name=\"support link\">\n                    SUPORTE\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3 text-[11px] font-bold tracking-wider\" data-kid=\"1-3-2-2\" data-name=\"step indicator group\">\n                <span class=\"hidden text-white/60 md:inline\" data-kid=\"1-3-2-2-1\" data-name=\"current step number\">\n                    04\n                </span>\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--lime)]\" data-kid=\"1-3-2-2-2\" data-name=\"active step dot icon\">\n                </span>\n                <span class=\"text-white/45\" data-kid=\"1-3-2-2-3\" data-name=\"total steps number\">\n                    07\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"relative z-10 px-12 pb-8 pt-9\" data-kid=\"1-4\" data-name=\"main content section\">\n        <div class=\"mb-7 flex items-end justify-between\" data-kid=\"1-4-1\" data-name=\"content header group\">\n            <div data-kid=\"1-4-1-1\" data-name=\"title area\">\n                <div class=\"mb-2 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[.25em] text-[var(--lime)]\" data-kid=\"1-4-1-1-1\" data-name=\"section label with line\">\n                    <span class=\"h-px w-9 bg-[var(--lime)]\" data-kid=\"1-4-1-1-1-1\" data-name=\"horizontal line icon\">\n                    </span>\n                    04 / 07 · COMPARAÇÃO\n                </div>\n                <h1 class=\"jf-display text-[52px] font-800 uppercase leading-[.88] tracking-[-.02em]\" data-kid=\"1-4-1-1-2\" data-name=\"page main headline\">\n                    COMPARE ANTES\n                    <br data-kid=\"1-4-1-1-2-1\"/>\n                    <span class=\"text-[var(--lime)]\" data-kid=\"1-4-1-1-2-2\" data-name=\"headline accent text\">\n                        DE ESCOLHER\n                    </span>\n                </h1>\n            </div>\n            <div class=\"max-w-[270px] border-l-2 border-[var(--red)] pl-4 pb-1 text-right text-[11px] leading-4 text-white/60\" data-kid=\"1-4-1-2\" data-name=\"disclaimer text block\">\n                Conteúdo comercial sujeito à aprovação.\n                <br data-kid=\"1-4-1-2-1\"/>\n                <span class=\"text-white/35\" data-kid=\"1-4-1-2-2\" data-name=\"muted disclaimer text\">\n                    Dados pendentes aparecem sinalizados.\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Comparação de produtos\" class=\"relative border border-[var(--line)] bg-[var(--navy-2)]/85\" data-kid=\"1-4-2\" data-name=\"product comparison table\">\n            <div class=\"grid grid-cols-[210px_repeat(3,1fr)] border-b border-[var(--line)] bg-white/[.03]\" data-kid=\"1-4-2-1\" data-name=\"table header row\">\n                <div class=\"flex items-end px-5 pb-4 text-[9px] font-bold uppercase tracking-[.2em] text-white/40\" data-kid=\"1-4-2-1-1\" data-name=\"profile selector label\">\n                    Escolha por perfil\n                </div>\n                <div class=\"jf-cell px-5 pb-4 pt-4\" data-kid=\"1-4-2-1-2\" data-name=\"flex product header\">\n                    <div class=\"mb-1 flex items-center justify-between\" data-kid=\"1-4-2-1-2-1\" data-name=\"flex product name group\">\n                        <span class=\"jf-display text-[31px] font-800 leading-none text-[var(--lime)]\" data-kid=\"1-4-2-1-2-1-1\" data-name=\"flex product name\">\n                            FLEX™\n                        </span>\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--lime)]\" data-kid=\"1-4-2-1-2-1-2\" data-name=\"flex status dot\">\n                        </span>\n                    </div>\n                    <div class=\"text-[9px] font-bold uppercase tracking-[.16em] text-white/50\" data-kid=\"1-4-2-1-2-2\" data-name=\"flex description text\">\n                        Para o dia a dia\n                    </div>\n                </div>\n                <div class=\"jf-cell border-t-4 border-t-[var(--blue)] px-5 pb-4 pt-3\" data-kid=\"1-4-2-1-3\" data-name=\"hero product header\">\n                    <div class=\"mb-1 flex items-center justify-between\" data-kid=\"1-4-2-1-3-1\" data-name=\"hero product name group\">\n                        <span class=\"jf-display text-[31px] font-800 leading-none text-white\" data-kid=\"1-4-2-1-3-1-1\" data-name=\"hero product name\">\n                            HERO™\n                        </span>\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--blue)]\" data-kid=\"1-4-2-1-3-1-2\" data-name=\"hero status dot\">\n                        </span>\n                    </div>\n                    <div class=\"text-[9px] font-bold uppercase tracking-[.16em] text-white/50\" data-kid=\"1-4-2-1-3-2\" data-name=\"hero description text\">\n                        Mais ar, mais diversão\n                    </div>\n                </div>\n                <div class=\"jf-cell px-5 pb-4 pt-4\" data-kid=\"1-4-2-1-4\" data-name=\"mega product header\">\n                    <div class=\"mb-1 flex items-center justify-between\" data-kid=\"1-4-2-1-4-1\" data-name=\"mega product name group\">\n                        <span class=\"jf-display text-[31px] font-800 leading-none text-[var(--red)]\" data-kid=\"1-4-2-1-4-1-1\" data-name=\"mega product name\">\n                            MEGA™\n                        </span>\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--red)]\" data-kid=\"1-4-2-1-4-1-2\" data-name=\"mega status dot\">\n                        </span>\n                    </div>\n                    <div class=\"text-[9px] font-bold uppercase tracking-[.16em] text-white/50\" data-kid=\"1-4-2-1-4-2\" data-name=\"mega description text\">\n                        Para os maiores dias\n                    </div>\n                </div>\n            </div>\n            <div class=\"jf-row grid grid-cols-[210px_repeat(3,1fr)]\" data-kid=\"1-4-2-2\" data-name=\"ideal for row\">\n                <div class=\"flex items-center px-5 py-3.5 text-[11px] font-bold uppercase tracking-[.13em] text-white/65\" data-kid=\"1-4-2-2-1\" data-name=\"row label\">\n                    Ideal para\n                </div>\n                <div class=\"jf-cell flex items-center px-5 py-3.5 text-[12px] text-white/90\" data-kid=\"1-4-2-2-2\" data-name=\"flex value\">\n                    <span class=\"mr-2 h-1.5 w-1.5 bg-[var(--lime)]\" data-kid=\"1-4-2-2-2-1\">\n                    </span>\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell flex items-center px-5 py-3.5 text-[12px] text-white/90\" data-kid=\"1-4-2-2-3\" data-name=\"hero value\">\n                    <span class=\"mr-2 h-1.5 w-1.5 bg-[var(--blue)]\" data-kid=\"1-4-2-2-3-1\">\n                    </span>\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell flex items-center px-5 py-3.5 text-[12px] text-white/90\" data-kid=\"1-4-2-2-4\" data-name=\"mega value\">\n                    <span class=\"mr-2 h-1.5 w-1.5 bg-[var(--red)]\" data-kid=\"1-4-2-2-4-1\">\n                    </span>\n                    [PENDENTE]\n                </div>\n            </div>\n            <div class=\"jf-row grid grid-cols-[210px_repeat(3,1fr)] bg-white/[.025]\" data-kid=\"1-4-2-3\" data-name=\"sensação row\">\n                <div class=\"flex items-center px-5 py-3.5 text-[11px] font-bold uppercase tracking-[.13em] text-white/65\" data-kid=\"1-4-2-3-1\" data-name=\"row label\">\n                    Sensação\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px] font-semibold text-[var(--lime)]\" data-kid=\"1-4-2-3-2\" data-name=\"flex value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px] font-semibold text-[var(--blue)]\" data-kid=\"1-4-2-3-3\" data-name=\"hero value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px] font-semibold text-[var(--red)]\" data-kid=\"1-4-2-3-4\" data-name=\"mega value\">\n                    [PENDENTE]\n                </div>\n            </div>\n            <div class=\"jf-row grid grid-cols-[210px_repeat(3,1fr)]\" data-kid=\"1-4-2-4\" data-name=\"sizes row\">\n                <div class=\"flex items-center px-5 py-3.5 text-[11px] font-bold uppercase tracking-[.13em] text-white/65\" data-kid=\"1-4-2-4-1\" data-name=\"row label\">\n                    Tamanhos / modelos\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px]\" data-kid=\"1-4-2-4-2\" data-name=\"flex value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px]\" data-kid=\"1-4-2-4-3\" data-name=\"hero value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px]\" data-kid=\"1-4-2-4-4\" data-name=\"mega value\">\n                    [PENDENTE]\n                </div>\n            </div>\n            <div class=\"jf-row grid grid-cols-[210px_repeat(3,1fr)] bg-white/[.025]\" data-kid=\"1-4-2-5\" data-name=\"starting price row\">\n                <div class=\"flex items-center px-5 py-3.5 text-[11px] font-bold uppercase tracking-[.13em] text-white/65\" data-kid=\"1-4-2-5-1\" data-name=\"row label\">\n                    A partir de\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px] font-semibold text-[var(--lime)]\" data-kid=\"1-4-2-5-2\" data-name=\"flex value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px] font-semibold text-[var(--blue)]\" data-kid=\"1-4-2-5-3\" data-name=\"hero value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px] font-semibold text-[var(--red)]\" data-kid=\"1-4-2-5-4\" data-name=\"mega value\">\n                    [PENDENTE]\n                </div>\n            </div>\n            <div class=\"jf-row grid grid-cols-[210px_repeat(3,1fr)]\" data-kid=\"1-4-2-6\" data-name=\"parcelamento row\">\n                <div class=\"flex items-center px-5 py-3.5 text-[11px] font-bold uppercase tracking-[.13em] text-white/65\" data-kid=\"1-4-2-6-1\" data-name=\"row label\">\n                    Parcelamento\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px]\" data-kid=\"1-4-2-6-2\" data-name=\"flex value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px]\" data-kid=\"1-4-2-6-3\" data-name=\"hero value\">\n                    [PENDENTE]\n                </div>\n                <div class=\"jf-cell px-5 py-3.5 text-[12px]\" data-kid=\"1-4-2-6-4\" data-na