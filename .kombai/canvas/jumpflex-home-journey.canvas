      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n.jf-page{font-family:'Space Grotesk',sans-serif;background:#17222d;color:#f8fafc;min-height:800px;overflow:clip}\n.jf-display{font-family:'Bebas Neue',sans-serif}\n.jf-card{position:relative;isolation:isolate;transition:transform .2s ease,background-color .2s ease,border-color .2s ease}\n.jf-card:hover,.jf-card:focus-within{transform:translate(-4px,-4px)}\n.jf-card:focus-within{outline:2px solid #fff;outline-offset:4px}\n.jf-card[data-active=\"true\"]{transform:translate(-6px,-6px)}\n.jf-art:before,.jf-art:after{content:'';position:absolute;inset:16px;border:1px solid currentColor;opacity:.38;transform:skewY(-7deg)}\n.jf-art:after{inset:32px 52px;border-width:2px;transform:skewY(7deg) rotate(-4deg);opacity:.7}\n.jf-ring{position:absolute;border:2px solid currentColor;border-radius:999px;opacity:.6}\n</style>\n<div class=\"jf-page\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"flex h-10 items-center justify-center bg-[#ed1717] px-6 text-[10px] font-bold uppercase tracking-[.2em] text-white\" data-kid=\"1-1\" data-name=\"labor day sale banner\">\n        <span data-kid=\"1-1-1\" data-name=\"sale name text\">\n            LABOR DAY SALE\n        </span>\n        <span class=\"mx-5 text-white/45\" data-kid=\"1-1-2\" data-name=\"separator symbol\">\n            |\n        </span>\n        <span data-kid=\"1-1-3\" data-name=\"sale offer text\">\n            ATÉ $300 OFF FLEX™ & HERO™\n        </span>\n        <span class=\"mx-5 text-white/45\" data-kid=\"1-1-4\" data-name=\"separator symbol\">\n            |\n        </span>\n        <span data-dynamic=\"true\" data-kid=\"1-1-5\" data-name=\"sale countdown timer\" data-reason=\"text content updated by script\">\n            04 D  13 H  16 M\n        </span>\n    </div>\n    <header class=\"flex h-[72px] items-center justify-between border-b border-white/15 bg-[#17222d] px-10\" data-kid=\"1-2\" data-name=\"site header\">\n        <div class=\"text-[23px] font-bold tracking-[-.09em]\" data-kid=\"1-2-1\" data-name=\"brand logo text\">\n            JUMP\n            <span class=\"text-[#b5f21b]\" data-kid=\"1-2-1-1\" data-name=\"brand highlight text\">\n                FLEX\n            </span>\n        </div>\n        <nav aria-label=\"Navegação principal\" class=\"hidden items-center gap-9 text-[10px] font-bold uppercase tracking-[.18em] text-white/70 md:flex\" data-kid=\"1-2-2\" data-name=\"main navigation bar\">\n            <a class=\"hover:text-white\" data-kid=\"1-2-2-1\" data-name=\"trampolines link\" href=\"#range\">\n                TRAMPOLINES\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-2-2-2\" data-name=\"accessories link\" href=\"#range\">\n                ACCESSORIES\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-2-2-3\" data-name=\"support link\" href=\"#support\">\n                SUPPORT\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-2-2-4\" data-name=\"about link\" href=\"#about\">\n                ABOUT\n            </a>\n            <a class=\"hover:text-white\" data-kid=\"1-2-2-5\" data-name=\"contact link\" href=\"#contact\">\n                CONTACT\n            </a>\n        </nav>\n        <div class=\"flex items-center gap-5 text-[11px] font-bold tracking-widest text-white/60\" data-kid=\"1-2-3\" data-name=\"utility navigation bar\">\n            <span data-kid=\"1-2-3-1\" data-name=\"phone number text\">\n                +1 (886) 305 7238\n            </span>\n            <span aria-label=\"Buscar\" class=\"text-lg\" data-kid=\"1-2-3-2\" data-name=\"search icon\">\n                ⌕\n            </span>\n            <span aria-label=\"Conta\" class=\"text-sm\" data-kid=\"1-2-3-3\" data-name=\"user account icon\">\n                ◎\n            </span>\n        </div>\n    </header>\n    <main class=\"px-10 pb-7 pt-7\" data-kid=\"1-3\" data-name=\"product range main section\" id=\"range\">\n        <div class=\"mb-6 flex items-end justify-between border-b border-white/15 pb-5\" data-kid=\"1-3-1\" data-name=\"section header container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"header title group\">\n                <div class=\"mb-2 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[.3em] text-[#b5f21b]\" data-kid=\"1-3-1-1-1\" data-name=\"product range indicator group\">\n                    <span data-kid=\"1-3-1-1-1-1\" data-name=\"product range label\">\n                        PRODUCT RANGE\n                    </span>\n                    <span class=\"h-px w-10 bg-[#b5f21b]\" data-kid=\"1-3-1-1-1-2\" data-name=\"decorative line\">\n                    </span>\n                    <span class=\"text-white/50\" data-kid=\"1-3-1-1-1-3\" data-name=\"pagination counter\">\n                        03 / 07\n                    </span>\n                </div>\n                <h1 class=\"jf-display text-[68px] leading-[.88] tracking-[.045em] text-white\" data-kid=\"1-3-1-1-2\" data-name=\"main page headline\">\n                    ENCONTRE O SEU RITMO\n                </h1>\n                <p class=\"mt-3 text-[16px] text-white/60\" data-kid=\"1-3-1-1-3\" data-name=\"subheadline text\">\n                    Três linhas. Um jeito melhor de brincar.\n                </p>\n            </div>\n            <div class=\"mb-1 flex max-w-[230px] items-center gap-3 text-right text-[10px] font-bold uppercase leading-[1.45] tracking-[.16em] text-white/55\" data-kid=\"1-3-1-2\" data-name=\"call to action hint group\">\n                <span class=\"h-2 w-2 shrink-0 bg-[#b5f21b]\" data-kid=\"1-3-1-2-1\" data-name=\"hint bullet point\">\n                </span>\n                Escolha uma linha para continuar\n            </div>\n        </div>\n        <div class=\"grid grid-cols-3 gap-5\" data-kid=\"1-3-2\" data-name=\"product cards grid container\">\n            <article class=\"jf-card border border-[#b5f21b] bg-[#263744] p-5 shadow-[8px_8px_0_#b5f21b]\" data-active=\"true\" data-kid=\"1-3-2-1\" data-name=\"flex product card\">\n                <div aria-label=\"Espaço reservado para imagem do FLEX™\" class=\"jf-art relative flex h-[218px] items-center justify-center overflow-hidden bg-[#1d2b36] text-[#b5f21b]\" data-kid=\"1-3-2-1-1\" data-name=\"flex product art container\">\n                    <span class=\"jf-ring h-36 w-36\" data-kid=\"1-3-2-1-1-1\" data-name=\"decorative ring\">\n                    </span>\n                    <span class=\"jf-ring h-24 w-24 rotate-12\" data-kid=\"1-3-2-1-1-2\" data-name=\"decorative ring\">\n                    </span>\n                    <span class=\"absolute -right-9 -top-12 h-32 w-32 rotate-45 border-l border-b opacity-50\" data-kid=\"1-3-2-1-1-3\" data-name=\"decorative corner accent\">\n                    </span>\n                    <span class=\"jf-display relative z-10 text-[23px] tracking-[.16em]\" data-kid=\"1-3-2-1-1-4\" data-name=\"product name logo\">\n                        FLEX™\n                    </span>\n                    <span class=\"absolute bottom-3 left-4 text-[9px] font-bold tracking-[.25em] text-white/35\" data-kid=\"1-3-2-1-1-5\" data-name=\"placeholder image label\">\n                        IMAGEM DO PRODUTO\n                    </span>\n                </div>\n                <div class=\"mt-5 flex items-start justify-between gap-3\" data-kid=\"1-3-2-1-2\" data-name=\"product card header\">\n                    <div data-kid=\"1-3-2-1-2-1\" data-name=\"product title group\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[.2em] text-[#b5f21b]\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"product category label\">\n                            BRINCADEIRA PARA TODOS OS DIAS\n                        </p>\n                        <h2 class=\"jf-display mt-1 text-[55px] leading-none tracking-wide\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"product headline\">\n                            FLEX™\n                        </h2>\n                    </div>\n                    <span class=\"mt-1 border border-[#b5f21b]/50 px-2 py-1 text-[9px] font-bold tracking-[.16em] text-[#b5f21b]\" data-kid=\"1-3-2-1-2-2\" data-name=\"product index badge\">\n                        01\n                    </span>\n                </div>\n                <p class=\"mt-2 max-w-[290px] text-[13px] leading-snug text-white/65\" data-kid=\"1-3-2-1-3\" data-name=\"product description text\">\n                    Uma linha para encaixar na rotina da família.\n                </p>\n                <p class=\"mt-3 text-[10px] font-medium text-white/45\" data-kid=\"1-3-2-1-4\" data-name=\"price status text\">\n                    Preço e condições pendentes\n                </p>\n                <div class=\"mt-5 flex items-center gap-4\" data-kid=\"1-3-2-1-5\" data-name=\"product action container\">\n                    <a class=\"bg-[#b5f21b] px-5 py-3 text-[10px] font-bold tracking-[.18em] text-[#17222d] shadow-[4px_4px_0_#48a8ff]\" data-kid=\"1-3-2-1-5-1\" data-name=\"view range button\" href=\"#flex\">\n                        VIEW RANGE ↗\n                    </a>\n                    <a class=\"text-[10px] font-bold tracking-[.14em] text-white/60 underline decoration-white/30 underline-offset-4\" data-kid=\"1-3-2-1-5-2\" data-name=\"bulk order link\" href=\"#quantity\">\n                        BUY IN QUANTITY\n                    </a>\n                </div>\n            </article>\n            <article class=\"jf-card border border-[#48a8ff]/80 bg-[#243544] p-5\" data-active=\"false\" data-kid=\"1-3-2-2\" data-name=\"hero product card\">\n                <div aria-label=\"Espaço reservado para imagem do HERO™\" class=\"jf-art relative flex h-[218px] items-center justify-center overflow-hidden bg-[#1c2a36] text-[#48a8ff]\" data-kid=\"1-3-2-2-1\" data-name=\"hero product art container\">\n                    <span class=\"jf-ring h-40 w-40 -rotate-12\" data-kid=\"1-3-2-2-1-1\" data-name=\"decorative ring\">\n                    </span>\n                    <span class=\"jf-ring h-24 w-36 rotate-12\" data-kid=\"1-3-2-2-1-2\" data-name=\"decorative ring\">\n                    </span>\n                    <span class=\"absolute right-7 top-7 h-12 w-12 border-r-2 border-t-2\" data-kid=\"1-3-2-2-1-3\" data-name=\"decorative corner accent\">\n                    </span>\n                    <span class=\"jf-display relative z-10 text-[23px] tracking-[.16em]\" data-kid=\"1-3-2-2-1-4\" data-name=\"product name logo\">\n                        HERO™\n                    </span>\n                    <span class=\"absolute bottom-3 left-4 text-[9px] font-bold tracking-[.25em] text-white/35\" data-kid=\"1-3-2-2-1-5\" data-name=\"placeholder image label\">\n                        IMAGEM DO PRODUTO\n                    </span>\n                </div>\n                <div class=\"mt-5 flex items-start justify-between gap-3\" data-kid=\"1-3-2-2-2\" data-name=\"product card header\">\n                    <div data-kid=\"1-3-2-2-2-1\" data-name=\"product title group\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[.2em] text-[#48a8ff]\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"product category label\">\n                            MAIS AR. MAIS DIVERSÃO.\n                        </p>\n                        <h2 class=\"jf-display mt-1 text-[55px] leading-none tracking-wide\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"product headline\">\n                            HERO™\n                        </h2>\n                    </div>\n                    <span class=\"mt-1 border border-[#48a8ff]/50 px-2 py-1 text-[9px] font-bold tracking-[.16em] text-[#48a8ff]\" data-kid=\"1-3-2-2-2-2\" data-name=\"product index badge\">\n                        02\n                    </span>\n                </div>\n                <p class=\"mt-2 max-w-[290px] text-[13px] leading-snug text-white/65\" data-kid=\"1-3-2-2-3\" data-name=\"product description text\">\n                    Mais espaço para transformar cada salto.\n                </p>\n                <p class=\"mt-3 text-[10px] font-medium text-white/45\" data-kid=\"1-3-2-2-4\" data-name=\"price status text\">\n                    Preço e condições pendentes\n                </p>\n                <div class=\"mt-5 flex items-center gap-4\" data-kid=\"1-3-2-2-5\" data-name=\"product action container\">\n                    <a class=\"bg-[#48a8ff] px-5 py-3 text-[10px] font-bold tracking-[.18em] text-[#17222d]\" data-kid=\"1-3-2-2-5-1\" data-name=\"view range button\" href=\"#hero\">\n                        VIEW RANGE ↗\n                    </a>\n                    <a class=\"text-[10px] font-bold tracking-[.14em] text-white/60 underline decoration-white/30 underline-offset-4\" data-kid=\"1-3-2-2-5-2\" data-name=\"bulk order link\" href=\"#quantity\">\n                        BUY IN QUANTITY\n                    </a>\n                </div>\n            </article>\n            <article class=\"jf-card border border-[#ff514b]/80 bg-[#2b3540] p-5\" data-active=\"false\" data-kid=\"1-3-2-3\" data-name=\"mega product card\">\n                <div aria-label=\"Espaço reservado para imagem do MEGA™\" class=\"jf-art relative flex h-[218px] items-center justify-center overflow-hidden bg-[#222c36] text-[#ff514b]\" data-kid=\"1-3-2-3-1\" data-name=\"mega product art container\">\n                    <span class=\"jf-ring h-44 w-44 rotate-45\" data-kid=\"1-3-2-3-1-1\" data-name=\"decorative ring\">\n                    </span>\n                    <span class=\"jf-ring h-28 w-28 -rotate-12\" data-kid=\"1-3-2-3-1-2\" data-name=\"decorative ring\">\n                    </span>\n                    <span class=\"absolute -bottom-10 -left-5 h-28 w-28 border-r-2 border-t-2\" data-kid=\"1-3-2-3-1-3\" data-name=\"decorative corner accent\">\n                    </span>\n                    <span class=\"jf-display relative z-10 text-[23px] tracking-[.16em]\" data-kid=\"1-3-2-3-1-4\" data-name=\"product name logo\">\n                        MEGA™\n                    </span>\n                    <span class=\"absolute bottom-3 left-4 text-[9px] font-bold tracking-[.25em] text-white/35\" data-kid=\"1-3-2-3-1-5\" data-name=\"placeholder image label\">\n                        IMAGEM DO PRODUTO\n                    </span>\n                </div>\n                <div class=\"mt-5 flex items-start justify-between gap-3\" data-kid=\"1-3-2-3-2\" data-name=\"product card header\">\n                    <div data-kid=\"1-3-2-3-2-1\" data-name=\"product title group\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[.2em] text-[#ff514b]\" data-kid=\"1-3-2-3-2-1-1\" data-name=\"product category label\">\n                            PARA OS MAIORES DIAS\n                        </p>\n                        <h2 class=\"jf-display mt-1 text-[55px] leading-none tracking-wide\" data-kid=\"1-3-2-3-2-1-2\" data-name=\"product headline\">\n                            MEGA™\n                        </h2>\n                    </div>\n                    <span class=\"mt-1 border border-[#ff514b]/50 px-2 py-1 text-[9px] font-bold tracking-[.16em] text-[#ff514b]\" data-kid=\"1-3-2-3-2-2\" data-name=\"product index badge\">\n                        03\n                    </span>\n                </div>\n                <p class=\"mt-2 max-w-[290px] text-[13px] leading-snug text-white/65\" data-kid=\"1-3-2-3-3\" data-name=\"product description text\">\n                    Uma presença maior para os grandes momentos.\n                </p>\n                <p class=\"mt-3 text-[10px] font-medium text-white/45\" data-kid=\"1-3-2-3-4\" data-name=\"price status text\">\n                    Preço e condições pendentes\n                </p>\n                <div class=\"mt-5 flex items-center gap-4\" data-kid=\"1-3-2-3-5\" data-name=\"product action container\">\n                    <a class=\"bg-[#ff514b] px-5 py-3 text-[10px] font-bold tracking-[.18em] text-white\" data-kid=\"1-3-2-3-5-1\" data-name=\"view range button\" href=\"#mega\">\n                        VIEW RANGE ↗\n                    </a>\n                    <a class=\"text-[10px] font-bold tracking-[.14em] text-white/60 underline decoration-white/30 underline-offset-4\" data-kid=\"1-3-2-3-5-2\" data-name=\"bulk order link\" href=\"#quantity\">\n                        BUY IN QUANTITY\n                    </a>\n                </div>\n            </article>\n        </div>\n        <div class=\"mt-7 flex items-center gap-5\" data-kid=\"1-3-3\" data-name=\"range progress control container\">\n            <span class=\"jf-display text-2xl tracking-wide text-white/80\" data-kid=\"1-3-3-1\" data-name=\"range counter text\">\n                03 / 07\n            </span>\n            <div class=\"h-[3px] flex-1 bg-white/15\" data-kid=\"1-3-3-2\" data-name=\"progress track container\">\n                <div class=\"h-full w-[43%] bg-[#b5f21b]\" data-kid=\"1-3-3-2-1\" data-name=\"progress bar fill\">\n                </div>\n            </div>\n            <span class=\"text-[9px] font-bold uppercase tracking-[.2em] text-white/40\" data-kid=\"1-3-3-3\" data-name=\"range label text\">\n                RANGE RAIL\n            </span>\n        </div>\n    </main>\n</div>\n<script>\n    document.querySelectorAll('.jf-card').forEach((card)=>{card.addEventListener('focusin',()=>{document.querySelectorAll('.jf-card').forEach(c=>c.dataset.active='false');card.dataset.active='true'});card.addEventListener('mouseenter',()=>{document.querySelectorAll('.jf-card').forEach(c=>c.dataset.active='false');card.dataset.active='true'})});\n</script>\n",
