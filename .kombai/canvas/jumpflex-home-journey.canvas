      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n@keyframes paperDrift{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-5px) rotate(1deg)}}\n@keyframes pulseLine{0%,100%{opacity:.55}50%{opacity:1}}\n.jf-drift{animation:paperDrift 5s ease-in-out infinite}.jf-pulse{animation:pulseLine 2.8s ease-in-out infinite}\n</style>\n<main class=\"min-h-[800px] w-[1280px] overflow-clip bg-[#f2f0eb] px-[56px] py-[38px] text-[#101d35]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Space Grotesk',sans-serif\">\n    <div class=\"relative flex h-full min-h-[724px] flex-col\" data-kid=\"1-1\" data-name=\"main content wrapper\">\n        <div class=\"absolute -right-3 top-0 h-[70px] w-[128px] rotate-[-6deg] bg-[#b9f227] jf-drift\" data-kid=\"1-1-1\" data-name=\"decorative drifting paper accent\">\n        </div>\n        <header class=\"relative z-10 flex items-center justify-between border-b-2 border-[#101d35] pb-4\" data-kid=\"1-1-2\" data-name=\"site header bar\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-2-1\" data-name=\"site branding group\">\n                <div class=\"h-3 w-3 bg-[#e64131]\" data-kid=\"1-1-2-1-1\" data-name=\"logo square icon\">\n                </div>\n                <span class=\"text-[12px] font-bold uppercase tracking-[.24em]\" data-kid=\"1-1-2-1-2\" data-name=\"site brand name text\">\n                    JUMPFLEX / SOCIAL PROOF\n                </span>\n            </div>\n            <div class=\"flex items-center gap-8 text-[11px] font-bold uppercase tracking-[.18em]\" data-kid=\"1-1-2-2\" data-name=\"navigation menu\">\n                <span data-kid=\"1-1-2-2-1\" data-name=\"menu item family\">\n                    FAMÍLIA\n                </span>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"menu item real usage\">\n                    USO REAL\n                </span>\n                <span class=\"text-[#e64131]\" data-kid=\"1-1-2-2-3\" data-name=\"menu page progress indicator\">\n                    05 / 07\n                </span>\n            </div>\n        </header>\n        <section class=\"relative z-10 grid grid-cols-[1fr_300px] gap-10 pt-8\" data-kid=\"1-1-3\" data-name=\"hero content section\">\n            <div data-kid=\"1-1-3-1\" data-name=\"hero text container\">\n                <div class=\"mb-3 flex items-center gap-3 text-[12px] font-bold uppercase tracking-[.22em] text-[#e64131]\" data-kid=\"1-1-3-1-1\" data-name=\"hero subheadline group\">\n                    <span class=\"h-[2px] w-12 bg-[#e64131]\" data-kid=\"1-1-3-1-1-1\" data-name=\"decorative red horizontal line\">\n                    </span>\n                    <span data-kid=\"1-1-3-1-1-2\" data-name=\"hero subheadline text\">\n                        O QUE FICA É A EXPERIÊNCIA\n                    </span>\n                </div>\n                <h1 class=\"max-w-[780px] text-[82px] font-normal uppercase leading-[.84] tracking-[-.02em]\" data-kid=\"1-1-3-1-2\" data-name=\"hero main headline\" style=\"font-family:'Bebas Neue',sans-serif\">\n                    CONSTRUÍDO PARA OS\n                    <br data-kid=\"1-1-3-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#e64131]\" data-kid=\"1-1-3-1-2-2\" data-name=\"hero highlighted headline text\">\n                        DIAS QUE FICAM\n                    </span>\n                </h1>\n                <p class=\"mt-5 max-w-[560px] text-[16px] leading-6 text-[#101d35]/75\" data-kid=\"1-1-3-1-3\" data-name=\"hero description text\">\n                    Prova real entra aqui quando os dados forem aprovados.\n                </p>\n            </div>\n            <aside class=\"relative min-h-[265px] border-2 border-[#101d35] bg-[#101d35] p-6 text-[#f2f0eb] shadow-[10px_10px_0_#e64131]\" data-kid=\"1-1-3-2\" data-name=\"guarantee sidebar card\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-1-3-2-1\" data-name=\"sidebar header\">\n                    <span class=\"text-[11px] font-bold uppercase tracking-[.2em] text-[#b9f227]\" data-kid=\"1-1-3-2-1-1\" data-name=\"sidebar category label\">\n                        SLOT DE CONTEÚDO\n                    </span>\n                    <span class=\"text-xl text-[#b9f227]\" data-kid=\"1-1-3-2-1-2\" data-name=\"diagonal arrow icon\">\n                        ↗\n                    </span>\n                </div>\n                <h2 class=\"mt-3 text-[56px] font-normal leading-none text-[#b9f227]\" data-kid=\"1-1-3-2-2\" data-name=\"guarantee title\" style=\"font-family:'Bebas Neue',sans-serif\">\n                    GARANTIA\n                </h2>\n                <div class=\"jf-pulse mt-4 h-[2px] w-full bg-[#b9f227]\" data-kid=\"1-1-3-2-3\" data-name=\"pulsing horizontal accent line\">\n                </div>\n                <p class=\"mt-4 max-w-[220px] text-[15px] leading-5\" data-kid=\"1-1-3-2-4\" data-name=\"guarantee details text\">\n                    [COBERTURA E PRAZO PENDENTES]\n                </p>\n                <a class=\"absolute bottom-5 left-6 text-[11px] font-bold uppercase tracking-[.16em] text-[#b9f227]\" data-kid=\"1-1-3-2-5\" data-name=\"guarantee call-to-action link\" href=\"#garantia\">\n                    CONHEÇA A GARANTIA\n                    <span class=\"text-base\" data-kid=\"1-1-3-2-5-1\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </aside>\n        </section>\n        <section class=\"relative z-10 mt-5\" data-kid=\"1-1-4\" data-name=\"testimonials section\">\n            <div class=\"mb-3 flex items-end justify-between border-b-2 border-[#101d35] pb-2\" data-kid=\"1-1-4-1\" data-name=\"testimonials header\">\n                <h3 class=\"text-[13px] font-bold uppercase tracking-[.2em]\" data-kid=\"1-1-4-1-1\" data-name=\"testimonials title\">\n                    VOZES A VALIDAR\n                </h3>\n                <span class=\"text-[11px] uppercase tracking-[.16em] text-[#101d35]/60\" data-kid=\"1-1-4-1-2\" data-name=\"testimonials count text\">\n                    3 espaços reservados\n                </span>\n            </div>\n            <div class=\"grid grid-cols-3 gap-4\" data-kid=\"1-1-4-2\" data-name=\"testimonials grid container\">\n                <article class=\"relative min-h-[178px] border-2 border-[#101d35] bg-[#fffdf8] p-5\" data-kid=\"1-1-4-2-1\" data-name=\"first testimonial card\">\n                    <span class=\"absolute right-4 top-3 text-[11px] font-bold\" data-kid=\"1-1-4-2-1-1\" data-name=\"testimonial number label\">\n                        01\n                    </span>\n                    <div class=\"text-[19px] tracking-[.15em] text-[#e64131]\" data-kid=\"1-1-4-2-1-2\" data-name=\"testimonial rating placeholder\">\n                        [NOTA PENDENTE]\n                    </div>\n                    <p class=\"mt-4 max-w-[260px] text-[17px] leading-5\" data-kid=\"1-1-4-2-1-3\" data-name=\"testimonial review quote\">\n                        “[REVIEW APROVADO]”\n                    </p>\n                    <div class=\"absolute bottom-5 left-5 text-[11px] font-bold uppercase tracking-[.12em]\" data-kid=\"1-1-4-2-1-4\" data-name=\"testimonial author credit\">\n                        [NOME / LOCAL PENDENTE]\n                    </div>\n                </article>\n                <article class=\"relative min-h-[178px] border-2 border-[#101d35] bg-[#b9f227] p-5\" data-kid=\"1-1-4-2-2\" data-name=\"second testimonial card\">\n                    <span class=\"absolute right-4 top-3 text-[11px] font-bold\" data-kid=\"1-1-4-2-2-1\" data-name=\"testimonial number label\">\n                        02\n                    </span>\n                    <div class=\"text-[19px] tracking-[.15em]\" data-kid=\"1-1-4-2-2-2\" data-name=\"testimonial rating placeholder\">\n                        [NOTA PENDENTE]\n                    </div>\n                    <p class=\"mt-4 max-w-[260px] text-[17px] leading-5\" data-kid=\"1-1-4-2-2-3\" data-name=\"testimonial review quote\">\n                        “[REVIEW APROVADO]”\n                    </p>\n                    <div class=\"absolute bottom-5 left-5 text-[11px] font-bold uppercase tracking-[.12em]\" data-kid=\"1-1-4-2-2-4\" data-name=\"testimonial author credit\">\n                        [NOME / LOCAL PENDENTE]\n                    </div>\n                </article>\n                <article class=\"relative min-h-[178px] border-2 border-[#101d35] bg-[#e64131] p-5 text-[#fffdf8]\" data-kid=\"1-1-4-2-3\" data-name=\"third testimonial card\">\n                    <span class=\"absolute right-4 top-3 text-[11px] font-bold\" data-kid=\"1-1-4-2-3-1\" data-name=\"testimonial number label\">\n                        03\n                    </span>\n                    <div class=\"text-[19px] tracking-[.15em]\" data-kid=\"1-1-4-2-3-2\" data-name=\"testimonial rating placeholder\">\n                        [NOTA PENDENTE]\n                    </div>\n                    <p class=\"mt-4 max-w-[260px] text-[17px] leading-5\" data-kid=\"1-1-4-2-3-3\" data-name=\"testimonial review quote\">\n                        “[REVIEW APROVADO]”\n                    </p>\n                    <div class=\"absolute bottom-5 left-5 text-[11px] font-bold uppercase tracking-[.12em]\" data-kid=\"1-1-4-2-3-4\" data-name=\"testimonial author credit\">\n                        [NOME / LOCAL PENDENTE]\n                    </div>\n                </article>\n            </div>\n        </section>\n        <footer class=\"relative z-10 mt-auto flex items-center justify-between border-t-2 border-[#101d35] pt-4\" data-kid=\"1-1-5\" data-name=\"footer section\">\n            <div class=\"flex items-center gap-5 text-[12px] font-bold uppercase tracking-[.2em]\" data-kid=\"1-1-5-1\" data-name=\"footer category list\">\n                <span class=\"text-[#e64131]\" data-kid=\"1-1-5-1-1\" data-name=\"footer status label\">\n                    CONFIANÇA EM CONSTRUÇÃO\n                </span>\n                <span class=\"text-[#101d35]/40\" data-kid=\"1-1-5-1-2\" data-name=\"separator slash\">\n                    /\n                </span>\n                <span data-kid=\"1-1-5-1-3\" data-name=\"footer category family\">\n                    FAMÍLIA\n                </span>\n                <span data-kid=\"1-1-5-1-4\" data-name=\"footer category school\">\n                    ESCOLA\n                </span>\n                <span data-kid=\"1-1-5-1-5\" data-name=\"footer category park\">\n                    PARQUE\n                </span>\n                <span data-kid=\"1-1-5-1-6\" data-name=\"footer category gym\">\n                    ACADEMIA\n                </span>\n            </div>\n            <a class=\"border-2 border-[#101d35] px-5 py-3 text-[11px] font-bold uppercase tracking-[.14em] hover:bg-[#101d35] hover:text-[#f2f0eb]\" data-kid=\"1-1-5-2\" data-name=\"footer call-to-action button\" href=\"#garantia\">\n                CONHEÇA A GARANTIA\n                <span class=\"ml-3 text-base\" data-kid=\"1-1-5-2-1\" data-name=\"arrow icon\">\n                    ↗\n                </span>\n            </a>\n        </footer>\n    </div>\n</main>\n",
