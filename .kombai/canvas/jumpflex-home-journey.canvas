    "var_7a47e15710d1": {
      "type": "variant",
      "label": "01 — Hero aprovada em português",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  :root { --red:#da0000; --navy:#17222d; --lime:#a9e52c; --blue:#1677ff; --white:#f8fafc; }\n  .jumpflex-shell { font-family:'Space Grotesk',sans-serif; background:var(--navy); color:var(--white); }\n  .jumpflex-hero { min-height:800px; position:relative; isolation:isolate; overflow:clip; background:#283a39; }\n  .jumpflex-hero::before { content:''; position:absolute; inset:0; z-index:-3; background-image:linear-gradient(180deg,rgba(15,28,30,.42) 0%,rgba(15,28,30,.25) 38%,rgba(15,28,30,.8) 100%),url('https://picsum.photos/seed/jumpflex-family-backyard/1600/1000'); background-size:cover; background-position:center 42%; transform:scale(1.04); }\n  .jumpflex-hero::after { content:''; position:absolute; inset:0; z-index:-2; background:linear-gradient(90deg,rgba(23,34,45,.5),transparent 38%,rgba(23,34,45,.12) 75%,rgba(23,34,45,.38)); pointer-events:none; }\n  .sale-bar { height:42px; background:var(--red); letter-spacing:.08em; }\n  .nav-glass { height:78px; background:rgba(23,34,45,.72); border-bottom:1px solid rgba(248,250,252,.2); backdrop-filter:blur(8px); }\n  .display { font-family:'Bebas Neue',sans-serif; letter-spacing:.018em; }\n  .shadow-blue { box-shadow:6px 6px 0 var(--blue); }\n  .hero-copy { text-shadow:0 5px 18px rgba(0,0,0,.22); }\n  .badge { transform:rotate(8deg); box-shadow:5px 6px 0 var(--red); }\n  .rail-gradient { background:linear-gradient(180deg,rgba(23,34,45,.05),rgba(23,34,45,.82)); }\n  .scroll-cue { writing-mode:vertical-rl; transform:rotate(180deg); }\n  @keyframes pulse-dot { 0%,100% { opacity:.35; transform:scale(.85); } 50% { opacity:1; transform:scale(1); } }\n  .pulse-dot { animation:pulse-dot 1.8s ease-in-out infinite; }\n</style>\n<div class=\"jumpflex-shell min-h-[800px] w-full overflow-clip\" data-kid=\"1\" data-name=\"page layout container\">\n    <main class=\"jumpflex-hero\" data-kid=\"1-1\" data-name=\"hero section container\">\n        <div class=\"sale-bar relative z-20 flex items-center justify-center px-6 text-[10px] font-bold uppercase text-white sm:text-xs\" data-kid=\"1-1-1\" data-name=\"promotional banner bar\">\n            <span class=\"text-[var(--lime)]\" data-kid=\"1-1-1-1\" data-name=\"sale title text\">\n                Labor Day Sale\n            </span>\n            <span class=\"mx-5 h-3 w-px bg-white/60\" data-kid=\"1-1-1-2\" data-name=\"banner separator\">\n            </span>\n            <span class=\"text-white/75\" data-kid=\"1-1-1-3\" data-name=\"offer details placeholder text\">\n                Offer details pending\n            </span>\n            <span class=\"mx-5 h-3 w-px bg-white/60\" data-kid=\"1-1-1-4\" data-name=\"banner separator\">\n            </span>\n            <span class=\"font-mono tracking-[.16em] text-white/85\" data-kid=\"1-1-1-5\" data-name=\"countdown timer text\">\n                00 D 00 H 00 M 00 S\n            </span>\n        </div>\n        <header class=\"nav-glass relative z-20 flex items-center justify-between px-10\" data-kid=\"1-1-2\" data-name=\"navigation header bar\">\n            <a aria-label=\"Jumpflex home\" class=\"display text-3xl tracking-wide\" data-kid=\"1-1-2-1\" data-name=\"site logo link\" href=\"#range\">\n                JUMP\n                <span class=\"text-[var(--lime)]\" data-kid=\"1-1-2-1-1\" data-name=\"logo highlight text\">\n                    FLEX\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"hidden items-center gap-9 text-[11px] font-bold uppercase tracking-[.12em] lg:flex\" data-kid=\"1-1-2-2\" data-name=\"primary navigation menu\">\n                <a class=\"text-white hover:text-[var(--lime)]\" data-kid=\"1-1-2-2-1\" data-name=\"navigation link\" href=\"#range\">\n                    Trampolines\n                </a>\n                <a class=\"text-white/80 hover:text-[var(--lime)]\" data-kid=\"1-1-2-2-2\" data-name=\"navigation link\" href=\"#range\">\n                    Accessories\n                </a>\n                <a class=\"text-white/80 hover:text-[var(--lime)]\" data-kid=\"1-1-2-2-3\" data-name=\"navigation link\" href=\"#support\">\n                    Support\n                </a>\n                <a class=\"text-white/80 hover:text-[var(--lime)]\" data-kid=\"1-1-2-2-4\" data-name=\"navigation link\" href=\"#about\">\n                    About\n                </a>\n                <a class=\"text-white/80 hover:text-[var(--lime)]\" data-kid=\"1-1-2-2-5\" data-name=\"navigation link\" href=\"#bulk\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-5 text-[11px] font-bold uppercase tracking-[.1em]\" data-kid=\"1-1-2-3\" data-name=\"header utilities container\">\n                <span class=\"hidden text-white/90 xl:inline\" data-kid=\"1-1-2-3-1\" data-name=\"phone number text\">\n                    +1 (888) 305 7238\n                </span>\n                <button aria-label=\"Search\" class=\"text-lg text-white/90\" data-kid=\"1-1-2-3-2\" data-name=\"search button\">\n                    ⌕\n                </button>\n                <button aria-label=\"Open menu\" class=\"text-lg text-white/90\" data-kid=\"1-1-2-3-3\" data-name=\"menu toggle button\">\n                    ◌\n                </button>\n            </div>\n        </header>\n        <section class=\"relative z-10 flex h-[548px] flex-col items-center justify-center px-6 text-center\" data-kid=\"1-1-3\" data-name=\"hero content container\">\n            <div class=\"hero-copy flex flex-col items-center\" data-kid=\"1-1-3-1\" data-name=\"hero text content stack\">\n                <p class=\"hero-eyebrow mb-3 flex items-center gap-3 text-[10px] font-bold uppercase tracking-[.28em] text-[var(--lime)]\" data-kid=\"1-1-3-1-1\" data-name=\"hero eyebrow header\">\n                    <span class=\"h-px w-9 bg-[var(--lime)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"decorative line\">\n                    </span>\n                    Family reveal\n                    <span class=\"h-px w-9 bg-[var(--lime)]\" data-kid=\"1-1-3-1-1-2\" data-name=\"decorative line\">\n                    </span>\n                </p>\n                <h1 class=\"hero-title display text-[clamp(5.2rem,11vw,9.5rem)] leading-[.79] text-[var(--white)]\" data-kid=\"1-1-3-1-2\" data-name=\"main hero headline\">\n                    <span class=\"block\" data-kid=\"1-1-3-1-2-1\" data-name=\"headline part one\">\n                        MAIS\n                        <span class=\"text-[var(--lime)]\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"highlighted text\">\n                            ALEGRIA.\n                        </span>\n                    </span>\n                    <span class=\"block\" data-kid=\"1-1-3-1-2-2\" data-name=\"headline part two\">\n                        MAIS AR.\n                    </span>\n                </h1>\n                <p class=\"hero-description mt-7 max-w-[530px] text-sm leading-6 text-white/90\" data-kid=\"1-1-3-1-3\" data-name=\"hero description text\">\n                    Encontre o trampolim certo para transformar o quintal em mais momentos de diversão.\n                </p>\n                <div class=\"hero-actions mt-7 flex flex-wrap items-center justify-center gap-4\" data-kid=\"1-1-3-1-4\" data-name=\"hero call-to-action button group\">\n                    <a class=\"shadow-blue flex h-14 items-center gap-7 bg-[var(--lime)] px-8 text-[11px] font-bold uppercase tracking-[.18em] text-[var(--navy)]\" data-kid=\"1-1-3-1-4-1\" data-name=\"primary action button\" href=\"#range\">\n                        View range\n                        <span class=\"text-lg\" data-kid=\"1-1-3-1-4-1-1\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <a class=\"flex h-14 items-center border border-white/75 bg-black/10 px-7 text-[10px] font-bold uppercase tracking-[.12em] text-white\" data-kid=\"1-1-3-1-4-2\" data-name=\"secondary action button\" href=\"#bulk\">\n                        Buy in quantity\n                        <span class=\"mx-2 text-white/45\" data-kid=\"1-1-3-1-4-2-1\" data-name=\"button text separator\">\n                            /\n                        </span>\n                        Get a bulk quote\n                    </a>\n                </div>\n            </div>\n            <div class=\"badge absolute right-[10%] top-[10%] flex h-28 w-28 items-center justify-center rounded-full border-4 border-[var(--navy)] bg-[var(--lime)] text-center text-[13px] font-black uppercase leading-[.9] text-[var(--navy)] sm:h-32 sm:w-32 sm:text-[15px]\" data-kid=\"1-1-3-2\" data-name=\"promotional badge container\">\n                Labor\n                <br data-kid=\"1-1-3-2-1\" data-name=\"line break\"/>\n                Day\n                <br data-kid=\"1-1-3-2-2\" data-name=\"line break\"/>\n                <span class=\"mt-1 text-[8px] tracking-wider\" data-kid=\"1-1-3-2-3\" data-name=\"offer status text\">\n                    Offer pending\n                </span>\n            </div>\n            <div class=\"absolute bottom-5 left-10 flex items-end gap-3 text-left\" data-kid=\"1-1-3-3\" data-name=\"carousel progress indicator container\">\n                <div data-kid=\"1-1-3-3-1\" data-name=\"pagination progress stack\">\n                    <div class=\"text-[10px] font-bold tracking-[.16em]\" data-kid=\"1-1-3-3-1-1\" data-name=\"current slide index text\">\n                        01 / 07\n                    </div>\n                    <div class=\"mt-3 h-12 w-px bg-[var(--lime)]\" data-kid=\"1-1-3-3-1-2\" data-name=\"progress bar track\">\n                    </div>\n                    <div class=\"mt-3 text-[9px] uppercase tracking-[.18em] text-white/70\" data-kid=\"1-1-3-3-1-3\" data-name=\"explore label text\">\n                        Explore\n                    </div>\n                </div>\n            </div>\n            <div class=\"absolute bottom-6 right-10 text-right font-mono text-[9px] uppercase tracking-[.16em] text-white/70\" data-kid=\"1-1-3-4\" data-name=\"footer metadata stack\">\n                <span class=\"text-white\" data-kid=\"1-1-3-4-1\" data-name=\"metadata label text\">\n                    COUNTDOWN\n                </span>\n                <br data-kid=\"1-1-3-4-2\" data-name=\"line break\"/>\n                <span data-kid=\"1-1-3-4-3\" data-name=\"official content status text\">\n                    CONTEÚDO OFICIAL PENDENTE\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Jumpflex range\" class=\"rail-gradient absolute inset-x-0 bottom-0 z-10 border-t border-white/25\" data-kid=\"1-1-4\" data-name=\"product category rail section\" id=\"range\">\n            <div class=\"flex h-[132px] divide-x divide-white/20\" data-kid=\"1-1-4-1\" data-name=\"category link grid\">\n                <a class=\"group flex flex-1 flex-col justify-center px-10 hover:bg-white/5\" data-kid=\"1-1-4-1-1\" data-name=\"category link\" href=\"#flex\">\n                    <div class=\"flex items-end justify-between\" data-kid=\"1-1-4-1-1-1\" data-name=\"link inner content\">\n                        <div data-kid=\"1-1-4-1-1-1-1\" data-name=\"category title\">\n                            <h2 class=\"display text-5xl leading-none text-[var(--lime)]\" data-kid=\"1-1-4-1-1-1-1-1\" data-name=\"category name text\">\n                                FLEX™\n                            </h2>\n                            <p class=\"mt-2 text-[9px] font-bold uppercase tracking-[.15em] text-white/85\" data-kid=\"1-1-4-1-1-1-1-2\" data-name=\"category description text\">\n                                Everyday play\n                            </p>\n                        </div>\n                        <span class=\"text-[9px] font-bold uppercase tracking-wider text-white/65\" data-kid=\"1-1-4-1-1-1-2\" data-name=\"link action label\">\n                            View range ↗\n                        </span>\n                    </div>\n                </a>\n                <a class=\"group flex flex-1 flex-col justify-center px-10 hover:bg-white/5\" data-kid=\"1-1-4-1-2\" data-name=\"category link\" href=\"#hero\">\n                    <div class=\"flex items-end justify-between\" data-kid=\"1-1-4-1-2-1\" data-name=\"link inner content\">\n                        <div data-kid=\"1-1-4-1-2-1-1\" data-name=\"category title\">\n                            <h2 class=\"display text-5xl leading-none\" data-kid=\"1-1-4-1-2-1-1-1\" data-name=\"category name text\">\n                                HERO™\n                            </h2>\n                            <p class=\"mt-2 text-[9px] font-bold uppercase tracking-[.15em] text-white/85\" data-kid=\"1-1-4-1-2-1-1-2\" data-name=\"category description text\">\n                                More air. More fun.\n                            </p>\n                        </div>\n                        <span class=\"text-[9px] font-bold uppercase tracking-wider text-white/65\" data-kid=\"1-1-4-1-2-1-2\" data-name=\"link action label\">\n                            View range ↗\n                        </span>\n                    </div>\n                </a>\n                <a class=\"group flex flex-1 flex-col justify-center px-10 hover:bg-white/5\" data-kid=\"1-1-4-1-3\" data-name=\"category link\" href=\"#mega\">\n                    <div class=\"flex items-end justify-between\" data-kid=\"1-1-4-1-3-1\" data-name=\"link inner content\">\n                        <div data-kid=\"1-1-4-1-3-1-1\" data-name=\"category title\">\n                            <h2 class=\"display text-5xl leading-none\" data-kid=\"1-1-4-1-3-1-1-1\" data-name=\"category name text\">\n                                MEGA™\n                            </h2>\n                            <p class=\"mt-2 text-[9px] font-bold uppercase tracking-[.15em] text-white/85\" data-kid=\"1-1-4-1-3-1-1-2\" data-name=\"category description text\">\n                                The biggest days\n                            </p>\n                        </div>\n                        <span class=\"text-[9px] font-bold uppercase tracking-wider text-white/65\" data-kid=\"1-1-4-1-3-1-2\" data-name=\"link action label\">\n                            View range ↗\n                        </span>\n                    </div>\n                </a>\n            </div>\n        </section>\n        <div class=\"scroll-cue absolute bottom-7 right-3 z-20 hidden items-center gap-3 text-[9px] font-bold uppercase tracking-[.2em] text-white/80 xl:flex\" data-kid=\"1-1-5\" data-name=\"scroll cue container\">\n            <span class=\"pulse-dot h-2 w-2 rounded-full bg-[var(--lime)]\" data-kid=\"1-1-5-1\" data-name=\"pulse icon\">\n            </span>\n            Role para encontrar seu trampolim\n        </div>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger); gsap.from('.hero-eyebrow, .hero-title, .hero-description, .hero-actions',{y:28,opacity:0,duration:.8,stagger:.09,ease:'power3.out'}); gsap.from('.badge',{scale:.55,rotation:-12,opacity:0,duration:.7,delay:.25,ease:'back.out(1.7)'}); gsap.from('.rail-gradient a',{y:22,opacity:0,duration:.65,stagger:.1,delay:.4,ease:'power2.out'});\n</script>\n",
