      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n.jumpflex-page{font-family:'Space Grotesk',sans-serif;background:#17222d;color:#fff;}\n.jumpflex-display{font-family:'Bebas Neue',sans-serif;}\n.jumpflex-media{transform:scale(1.08) translate3d(0,-22px,0);}\n.jumpflex-panel{box-shadow:inset 0 3px 0 #a9e52c;}\n.jumpflex-panel-blue{box-shadow:inset 0 3px 0 #1677ff;}\n.jumpflex-panel-red{box-shadow:inset 0 3px 0 #da0000;}\n.jumpflex-cta{box-shadow:5px 5px 0 #1677ff;}\n.jumpflex-caption{bottom:16px!important;}\n</style>\n<div class=\"jumpflex-page relative h-[800px] w-[1280px] overflow-clip antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"absolute inset-0 bg-[#17222d]\" data-kid=\"1-1\" data-name=\"background layer\">\n    </div>\n    <div class=\"jumpflex-media absolute -inset-10 bg-[url('https://picsum.photos/1400/980.webp?blur=1')] bg-cover bg-center opacity-65\" data-kid=\"1-2\" data-name=\"parallax background image\">\n    </div>\n    <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(23,34,45,.96)_0%,rgba(23,34,45,.60)_42%,rgba(23,34,45,.82)_100%)]\" data-kid=\"1-3\" data-name=\"horizontal gradient overlay\">\n    </div>\n    <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(23,34,45,.35)_0%,transparent_35%,rgba(23,34,45,.95)_100%)]\" data-kid=\"1-4\" data-name=\"vertical gradient overlay\">\n    </div>\n    <div class=\"absolute right-[-105px] top-[250px] h-[390px] w-[390px] rotate-12 border border-[#a9e52c]/25\" data-kid=\"1-5\" data-name=\"decorative border frame\">\n    </div>\n    <div class=\"absolute left-[42px] top-[166px] h-[1px] w-[190px] bg-[#a9e52c]/60\" data-kid=\"1-6\" data-name=\"decorative line accent\">\n    </div>\n    <div class=\"relative z-10 flex h-full flex-col\" data-kid=\"1-7\" data-name=\"main content stack\">\n        <div class=\"flex h-10 shrink-0 items-center justify-center bg-[#da0000] px-10 text-[10px] font-bold tracking-[.22em] text-white\" data-kid=\"1-7-1\" data-name=\"top banner information bar\">\n            JUMPFLEX · HOME EVOLUTION\n            <span class=\"mx-4 text-white/45\" data-kid=\"1-7-1-1\" data-name=\"separator slash icon\">\n                /\n            </span>\n            TRANSIÇÃO DE SCROLL\n        </div>\n        <header class=\"flex h-[78px] shrink-0 items-center justify-between border-b border-white/20 bg-[#17222d]/70 px-10\" data-kid=\"1-7-2\" data-name=\"main header navigation\">\n            <div class=\"text-[25px] font-bold leading-none tracking-[-.09em]\" data-kid=\"1-7-2-1\" data-name=\"brand logo text\">\n                JUMP\n                <span class=\"text-[#a9e52c]\" data-kid=\"1-7-2-1-1\" data-name=\"brand name secondary part\">\n                    FLEX\n                </span>\n            </div>\n            <nav class=\"flex items-center gap-8 text-[11px] font-bold tracking-[.15em] text-white/75\" data-kid=\"1-7-2-2\" data-name=\"navigation link group\">\n                <span data-kid=\"1-7-2-2-1\" data-name=\"trampolines link\">\n                    TRAMPOLINS\n                </span>\n                <span data-kid=\"1-7-2-2-2\" data-name=\"accessories link\">\n                    ACESSÓRIOS\n                </span>\n                <span data-kid=\"1-7-2-2-3\" data-name=\"support link\">\n                    SUPORTE\n                </span>\n                <span data-kid=\"1-7-2-2-4\" data-name=\"about link\">\n                    SOBRE\n                </span>\n                <span data-kid=\"1-7-2-2-5\" data-name=\"contact link\">\n                    CONTATO\n                </span>\n            </nav>\n            <div class=\"flex items-center gap-4 text-[11px] font-semibold text-white/70\" data-kid=\"1-7-2-3\" data-name=\"utility control group\">\n                <span data-kid=\"1-7-2-3-1\" data-name=\"phone number display\">\n                    +1 (886) 305 7238\n                </span>\n                <span class=\"text-[#a9e52c]\" data-kid=\"1-7-2-3-2\" data-name=\"search icon\">\n                    ⌕\n                </span>\n                <span data-kid=\"1-7-2-3-3\" data-name=\"user profile icon\">\n                    ◌\n                </span>\n            </div>\n        </header>\n        <main class=\"relative flex flex-1 items-center justify-center pb-[112px] text-center\" data-kid=\"1-7-3\" data-name=\"hero content area\">\n            <div class=\"absolute left-[48px] top-[72px] flex h-[224px] flex-col items-center\" data-kid=\"1-7-3-1\" data-name=\"scroll progress indicator\">\n                <span class=\"text-[10px] font-bold tracking-[.25em] text-white/80\" data-kid=\"1-7-3-1-1\" data-name=\"progress step count\">\n                    02 / 07\n                </span>\n                <div class=\"relative mt-4 h-[132px] w-px bg-white/35\" data-kid=\"1-7-3-1-2\" data-name=\"progress track container\">\n                    <div class=\"absolute left-0 top-0 h-[72px] w-[2px] bg-[#a9e52c]\" data-kid=\"1-7-3-1-2-1\" data-name=\"progress bar fill\">\n                    </div>\n                    <div class=\"absolute -left-[3px] top-[68px] h-[7px] w-[7px] bg-[#a9e52c]\" data-kid=\"1-7-3-1-2-2\" data-name=\"progress indicator knob\">\n                    </div>\n                </div>\n                <span class=\"mt-4 rotate-[-90deg] whitespace-nowrap text-[9px] font-bold tracking-[.2em] text-white/70\" data-kid=\"1-7-3-1-3\" data-name=\"vertical instruction label\">\n                    ROLE PARA COMPARAR\n                </span>\n            </div>\n            <div class=\"absolute right-[54px] top-[66px] text-right text-[9px] font-bold uppercase tracking-[.2em] text-white/55\" data-dynamic=\"true\" data-kid=\"1-7-3-2\" data-name=\"scroll telemetry status\" data-reason=\"text replaced by scroll progress state\">\n                <span class=\"text-[#1677ff]\" data-dynamic=\"true\" data-kid=\"1-7-3-2-1\" data-name=\"scroll percentage display\" data-reason=\"text updated based on current scroll position\">\n                    SCROLL STATE · 48%\n                </span>\n                <br data-kid=\"1-7-3-2-2\" data-name=\"line break\"/>\n                headline recuando\n                <br data-kid=\"1-7-3-2-3\" data-name=\"line break\"/>\n                mídia em parallax\n            </div>\n            <div class=\"relative -mt-6 max-w-[720px]\" data-kid=\"1-7-3-3\" data-name=\"hero text and button group\">\n                <div class=\"mb-3 text-[11px] font-bold tracking-[.32em] text-[#a9e52c]\" data-kid=\"1-7-3-3-1\" data-name=\"product section tag\">\n                    PRÓXIMO · RAIL DE PRODUTOS\n                </div>\n                <h1 class=\"jumpflex-display translate-y-[-18px] scale-[.88] text-[118px] leading-[.78] tracking-wide text-white/90\" data-kid=\"1-7-3-3-2\" data-name=\"hero headline text\">\n                    <span class=\"block\" data-kid=\"1-7-3-3-2-1\" data-name=\"headline first row\">\n                        MAIS\n                        <em class=\"not-italic text-[#a9e52c]\" data-kid=\"1-7-3-3-2-1-1\" data-name=\"emphasized headline word\">\n                            ALEGRIA.\n                        </em>\n                    </span>\n                    <span class=\"block\" data-kid=\"1-7-3-3-2-2\" data-name=\"headline second row\">\n                        MAIS AR.\n                    </span>\n                </h1>\n                <p class=\"mt-5 text-[14px] text-white/75\" data-kid=\"1-7-3-3-3\" data-name=\"hero description text\">\n                    Compare as linhas Jumpflex e encontre a que combina com seu espaço.\n                </p>\n                <div class=\"mt-7 flex justify-center gap-3\" data-kid=\"1-7-3-3-4\" data-name=\"call-to-action button group\">\n                    <a class=\"jumpflex-cta inline-flex h-[54px] items-center bg-[#a9e52c] px-8 text-[11px] font-bold tracking-[.16em] text-[#17222d]\" data-kid=\"1-7-3-3-4-1\" data-name=\"primary action button\" href=\"#produtos\">\n                        VER LINHAS\n                        <span class=\"ml-3 text-base\" data-kid=\"1-7-3-3-4-1-1\" data-name=\"arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <a class=\"inline-flex h-[54px] items-center border border-white/50 px-6 text-[10px] font-bold tracking-[.13em] text-white\" data-kid=\"1-7-3-3-4-2\" data-name=\"secondary action button\" href=\"#cotacao\">\n                        COTAÇÃO EM VOLUME\n                        <span class=\"mx-2 text-white/40\" data-kid=\"1-7-3-3-4-2-1\" data-name=\"separator slash\">\n                            /\n                        </span>\n                        B2B\n                    </a>\n                </div>\n            </div>\n        </main>\n        <section class=\"relative z-20 flex h-[142px] shrink-0 border-t border-white/30 bg-[#17222d]/95\" data-kid=\"1-7-4\" data-name=\"product rail navigation\" id=\"produtos\">\n            <div class=\"flex w-[190px] shrink-0 flex-col justify-center border-r border-white/20 px-10\" data-kid=\"1-7-4-1\" data-name=\"rail entry container\">\n                <div class=\"mb-3 flex items-center gap-3\" data-kid=\"1-7-4-1-1\" data-name=\"rail status label container\">\n                    <span class=\"h-2 w-2 bg-[#a9e52c]\" data-kid=\"1-7-4-1-1-1\" data-name=\"status dot icon\">\n                    </span>\n                    <span class=\"text-[10px] font-bold tracking-[.23em] text-white/65\" data-kid=\"1-7-4-1-1-2\" data-name=\"entry label text\">\n                        ENTRADA DO RAIL\n                    </span>\n                </div>\n                <span class=\"text-[9px] font-bold tracking-[.16em] text-white/55\" data-kid=\"1-7-4-1-2\" data-name=\"scroll hint text\">\n                    ARRASTE PARA EXPLORAR\n                </span>\n                <div class=\"mt-3 h-[2px] w-[80px] bg-[#1677ff]\" data-kid=\"1-7-4-1-3\" data-name=\"active indicator bar\">\n                </div>\n            </div>\n            <a class=\"jumpflex-panel flex flex-1 flex-col justify-center border-r border-white/20 px-8 text-left\" data-kid=\"1-7-4-2\" data-name=\"flex product card\" href=\"#flex\">\n                <span class=\"text-[10px] font-bold tracking-[.2em] text-[#a9e52c]\" data-kid=\"1-7-4-2-1\" data-name=\"product index label\">\n                    01 · LINHA\n                </span>\n                <div class=\"jumpflex-display mt-1 text-[45px] leading-none text-[#a9e52c]\" data-kid=\"1-7-4-2-2\" data-name=\"product name\">\n                    FLEX™\n                </div>\n                <span class=\"mt-2 text-[9px] font-bold tracking-[.16em] text-white/75\" data-kid=\"1-7-4-2-3\" data-name=\"product description\">\n                    PARA O USO DIÁRIO\n                </span>\n            </a>\n            <a class=\"jumpflex-panel-blue flex flex-1 flex-col justify-center border-r border-white/20 px-8 text-left\" data-kid=\"1-7-4-3\" data-name=\"hero product card\" href=\"#hero\">\n                <span class=\"text-[10px] font-bold tracking-[.2em] text-[#1677ff]\" data-kid=\"1-7-4-3-1\" data-name=\"product index label\">\n                    02 · LINHA\n                </span>\n                <div class=\"jumpflex-display mt-1 text-[45px] leading-none\" data-kid=\"1-7-4-3-2\" data-name=\"product name\">\n                    HERO™\n                </div>\n                <span class=\"mt-2 text-[9px] font-bold tracking-[.16em] text-white/75\" data-kid=\"1-7-4-3-3\" data-name=\"product description\">\n                    MAIS AR. MAIS DIVERSÃO.\n                </span>\n            </a>\n            <a class=\"jumpflex-panel-red flex flex-1 flex-col justify-center px-8 text-left\" data-kid=\"1-7-4-4\" data-name=\"mega product card\" href=\"#mega\">\n                <span class=\"text-[10px] font-bold tracking-[.2em] text-[#da0000]\" data-kid=\"1-7-4-4-1\" data-name=\"product index label\">\n                    03 · LINHA\n                </span>\n                <div class=\"jumpflex-display mt-1 text-[45px] leading-none\" data-kid=\"1-7-4-4-2\" data-name=\"product name\">\n                    MEGA™\n                </div>\n                <span class=\"mt-2 text-[9px] font-bold tracking-[.16em] text-white/75\" data-kid=\"1-7-4-4-3\" data-name=\"product description\">\n                    PARA GRANDES MOMENTOS\n                </span>\n            </a>\n            <div class=\"jumpflex-caption absolute right-[31px] text-[9px] tracking-[.08em] text-white/45\" data-kid=\"1-7-4-5\" data-name=\"caption notification text\">\n                transição reversível · sem bloquear compra\n            </div>\n        </section>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n",
