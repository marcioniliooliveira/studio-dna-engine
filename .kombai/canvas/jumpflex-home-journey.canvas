    "var_8440816dee7e": {
      "type": "variant",
      "label": "07 — FAQ e footer",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n:root{--jf-off:#f4f1ea;--jf-navy:#071a2b;--jf-lime:#b8ef22;--jf-blue:#3478ff;--jf-red:#ef1720}\n.jf-faq details summary{list-style:none}.jf-faq details summary::-webkit-details-marker{display:none}.jf-faq details[open] .jf-plus{transform:rotate(45deg)}\n.jf-faq details[open] .jf-answer{display:block}\n</style>\n<div class=\"jf-page flex min-h-[800px] w-full flex-col overflow-x-clip bg-[var(--jf-off)] font-['Space_Grotesk'] text-[var(--jf-navy)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <main class=\"jf-faq flex-1 px-[64px] pt-[36px] pb-[30px]\" data-kid=\"1-1\" data-name=\"faq section\">\n        <div class=\"flex items-start justify-between border-b-2 border-[var(--jf-navy)] pb-[22px]\" data-kid=\"1-1-1\" data-name=\"faq header row\">\n            <div class=\"flex items-start gap-7\" data-kid=\"1-1-1-1\" data-name=\"faq title group\">\n                <div class=\"pt-1 text-[11px] font-bold tracking-[0.22em] text-[var(--jf-blue)]\" data-kid=\"1-1-1-1-1\" data-name=\"faq step counter\">\n                    07 / 07\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"faq title text container\">\n                    <div class=\"mb-2 flex items-center gap-3 text-[10px] font-bold tracking-[0.22em] text-[var(--jf-navy)]/55\" data-kid=\"1-1-1-1-2-1\" data-name=\"faq category tag\">\n                        <span class=\"h-[7px] w-[7px] bg-[var(--jf-lime)]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"lime decorative square icon\">\n                        </span>\n                        FAQ / JUMPFLEX\n                    </div>\n                    <h1 class=\"max-w-[890px] font-['Bebas_Neue'] text-[52px] leading-[.88] tracking-[.025em]\" data-kid=\"1-1-1-1-2-2\" data-name=\"faq main headline\">\n                        TUDO O QUE VOCÊ PRECISA SABER\n                        <br data-kid=\"1-1-1-1-2-2-1\"/>\n                        ANTES DO PRIMEIRO\n                        <span class=\"text-[var(--jf-blue)]\" data-kid=\"1-1-1-1-2-2-2\" data-name=\"headline accent word\">\n                            SALTO\n                        </span>\n                    </h1>\n                </div>\n            </div>\n            <div class=\"mt-1 border border-[var(--jf-navy)] px-3 py-2 text-right text-[9px] font-bold uppercase leading-[1.25] tracking-[.11em]\" data-kid=\"1-1-1-2\" data-name=\"disclaimer text box\">\n                Conteúdo final\n                <br data-kid=\"1-1-1-2-1\"/>\n                sujeito à aprovação\n            </div>\n        </div>\n        <div class=\"mt-[22px] grid grid-cols-[238px_1fr] gap-[34px]\" data-kid=\"1-1-2\" data-name=\"faq content grid\">\n            <aside class=\"border-l-[5px] border-[var(--jf-lime)] pl-4\" data-kid=\"1-1-2-1\" data-name=\"faq sidebar\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[.18em] text-[var(--jf-blue)]\" data-kid=\"1-1-2-1-1\" data-name=\"sidebar category label\">\n                    Antes de decolar\n                </p>\n                <p class=\"mt-3 max-w-[180px] text-[13px] leading-[1.45]\" data-kid=\"1-1-2-1-2\" data-name=\"sidebar instructional text\">\n                    Respostas rápidas para ajudar você a escolher o salto certo.\n                </p>\n                <div class=\"mt-7 flex items-center gap-2 text-[10px] font-bold tracking-[.13em]\" data-kid=\"1-1-2-1-3\" data-name=\"scroll hint indicator\">\n                    <span class=\"inline-block h-[2px] w-8 bg-[var(--jf-navy)]\" data-kid=\"1-1-2-1-3-1\" data-name=\"scroll hint line\">\n                    </span>\n                    ROLE PARA EXPLORAR\n                </div>\n            </aside>\n            <div class=\"grid grid-cols-2 gap-x-8 gap-y-0 border-t-2 border-[var(--jf-navy)]\" data-kid=\"1-1-2-2\" data-name=\"faq questions list\">\n                <details class=\"border-b border-[var(--jf-navy)]/25 py-[10px]\" data-kid=\"1-1-2-2-1\" data-name=\"faq item 1\" open=\"\">\n                    <summary class=\"flex cursor-pointer items-center justify-between text-[12px] font-bold\" data-kid=\"1-1-2-2-1-1\" data-name=\"faq question 1 summary\">\n                        <span data-kid=\"1-1-2-2-1-1-1\" data-name=\"faq question 1 text\">\n                            Qual linha combina com meu espaço?\n                        </span>\n                        <span class=\"jf-plus text-[21px] font-normal leading-none\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"plus icon 1\">\n                            ＋\n                        </span>\n                    </summary>\n                    <p class=\"jf-answer mt-1 text-[10px] font-medium tracking-[.02em] text-[var(--jf-navy)]/55\" data-kid=\"1-1-2-2-1-2\" data-name=\"faq answer 1 text\">\n                        [RESPOSTA OFICIAL PENDENTE]\n                    </p>\n                </details>\n                <details class=\"border-b border-[var(--jf-navy)]/25 py-[10px]\" data-kid=\"1-1-2-2-2\" data-name=\"faq item 2\" open=\"\">\n                    <summary class=\"flex cursor-pointer items-center justify-between text-[12px] font-bold\" data-kid=\"1-1-2-2-2-1\" data-name=\"faq question 2 summary\">\n                        <span data-kid=\"1-1-2-2-2-1-1\" data-name=\"faq question 2 text\">\n                            Como funciona a montagem?\n                        </span>\n                        <span class=\"jf-plus text-[21px] font-normal leading-none\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"plus icon 2\">\n                            ＋\n                        </span>\n                    </summary>\n                    <p class=\"jf-answer mt-1 text-[10px] font-medium tracking-[.02em] text-[var(--jf-navy)]/55\" data-kid=\"1-1-2-2-2-2\" data-name=\"faq answer 2 text\">\n                        [RESPOSTA OFICIAL PENDENTE]\n                    </p>\n                </details>\n                <details class=\"border-b border-[var(--jf-navy)]/25 py-[10px]\" data-kid=\"1-1-2-2-3\" data-name=\"faq item 3\" open=\"\">\n                    <summary class=\"flex cursor-pointer items-center justify-between text-[12px] font-bold\" data-kid=\"1-1-2-2-3-1\" data-name=\"faq question 3 summary\">\n                        <span data-kid=\"1-1-2-2-3-1-1\" data-name=\"faq question 3 text\">\n                            Como é a entrega?\n                        </span>\n                        <span class=\"jf-plus text-[21px] font-normal leading-none\" data-kid=\"1-1-2-2-3-1-2\" data-name=\"plus icon 3\">\n                            ＋\n                        </span>\n                    </summary>\n                    <p class=\"jf-answer mt-1 text-[10px] font-medium tracking-[.02em] text-[var(--jf-navy)]/55\" data-kid=\"1-1-2-2-3-2\" data-name=\"faq answer 3 text\">\n                        [RESPOSTA OFICIAL PENDENTE]\n                    </p>\n                </details>\n                <details class=\"border-b border-[var(--jf-navy)]/25 py-[10px]\" data-kid=\"1-1-2-2-4\" data-name=\"faq item 4\" open=\"\">\n                    <summary class=\"flex cursor-pointer items-center justify-between text-[12px] font-bold\" data-kid=\"1-1-2-2-4-1\" data-name=\"faq question 4 summary\">\n                        <span data-kid=\"1-1-2-2-4-1-1\" data-name=\"faq question 4 text\">\n                            O que a garantia cobre?\n                        </span>\n                        <span class=\"jf-plus text-[21px] font-normal leading-none\" data-kid=\"1-1-2-2-4-1-2\" data-name=\"plus icon 4\">\n                            ＋\n                        </span>\n                    </summary>\n                    <p class=\"jf-answer mt-1 text-[10px] font-medium tracking-[.02em] text-[var(--jf-navy)]/55\" data-kid=\"1-1-2-2-4-2\" data-name=\"faq answer 4 text\">\n                        [RESPOSTA OFICIAL PENDENTE]\n                    </p>\n                </details>\n                <details class=\"border-b border-[var(--jf-navy)]/25 py-[10px]\" data-kid=\"1-1-2-2-5\" data-name=\"faq item 5\" open=\"\">\n                    <summary class=\"flex cursor-pointer items-center justify-between text-[12px] font-bold\" data-kid=\"1-1-2-2-5-1\" data-name=\"faq question 5 summary\">\n                        <span data-kid=\"1-1-2-2-5-1-1\" data-name=\"faq question 5 text\">\n                            Quais opções de pagamento existem?\n                        </span>\n                        <span class=\"jf-plus text-[21px] font-normal leading-none\" data-kid=\"1-1-2-2-5-1-2\" data-name=\"plus icon 5\">\n                            ＋\n                        </span>\n                    </summary>\n                    <p class=\"jf-answer mt-1 text-[10px] font-medium tracking-[.02em] text-[var(--jf-navy)]/55\" data-kid=\"1-1-2-2-5-2\" data-name=\"faq answer 5 text\">\n                        [RESPOSTA OFICIAL PENDENTE]\n                    </p>\n                </details>\n                <details class=\"border-b border-[var(--jf-navy)]/25 py-[10px]\" data-kid=\"1-1-2-2-6\" data-name=\"faq item 6\" open=\"\">\n                    <summary class=\"flex cursor-pointer items-center justify-between text-[12px] font-bold\" data-kid=\"1-1-2-2-6-1\" data-name=\"faq question 6 summary\">\n                        <span data-kid=\"1-1-2-2-6-1-1\" data-name=\"faq question 6 text\">\n                            Como comprar em quantidade?\n                        </span>\n                        <span class=\"jf-plus text-[21px] font-normal leading-none\" data-kid=\"1-1-2-2-6-1-2\" data-name=\"plus icon 6\">\n                            ＋\n                        </span>\n                    </summary>\n                    <p class=\"jf-answer mt-1 text-[10px] font-medium tracking-[.02em] text-[var(--jf-navy)]/55\" data-kid=\"1-1-2-2-6-2\" data-name=\"faq answer 6 text\">\n                        [RESPOSTA OFICIAL PENDENTE]\n                    </p>\n                </details>\n            </div>\n        </div>\n    </main>\n    <footer class=\"relative bg-[var(--jf-navy)] px-[64px] pt-[26px] pb-[28px] text-[var(--jf-off)]\" data-kid=\"1-2\" data-name=\"footer container\">\n        <div class=\"absolute bottom-0 left-0 h-[9px] w-full bg-[var(--jf-lime)]\" data-kid=\"1-2-1\" data-name=\"footer decorative border bar\">\n        </div>\n        <div class=\"flex items-end justify-between border-y border-[var(--jf-off)]/25 py-[21px]\" data-kid=\"1-2-2\" data-name=\"footer call to action row\">\n            <div data-kid=\"1-2-2-1\" data-name=\"footer brand tag group\">\n                <p class=\"mb-1 text-[10px] font-bold tracking-[.2em] text-[var(--jf-off)]/55\" data-kid=\"1-2-2-1-1\" data-name=\"footer pre-headline text\">\n                    A PRÓXIMA AVENTURA COMEÇA AQUI\n                </p>\n                <h2 class=\"font-['Bebas_Neue'] text-[47px] leading-[.84] tracking-wide\" data-kid=\"1-2-2-1-2\" data-name=\"footer headline\">\n                    MAIS JOY.\n                    <br data-kid=\"1-2-2-1-2-1\"/>\n                    <span class=\"text-[var(--jf-lime)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"footer headline accent\">\n                        MAIS AIR.\n                    </span>\n                </h2>\n            </div>\n            <div class=\"flex gap-3 pb-1\" data-kid=\"1-2-2-2\" data-name=\"footer cta button group\">\n                <a class=\"bg-[var(--jf-lime)] px-6 py-4 text-[11px] font-bold tracking-[.14em] text-[var(--jf-navy)]\" data-kid=\"1-2-2-2-1\" data-name=\"view range button\" href=\"#range\">\n                    VIEW RANGE\n                    <span class=\"ml-2 text-[16px]\" data-kid=\"1-2-2-2-1-1\" data-name=\"view range button arrow\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"border border-[var(--jf-off)]/60 px-6 py-4 text-[11px] font-bold tracking-[.14em]\" data-kid=\"1-2-2-2-2\" data-name=\"bulk quote button\" href=\"#quote\">\n                    GET A BULK QUOTE\n                    <span class=\"ml-2 text-[16px]\" data-kid=\"1-2-2-2-2-1\" data-name=\"bulk quote button arrow\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n        </div>\n        <div class=\"flex items-end justify-between pt-[22px]\" data-kid=\"1-2-3\" data-name=\"footer utility row\">\n            <div data-kid=\"1-2-3-1\" data-name=\"footer logo section\">\n                <div class=\"font-['Bebas_Neue'] text-[39px] leading-none tracking-wide\" data-kid=\"1-2-3-1-1\" data-name=\"footer brand name\">\n                    JUMP\n                    <span class=\"text-[var(--jf-lime)]\" data-kid=\"1-2-3-1-1-1\" data-name=\"footer brand name accent\">\n                        FLEX\n                    </span>\n                    <sup class=\"ml-1 align-top font-['Space_Grotesk'] text-[8px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"trademark symbol\">\n                        ™\n                    </sup>\n                </div>\n                <p class=\"mt-2 text-[9px] font-bold tracking-[.18em] text-[var(--jf-off)]/45\" data-kid=\"1-2-3-1-2\" data-name=\"footer brand tagline\">\n                    JUMP INTO MORE\n                </p>\n            </div>\n            <nav aria-label=\"Footer\" class=\"flex gap-8 text-[10px] font-bold tracking-[.14em]\" data-kid=\"1-2-3-2\" data-name=\"footer navigation menu\">\n                <a data-kid=\"1-2-3-2-1\" data-name=\"trampolines nav link\" href=\"#trampolines\">\n                    TRAMPOLINES\n                </a>\n                <a data-kid=\"1-2-3-2-2\" data-name=\"accessories nav link\" href=\"#accessories\">\n                    ACCESSORIES\n                </a>\n                <a data-kid=\"1-2-3-2-3\" data-name=\"support nav link\" href=\"#support\">\n                    SUPPORT\n                </a>\n                <a data-kid=\"1-2-3-2-4\" data-name=\"about nav link\" href=\"#about\">\n                    ABOUT\n                </a>\n                <a data-kid=\"1-2-3-2-5\" data-name=\"contact nav link\" href=\"#contact\">\n                    CONTACT\n                </a>\n            </nav>\n            <div class=\"text-right text-[9px] font-bold tracking-[.12em] text-[var(--jf-off)]/45\" data-kid=\"1-2-3-3\" data-name=\"footer copyright info\">\n                07 / 07\n                <br data-kid=\"1-2-3-3-1\"/>\n                © JUMPFLEX\n            </div>\n        </div>\n    </footer>\n</div>\n",
