    "var_64e488c7896b": {
      "type": "variant",
      "label": "06 — Entrada B2B e cotação",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6900,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Mono:wght@400;500&family=Manrope:wght@500;600;700;800&display=swap');\n</style>\n<main class=\"min-h-[800px] overflow-clip bg-[#07151f] font-[Manrope] text-white\" data-kid=\"1\" data-name=\"page layout container\">\n    <section class=\"relative min-h-[800px] px-10 py-7 md:px-14\" data-kid=\"1-1\" data-name=\"hero section container\">\n        <div class=\"pointer-events-none absolute right-0 top-0 h-full w-[58%] bg-[#b5f229]\" data-kid=\"1-1-1\" data-name=\"decorative green background shape\" style=\"clip-path:polygon(27% 0,100% 0,100% 100%,8% 100%,16% 76%,4% 52%,13% 29%,0 15%)\">\n        </div>\n        <div class=\"pointer-events-none absolute right-0 top-0 h-full w-[45%] bg-[#3976ff]/85\" data-kid=\"1-1-2\" data-name=\"decorative blue background shape\" style=\"clip-path:polygon(48% 0,100% 0,100% 100%,39% 100%,48% 76%,35% 52%,46% 29%,28% 15%)\">\n        </div>\n        <div class=\"pointer-events-none absolute right-0 top-0 h-full w-[37%] bg-[#b5f229]\" data-kid=\"1-1-3\" data-name=\"decorative green background shape\" style=\"clip-path:polygon(28% 0,100% 0,100% 100%,0 100%,10% 76%,0 52%,10% 29%,0 15%)\">\n        </div>\n        <div class=\"pointer-events-none absolute bottom-0 right-0 top-0 w-[5%] bg-[#3976ff]\" data-kid=\"1-1-4\" data-name=\"decorative blue vertical strip\" style=\"clip-path:polygon(35% 0,100% 0,100% 100%,0 100%,35% 76%,15% 52%,35% 29%,0 15%)\">\n        </div>\n        <header class=\"relative z-10 flex items-center justify-between border-b border-white/15 pb-5\" data-kid=\"1-1-5\" data-name=\"site header bar\">\n            <div class=\"font-[Barlow_Condensed] text-[26px] font-black tracking-[-.04em]\" data-kid=\"1-1-5-1\" data-name=\"brand logo text\">\n                JUMP\n                <span class=\"text-[#b5f229]\" data-kid=\"1-1-5-1-1\" data-name=\"brand highlight text\">\n                    FLEX\n                </span>\n            </div>\n            <div class=\"hidden items-center gap-9 text-[10px] font-bold tracking-[.16em] text-white/70 md:flex\" data-kid=\"1-1-5-2\" data-name=\"main navigation menu\">\n                <span data-kid=\"1-1-5-2-1\" data-name=\"navigation link 1\">\n                    TRAMPOLINS\n                </span>\n                <span data-kid=\"1-1-5-2-2\" data-name=\"navigation link 2\">\n                    ACESSÓRIOS\n                </span>\n                <span data-kid=\"1-1-5-2-3\" data-name=\"navigation link 3\">\n                    SUPORTE\n                </span>\n                <span data-kid=\"1-1-5-2-4\" data-name=\"navigation link 4\">\n                    SOBRE\n                </span>\n            </div>\n            <div class=\"font-[DM_Mono] text-[10px] tracking-widest text-white/60\" data-kid=\"1-1-5-3\" data-name=\"page identifier number\">\n                06 / 07\n            </div>\n        </header>\n        <div class=\"relative z-10 grid min-h-[710px] grid-cols-12 gap-8 pt-12 lg:gap-12\" data-kid=\"1-1-6\" data-name=\"hero content layout grid\">\n            <div class=\"col-span-12 flex flex-col justify-center pb-12 lg:col-span-6 lg:pb-20\" data-kid=\"1-1-6-1\" data-name=\"hero introduction column\">\n                <div class=\"mb-7 flex items-center gap-3 font-[DM_Mono] text-[10px] tracking-[.2em] text-[#b5f229]\" data-kid=\"1-1-6-1-1\" data-name=\"hero subtitle section\">\n                    <span class=\"h-px w-10 bg-[#b5f229]\" data-kid=\"1-1-6-1-1-1\" data-name=\"subtitle decoration line\">\n                    </span>\n                    ENTRADA B2B / COTAÇÃO\n                </div>\n                <h1 class=\"max-w-[660px] font-[Barlow_Condensed] text-[clamp(54px,5.8vw,82px)] font-black uppercase leading-[.83] tracking-[-.035em]\" data-kid=\"1-1-6-1-2\" data-name=\"hero main headline\">\n                    PARA SUA FAMÍLIA.\n                    <br data-kid=\"1-1-6-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#b5f229]\" data-kid=\"1-1-6-1-2-2\" data-name=\"headline highlight text\">\n                        PARA AS FAMÍLIAS\n                    </span>\n                    <br data-kid=\"1-1-6-1-2-3\" data-name=\"headline line break\"/>\n                    DOS SEUS CLIENTES.\n                </h1>\n                <p class=\"mt-8 max-w-[510px] text-[16px] leading-7 text-slate-300\" data-kid=\"1-1-6-1-3\" data-name=\"hero description text\">\n                    Compre em quantidade para parques, escolas, academias, hotéis e revendedores.\n                </p>\n                <div class=\"mt-9 flex flex-wrap items-center gap-3\" data-kid=\"1-1-6-1-4\" data-name=\"call-to-action button group\">\n                    <a class=\"border border-white/70 px-6 py-4 text-[11px] font-extrabold tracking-[.14em] text-white\" data-kid=\"1-1-6-1-4-1\" data-name=\"primary action link\" href=\"#casa\">\n                        COMPRAR PARA CASA\n                        <span class=\"ml-2 text-[#b5f229]\" data-kid=\"1-1-6-1-4-1-1\" data-name=\"diagonal arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <a class=\"bg-[#b5f229] px-6 py-4 text-[11px] font-extrabold tracking-[.14em] text-[#07151f]\" data-kid=\"1-1-6-1-4-2\" data-name=\"secondary action link\" href=\"#cotacao\">\n                        COMPRAR EM QUANTIDADE\n                        <span class=\"ml-2\" data-kid=\"1-1-6-1-4-2-1\" data-name=\"diagonal arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mt-12 flex items-center gap-4 text-[10px] font-bold tracking-[.17em] text-white/50\" data-kid=\"1-1-6-1-5\" data-name=\"hero instruction info\">\n                    <span class=\"h-8 w-px bg-[#b5f229]\" data-kid=\"1-1-6-1-5-1\" data-name=\"instruction vertical separator\">\n                    </span>\n                    <span data-kid=\"1-1-6-1-5-2\" data-name=\"instruction text block\">\n                        ESCOLHA O CAMINHO\n                        <br data-kid=\"1-1-6-1-5-2-1\" data-name=\"instruction line break\"/>\n                        <em class=\"font-normal not-italic tracking-normal text-white/35\" data-kid=\"1-1-6-1-5-2-2\" data-name=\"instruction small text\">\n                            Varejo ou compra em quantidade\n                        </em>\n                    </span>\n                </div>\n            </div>\n            <div class=\"col-span-12 flex items-center justify-end lg:col-span-6\" data-kid=\"1-1-6-2\" data-name=\"quote form column\" id=\"cotacao\">\n                <form aria-label=\"Formulário visual de cotação\" class=\"w-full max-w-[500px] border border-[#07151f]/20 bg-[#f8faf5] p-7 text-[#07151f] shadow-[12px_12px_0_#07151f]/20 md:p-9\" data-kid=\"1-1-6-2-1\" data-name=\"quotation form\">\n                    <div class=\"flex items-start justify-between gap-4 border-b border-[#07151f]/15 pb-6\" data-kid=\"1-1-6-2-1-1\" data-name=\"form header\">\n                        <div data-kid=\"1-1-6-2-1-1-1\" data-name=\"form title group\">\n                            <p class=\"font-[DM_Mono] text-[10px] tracking-[.16em] text-[#3976ff]\" data-kid=\"1-1-6-2-1-1-1-1\" data-name=\"form eyebrow text\">\n                                FORMULÁRIO DE PROTÓTIPO\n                            </p>\n                            <h2 class=\"mt-3 font-[Barlow_Condensed] text-[48px] font-black uppercase leading-[.88] tracking-[-.02em]\" data-kid=\"1-1-6-2-1-1-1-2\" data-name=\"form main title\">\n                                RECEBA UMA\n                                <br data-kid=\"1-1-6-2-1-1-1-2-1\" data-name=\"title line break\"/>\n                                COTAÇÃO.\n                            </h2>\n                        </div>\n                        <span class=\"shrink-0 bg-[#b5f229] px-3 py-2 font-[DM_Mono] text-[11px] font-medium\" data-kid=\"1-1-6-2-1-1-2\" data-name=\"form page identifier\">\n                            06 / 07\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-x-5\" data-kid=\"1-1-6-2-1-2\" data-name=\"form input field grid\">\n                        <label class=\"col-span-2 border-b border-[#07151f]/20 py-4 text-[10px] font-extrabold tracking-[.12em]\" data-kid=\"1-1-6-2-1-2-1\" data-name=\"business type field label\">\n                            TIPO DE NEGÓCIO\n                            <span class=\"float-right font-[DM_Mono] font-normal tracking-normal text-[#3976ff]\" data-kid=\"1-1-6-2-1-2-1-1\" data-name=\"field label identifier\">\n                                ESTRUTURA\n                            </span>\n                            <input class=\"mt-2 block w-full bg-transparent text-[13px] font-medium tracking-normal text-[#07151f]/60 outline-hidden\" data-kid=\"1-1-6-2-1-2-1-2\" data-name=\"business type input\" placeholder=\"Selecione uma opção\" type=\"text\"/>\n                        </label>\n                        <label class=\"border-b border-[#07151f]/20 py-4 text-[10px] font-extrabold tracking-[.1em]\" data-kid=\"1-1-6-2-1-2-2\" data-name=\"estimated quantity field label\">\n                            QUANTIDADE ESTIMADA\n                            <span class=\"float-right font-[DM_Mono] font-normal tracking-normal text-[#3976ff]\" data-kid=\"1-1-6-2-1-2-2-1\" data-name=\"field label identifier\">\n                                ESTRUTURA\n                            </span>\n                            <input class=\"mt-2 block w-full bg-transparent text-[13px] font-medium tracking-normal text-[#07151f]/60 outline-hidden\" data-kid=\"1-1-6-2-1-2-2-2\" data-name=\"estimated quantity input\" placeholder=\"Ex.: 10 unidades\" type=\"text\"/>\n                        </label>\n                        <label class=\"border-b border-[#07151f]/20 py-4 text-[10px] font-extrabold tracking-[.1em]\" data-kid=\"1-1-6-2-1-2-3\" data-name=\"region field label\">\n                            REGIÃO\n                            <span class=\"float-right font-[DM_Mono] font-normal tracking-normal text-[#3976ff]\" data-kid=\"1-1-6-2-1-2-3-1\" data-name=\"field label identifier\">\n                                ESTRUTURA\n                            </span>\n                            <input class=\"mt-2 block w-full bg-transparent text-[13px] font-medium tracking-normal text-[#07151f]/60 outline-hidden\" data-kid=\"1-1-6-2-1-2-3-2\" data-name=\"region input\" placeholder=\"Cidade / estado\" type=\"text\"/>\n                        </label>\n                        <label class=\"col-span-2 border-b border-[#07151f]/20 py-4 text-[10px] font-extrabold tracking-[.12em]\" data-kid=\"1-1-6-2-1-2-4\" data-name=\"timeframe field label\">\n                            PRAZO\n                            <span class=\"float-right font-[DM_Mono] font-normal tracking-normal text-[#3976ff]\" data-kid=\"1-1-6-2-1-2-4-1\" data-name=\"field label identifier\">\n                                ESTRUTURA\n                            </span>\n                            <input class=\"mt-2 block w-full bg-transparent text-[13px] font-medium tracking-normal text-[#07151f]/60 outline-hidden\" data-kid=\"1-1-6-2-1-2-4-2\" data-name=\"timeframe input\" placeholder=\"Quando pretende comprar?\" type=\"text\"/>\n                        </label>\n                        <label class=\"col-span-2 border-b border-[#07151f]/20 py-4 text-[10px] font-extrabold tracking-[.12em]\" data-kid=\"1-1-6-2-1-2-5\" data-name=\"contact field label\">\n                            NOME E CONTATO\n                            <span class=\"float-right font-[DM_Mono] font-normal tracking-normal text-[#3976ff]\" data-kid=\"1-1-6-2-1-2-5-1\" data-name=\"field label identifier\">\n                                ESTRUTURA\n                            </span>\n                            <input class=\"mt-2 block w-full bg-transparent text-[13px] font-medium tracking-normal text-[#07151f]/60 outline-hidden\" data-kid=\"1-1-6-2-1-2-5-2\" data-name=\"contact input\" placeholder=\"Nome, e-mail ou telefone\" type=\"text\"/>\n                        </label>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-4 pt-6\" data-kid=\"1-1-6-2-1-3\" data-name=\"form footer\">\n                        <p class=\"text-[11px] leading-4 text-[#07151f]/55\" data-kid=\"1-1-6-2-1-3-1\" data-name=\"form submission notice\">\n                            Resposta comercial após envio.\n                        </p>\n                        <button class=\"shrink-0 bg-[#07151f] px-5 py-3.5 text-[10px] font-extrabold tracking-[.14em] text-white\" data-kid=\"1-1-6-2-1-3-2\" data-name=\"submit button\" type=\"button\">\n                            ENVIAR ↗\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </div>\n        <div class=\"absolute bottom-5 left-10 z-10 font-[DM_Mono] text-[10px] tracking-[.2em] text-white/45 md:left-14\" data-kid=\"1-1-7\" data-name=\"breadcrumb text\">\n            JUMPFLEX HOME / B2B\n        </div>\n    </section>\n</main>\n",
