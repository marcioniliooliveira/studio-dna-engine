        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Modak&family=Mouse+Memoirs&display=swap');\n  html{scroll-behavior:smooth} body{font-family:'Inter',sans-serif;background:#F4EBE1;color:#27272a} .display{font-family:'Modak',system-ui}.accent{font-family:'Mouse Memoirs',sans-serif}\n  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)} .reveal.is-visible{opacity:1;transform:none}\n  .parallax{will-change:transform}\n</style>\n<script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\">\n</script>\n<div class=\"min-h-screen overflow-x-hidden bg-[#F4EBE1] selection:bg-[#F91814] selection:text-white\" data-kid=\"1\" data-name=\"page layout container\">\n    <nav class=\"fixed inset-x-0 top-0 z-50 bg-transparent\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <div class=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"navigation content wrapper\">\n            <a class=\"display text-4xl uppercase tracking-tight text-[#F91814]\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#inicio\">\n                VILA\n            </a>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"navigation items and actions container\">\n                <div class=\"hidden items-center gap-6 md:flex\" data-kid=\"1-1-1-2-1\" data-name=\"desktop navigation menu links\">\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 transition-colors hover:text-zinc-900\" data-kid=\"1-1-1-2-1-1\" data-name=\"início link\" href=\"#inicio\">\n                        Início\n                    </a>\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 transition-colors hover:text-zinc-900\" data-kid=\"1-1-1-2-1-2\" data-name=\"a casa link\" href=\"#casa\">\n                        A casa\n                    </a>\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 transition-colors hover:text-zinc-900\" data-kid=\"1-1-1-2-1-3\" data-name=\"ingredientes link\" href=\"#ingredientes\">\n                        Ingredientes\n                    </a>\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 transition-colors hover:text-zinc-900\" data-kid=\"1-1-1-2-1-4\" data-name=\"lojas link\" href=\"#lojas\">\n                        Lojas\n                    </a>\n                </div>\n                <a class=\"hidden rounded-full bg-[#F91814] px-5 py-2 text-xs font-medium uppercase tracking-tight text-white shadow-sm transition-all hover:bg-red-700 md:inline-flex\" data-kid=\"1-1-1-2-2\" data-name=\"primary call-to-action link\" href=\"#pedido\">\n                    Pedir agora\n                </a>\n                <button aria-label=\"Abrir menu\" class=\"inline-flex rounded-full p-2 text-zinc-700 transition-colors hover:bg-zinc-100 md:hidden\" data-kid=\"1-1-1-2-3\" data-name=\"hamburger menu button\">\n                    <iconify-icon data-kid=\"1-1-1-2-3-1\" data-name=\"hamburger menu icon\" icon=\"solar:hamburger-menu-linear\" style=\"font-size:24px;stroke-width:1.5\">\n                    </iconify-icon>\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"relative flex flex-col items-center overflow-hidden px-6 pb-20 pt-32 text-center md:pb-32 md:pt-40\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"inicio\">\n            <div class=\"pointer-events-none absolute inset-0 -z-10 flex items-center justify-center select-none opacity-5\" data-kid=\"1-2-1-1\" data-name=\"background text wrapper\">\n                <span class=\"display text-[25vw] leading-none text-[#F4A804]\" data-kid=\"1-2-1-1-1\" data-name=\"hero background decorative text\">\n                    VILA\n                </span>\n            </div>\n            <h1 class=\"display reveal text-6xl leading-none tracking-tighter text-[#F91814] drop-shadow-sm md:text-[10vw]\" data-kid=\"1-2-1-2\" data-name=\"hero main heading\">\n                O SMASH\n            </h1>\n            <div class=\"accent reveal mt-6 flex items-center justify-center gap-4 text-xl uppercase tracking-tight text-[#F4A804] md:text-3xl\" data-kid=\"1-2-1-3\" data-name=\"hero subheadline container\">\n                <span data-kid=\"1-2-1-3-1\" data-name=\"crosta dourada text\">\n                    Crosta dourada\n                </span>\n                <span class=\"h-1.5 w-1.5 rounded-full bg-zinc-300\" data-kid=\"1-2-1-3-2\" data-name=\"separator dot\">\n                </span>\n                <span data-kid=\"1-2-1-3-3\" data-name=\"vontade de repetir text\">\n                    Vontade de repetir\n                </span>\n            </div>\n            <div class=\"parallax relative z-10 mt-12 mb-8 w-full max-w-4xl\" data-dynamic=\"true\" data-kid=\"1-2-1-4\" data-name=\"hero burger image parallax container\" data-reason=\"transform property updated on scroll\">\n                <div class=\"absolute inset-x-0 top-1/2 z-10 h-1/2 bg-gradient-to-t from-[#FAFAFA] via-transparent to-transparent\" data-kid=\"1-2-1-4-1\" data-name=\"burger image shadow gradient overlay\">\n                </div>\n                <img alt=\"Hambúrguer artesanal VILA SMASH\" class=\"w-full object-contain drop-shadow-2xl transition-transform duration-700 hover:scale-[1.02]\" data-kid=\"1-2-1-4-2\" data-name=\"hero burger image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/burgerH.webp\"/>\n            </div>\n            <div class=\"reveal relative z-20 flex w-full max-w-4xl flex-col justify-between gap-8 px-6 text-left text-sm font-medium tracking-tight text-zinc-500 md:flex-row\" data-kid=\"1-2-1-5\" data-name=\"hero description container\">\n                <p class=\"max-w-xs\" data-kid=\"1-2-1-5-1\" data-name=\"hero description first paragraph\">\n                    Prensado na chapa bem quente, nosso blend entrega aquela crosta crocante por fora e suculência a cada mordida.\n                </p>\n                <p class=\"max-w-xs md:text-right\" data-kid=\"1-2-1-5-2\" data-name=\"hero description second paragraph\">\n                    Queijo derretido, molho da casa e ingredientes de verdade. Um smash com sotaque brasileiro desde a primeira loja.\n                </p>\n            </div>\n        </section>\n        <section class=\"bg-[#F4EBE1] px-6 py-24 md:py-32\" data-kid=\"1-2-2\" data-name=\"about section\" id=\"casa\">\n            <div class=\"mx-auto flex max-w-7xl flex-col items-center text-center\" data-kid=\"1-2-2-1\" data-name=\"about section content container\">\n                <p class=\"accent reveal mb-4 text-2xl uppercase tracking-tight text-[#F91814]\" data-kid=\"1-2-2-1-1\" data-name=\"about section label\">\n                    A nossa casa\n                </p>\n                <h2 class=\"display reveal mb-8 text-4xl leading-tight tracking-tighter text-[#F91814] md:text-6xl\" data-kid=\"1-2-2-1-2\" data-name=\"about section heading\">\n                    DEU FOME,\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"heading line break\"/>\n                    DEU VILA\n                </h2>\n                <p class=\"reveal mb-10 max-w-xl text-sm font-medium leading-relaxed tracking-tight text-zinc-500\" data-kid=\"1-2-2-1-3\" data-name=\"about section description text\">\n                    A VILA SMASH nasceu para transformar a pausa do dia em um momento inesquecível. Chapa acesa, pão macio e um sabor exageradamente bom, feito na hora para cada pessoa.\n                </p>\n                <a class=\"reveal inline-flex items-center gap-2 rounded-full bg-[#F91814] px-7 py-3 text-xs font-medium uppercase tracking-tight text-white shadow-sm transition-colors hover:bg-red-700\" data-kid=\"1-2-2-1-4\" data-name=\"about section cta button\" href=\"#pedido\">\n                    Conheça o cardápio\n                    <iconify-icon data-kid=\"1-2-2-1-4-1\" data-name=\"arrow right icon\" icon=\"solar:arrow-right-linear\" style=\"font-size:18px;stroke-width:1.5\">\n                    </iconify-icon>\n                </a>\n                <div class=\"mt-24 grid w-full max-w-5xl grid-cols-1 gap-6 md:grid-cols-3\" data-kid=\"1-2-2-1-5\" data-name=\"about section image grid\">\n                    <div class=\"reveal group h-72 overflow-hidden rounded-3xl border border-zinc-100 shadow-sm md:h-96\" data-kid=\"1-2-2-1-5-1\" data-name=\"first feature card container\">\n                        <img alt=\"Equipe preparando hambúrguer\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-105\" data-kid=\"1-2-2-1-5-1-1\" data-name=\"first feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-1.webp\"/>\n                    </div>\n                    <div class=\"reveal group relative z-10 h-72 overflow-hidden rounded-3xl border border-zinc-100 shadow-sm md:-mt-8 md:h-96\" data-kid=\"1-2-2-1-5-2\" data-name=\"second feature card container\">\n                        <img alt=\"Queijo derretendo no hambúrguer\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-105\" data-kid=\"1-2-2-1-5-2-1\" data-name=\"second feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-2.webp\"/>\n                    </div>\n                    <div class=\"reveal group h-72 overflow-hidden rounded-3xl border border-zinc-100 shadow-sm md:h-96\" data-kid=\"1-2-2-1-5-3\" data-name=\"third feature card container\">\n                        <img alt=\"Ambiente da hamburgueria\" class=\"h-full w-full object-cover transition-transform duration-700 group-hover:scale-105\" data-kid=\"1-2-2-1-5-3-1\" data-name=\"third feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-3.webp\"/>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[#F91814] px-6 py-24 md:py-32\" data-kid=\"1-2-3\" data-name=\"experience highlights section\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-3-1\" data-name=\"highlights section content container\">\n                <div class=\"mb-16 text-center\" data-kid=\"1-2-3-1-1\" data-name=\"highlights section header\">\n                    <p class=\"accent reveal mb-4 text-xl uppercase tracking-tight text-white md:text-2xl\" data-kid=\"1-2-3-1-1-1\" data-name=\"highlights section label\">\n                        A experiência\n                    </p>\n                    <h2 class=\"display reveal text-4xl leading-tight tracking-tighter text-white md:text-5xl\" data-kid=\"1-2-3-1-1-2\" data-name=\"highlights section heading\">\n                        COMIDA QUE ABRAÇA\n                    </h2>\n                </div>\n                <div class=\"reveal relative mt-12 flex flex-col items-center justify-between gap-12 md:flex-row\" data-kid=\"1-2-3-1-2\" data-name=\"highlights grid\">\n                    <div class=\"flex flex-col gap-6 text-xs font-medium uppercase tracking-tight text-white md:w-1/4\" data-kid=\"1-2-3-1-2-1\" data-name=\"highlights left column\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"fire highlight item\">\n                            <iconify-icon data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"fire icon\" icon=\"solar:fire-linear\" style=\"font-size:20px;color:#fff\">\n                            </iconify-icon>\n                            <span data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"fire highlight text\">\n                                450 kcal de felicidade\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"dumbbell highlight item\">\n                            <iconify-icon data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"dumbbell icon\" icon=\"solar:dumbbell-linear\" style=\"font-size:20px;color:#fff\">\n                            </iconify-icon>\n                            <span data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"dumbbell highlight text\">\n                                Blend rico em sabor\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"leaf highlight item\">\n                            <iconify-icon data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"leaf icon\" icon=\"solar:leaf-linear\" style=\"font-size:20px;color:#fff\">\n                            </iconify-icon>\n                            <span data-kid=\"1-2-3-1-2-1-3-2\" data-name=\"leaf highlight text\">\n                                Ingredientes frescos\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"relative z-10 flex justify-center md:w-2/4\" data-kid=\"1-2-3-1-2-2\" data-name=\"center burger image wrapper\">\n                        <img alt=\"Hambúrguer nas mãos\" class=\"w-full max-w-[280px] drop-shadow-xl md:max-w-[400px]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"center burger image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/burgerwithhands.webp\"/>\n                    </div>\n                    <div class=\"flex flex-col gap-6 text-right text-xs font-medium uppercase tracking-tight text-white md:w-1/4 md:items-end\" data-kid=\"1-2-3-1-2-3\" data-name=\"highlights right column\">\n                        <div class=\"flex flex-row-reverse items-center gap-3 md:flex-row\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"shield highlight item\">\n                            <span data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"shield highlight text\">\n                                100% gostoso\n                            </span>\n                            <iconify-icon data-kid=\"1-2-3-1-2-3-1-2\" data-name=\"shield icon\" icon=\"solar:shield-check-linear\" style=\"font-size:20px;color:#fff\">\n                            </iconify-icon>\n                        </div>\n                        <div class=\"flex flex-row-reverse items-center gap-3 md:flex-row\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"heart highlight item\">\n                            <span data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"heart highlight text\">\n                                Zero mesmice\n                            </span>\n                            <iconify-icon data-kid=\"1-2-3-1-2-3-2-2\" data-name=\"heart icon\" icon=\"solar:heart-linear\" style=\"font-size:20px;color:#fff\">\n                            </iconify-icon>\n                        </div>\n                        <div class=\"flex flex-row-reverse items-center gap-3 md:flex-row\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"star highlight item\">\n                            <span data-kid=\"1-2-3-1-2-3-3-1\" data-name=\"star highlight text\">\n                                Sabor de verdade\n                            </span>\n                            <iconify-icon data-kid=\"1-2-3-1-2-3-3-2\" data-name=\"star icon\" icon=\"solar:star-linear\" style=\"font-size:20px;color:#fff\">\n                            </iconify-icon>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#F4EBE1] px-6 py-24 md:py-32\" data-kid=\"1-2-4\" data-name=\"ingredients section\" id=\"ingredientes\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-4-1\" data-name=\"ingredients section content container\">\n                <div class=\"mb-16 text-center\" data-kid=\"1-2-4-1-1\" data-name=\"ingredients section header\">\n                    <h2 class=\"display reveal mb-4 text-4xl tracking-tighter text-[#F91814] md:text-5xl\" data-kid=\"1-2-4-1-1-1\" data-name=\"ingredients section heading\">\n                        QUALIDADE NA CHAPA\n                    </h2>\n                    <h3 class=\"reveal text-xl font-medium tracking-tight text-[#F91814] md:text-2xl\" data-kid=\"1-2-4-1-1-2\" data-name=\"ingredients section subheadline\">\n                        Cada camada tem uma história para contar\n                    </h3>\n                </div>\n                <div class=\"grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6\" data-kid=\"1-2-4-1-2\" data-name=\"ingredients grid\">\n                    <div class=\"reveal flex flex-col items-center p-8 text-center\" data-kid=\"1-2-4-1-2-1\" data-name=\"first ingredient item\">\n                        <img alt=\"Tomate fresco\" class=\"mb-6 h-24 w-24 object-contain drop-shadow-md transition-transform duration-500 hover:scale-110 md:h-32 md:w-32\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"first ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/tomato.webp\"/>\n                        <h4 class=\"text-lg font-bold tracking-tight text-[#F91814]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"first ingredient name\">\n                            Tomate da feira\n                        </h4>\n                    </div>\n                    <div class=\"reveal flex translate-y-4 flex-col items-center p-8 text-center\" data-kid=\"1-2-4-1-2-2\" data-name=\"second ingredient item\">\n                        <img alt=\"Queijo premium\" class=\"mb-6 h-24 w-24 object-contain drop-shadow-md transition-transform duration-500 hover:scale-110 md:h-32 md:w-32\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"second ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/cheese.webp\"/>\n                        <h4 class=\"text-lg font-bold tracking-tight text-[#F91814]\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"second ingredient name\">\n                            Queijo derretido\n                        </h4>\n                    </div>\n                    <div class=\"reveal flex flex-col items-center p-8 text-center\" data-kid=\"1-2-4-1-2-3\" data-name=\"third ingredient item\">\n                        <img alt=\"Blend artesanal de carne\" class=\"mb-6 h-24 w-24 object-contain drop-shadow-md transition-transform duration-500 hover:scale-110 md:h-32 md:w-32\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"third ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/meat.webp\"/>\n                        <h4 class=\"text-lg font-bold tracking-tight text-[#F91814]\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"third ingredient name\">\n                            Blend da casa\n                        </h4>\n                    </div>\n                    <div class=\"reveal flex translate-y-4 flex-col items-center p-8 text-center\" data-kid=\"1-2-4-1-2-4\" data-name=\"fourth ingredient item\">\n                        <img alt=\"Alface crocante\" class=\"mb-6 h-24 w-24 object-contain drop-shadow-md transition-transform duration-500 hover:scale-110 md:h-32 md:w-32\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"fourth ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/lettuce.webp\"/>\n                        <h4 class=\"text-lg font-bold tracking-tight text-[#F91814]\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"fourth ingredient name\">\n                            Frescor crocante\n                        </h4>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#F9CD25] px-6 py-24 md:py-32\" data-kid=\"1-2-5\" data-name=\"store locations section\" id=\"lojas\">\n            <div class=\"mx-auto flex max-w-7xl flex-col items-start gap-16 md:flex-row md:gap-8\" data-kid=\"1-2-5-1\" data-name=\"locations content container\">\n                <div class=\"md:sticky md:top-32 md:w-1/3\" data-kid=\"1-2-5-1-1\" data-name=\"locations left column\">\n                    <p class=\"accent reveal mb-4 text-2xl uppercase tracking-tight text-white\" data-kid=\"1-2-5-1-1-1\" data-name=\"locations section label\">\n                        Chega junto\n                    </p>\n                    <h2 class=\"display reveal mb-6 text-4xl leading-tight tracking-tighter text-white md:text-5xl\" data-kid=\"1-2-5-1-1-2\" data-name=\"locations section heading\">\n                        A VILA VAI ATÉ VOCÊ\n                    </h2>\n                    <p class=\"reveal max-w-sm text-sm font-semibold leading-relaxed text-white\" data-kid=\"1-2-5-1-1-3\" data-name=\"locations section description\">\n                        Do interior à orla, a mesma chapa, o mesmo cuidado e aquele cheiro que faz todo mundo olhar.\n                    </p>\n                </div>\n                <div class=\"grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 md:w-2/3\" data-kid=\"1-2-5-1-2\" data-name=\"locations grid\">\n                    <div class=\"reveal\" data-kid=\"1-2-5-1-2-1\" data-name=\"são paulo card\">\n                        <img alt=\"São Paulo\" class=\"mb-4 aspect-[4/5] w-full rounded-3xl object-cover shadow-sm\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"são paulo image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/berlin.webp\"/>\n                        <p class=\"display pb-2 text-center text-xl tracking-tight text-[#F91814]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"são paulo text\">\n                            SÃO PAULO\n                        </p>\n                    </div>\n                    <div class=\"reveal md:mt-8\" data-kid=\"1-2-5-1-2-2\" data-name=\"rio card\">\n                        <img alt=\"Rio de Janeiro\" class=\"mb-4 aspect-[4/5] w-full rounded-3xl object-cover shadow-sm\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"rio image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/london.webp\"/>\n                        <p class=\"display pb-2 text-center text-xl tracking-tight text-[#F91814]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"rio text\">\n                            RIO\n                        </p>\n                    </div>\n                    <div class=\"reveal\" data-kid=\"1-2-5-1-2-3\" data-name=\"recife card\">\n                        <img alt=\"Recife\" class=\"mb-4 aspect-[4/5] w-full rounded-3xl object-cover shadow-sm\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"recife image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/newyork.webp\"/>\n                        <p class=\"display pb-2 text-center text-xl tracking-tight text-[#F91814]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"recife text\">\n                            RECIFE\n                        </p>\n                    </div>\n                    <div class=\"reveal md:-mt-8\" data-kid=\"1-2-5-1-2-4\" data-name=\"porto alegre card\">\n                        <img alt=\"Porto Alegre\" class=\"mb-4 aspect-[4/5] w-full rounded-3xl object-cover shadow-sm\" data-kid=\"1-2-5-1-2-4-1\" data-name=\"porto alegre image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/sydney.webp\"/>\n                        <p class=\"display pb-2 text-center text-xl tracking-tight text-[#F91814]\" data-kid=\"1-2-5-1-2-4-2\" data-name=\"porto alegre text\">\n                            PORTO ALEGRE\n                        </p>\n                    </div>\n                    <div class=\"reveal\" data-kid=\"1-2-5-1-2-5\" data-name=\"brasília card\">\n                        <img alt=\"Brasília\" class=\"mb-4 aspect-[4/5] w-full rounded-3xl object-cover shadow-sm\" data-kid=\"1-2-5-1-2-5-1\" data-name=\"brasília image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/tokyo.webp\"/>\n                        <p class=\"display pb-2 text-center text-xl tracking-tight text-[#F91814]\" data-kid=\"1-2-5-1-2-5-2\" data-name=\"brasília text\">\n                            BRASÍLIA\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[#F4EBE1] px-6 py-24 md:py-32\" data-kid=\"1-2-6\" data-name=\"cta section\" id=\"pedido\">\n            <div class=\"mx-auto flex max-w-5xl flex-col items-center gap-12 md:flex-row md:gap-20\" data-kid=\"1-2-6-1\" data-name=\"cta section content container\">\n                <div class=\"flex flex-col items-center text-center md:w-1/2 md:items-start md:text-left\" data-kid=\"1-2-6-1-1\" data-name=\"cta text wrapper\">\n                    <p class=\"accent reveal mb-4 text-xl uppercase tracking-tight text-[#F91814] md:text-2xl\" data-kid=\"1-2-6-1-1-1\" data-name=\"cta section label\">\n                        Bateu a vontade?\n                    </p>\n                    <h2 class=\"display reveal mb-8 text-5xl leading-none tracking-tighter text-[#F91814] md:text-7xl\" data-kid=\"1-2-6-1-1-2\" data-name=\"cta section heading\">\n                        SINTA A\n                        <br data-kid=\"1-2-6-1-1-2-1\" data-name=\"cta heading break\"/>\n                        DIFERENÇA\n                    </h2>\n                    <p class=\"reveal mb-10 max-w-sm text-sm font-medium leading-relaxed text-zinc-500\" data-kid=\"1-2-6-1-1-3\" data-name=\"cta section description\">\n                        Feito para quem não abre mão de sabor. Escolha seu smash, reúna a turma e deixe a chapa fazer o resto.\n                    </p>\n                    <a class=\"reveal inline-flex items-center gap-2 rounded-full bg-[#F91814] px-8 py-3.5 text-xs font-medium uppercase tracking-tight text-white shadow-md transition-colors hover:bg-red-700\" data-kid=\"1-2-6-1-1-4\" data-name=\"cta section button\" href=\"#footer\">\n                        Pedir meu smash\n                        <iconify-icon data-kid=\"1-2-6-1-1-4-1\" data-name=\"cta arrow icon\" icon=\"solar:arrow-right-linear\" style=\"font-size:18px\">\n                        </iconify-icon>\n                    </a>\n                </div>\n                <div class=\"reveal relative w-full md:w-1/2\" data-kid=\"1-2-6-1-2\" data-name=\"cta image wrapper\">\n                    <div class=\"absolute inset-0 -z-10 translate-x-4 translate-y-4 rounded-[2rem] bg-gradient-to-tr from-zinc-100 to-transparent\" data-kid=\"1-2-6-1-2-1\" data-name=\"cta image decoration\">\n                    </div>\n                    <img alt=\"Smash burger VILA SMASH\" class=\"aspect-[4/5] w-full rounded-[2rem] border border-zinc-100 object-cover shadow-xl\" data-kid=\"1-2-6-1-2-2\" data-name=\"cta burger image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/cta.webp\"/>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"mt-auto border-t border-[#40220D] bg-[#2C1608] pb-12 pt-20 text-white\" data-kid=\"1-3\" data-name=\"footer\" id=\"footer\">\n        <div class=\"mx-auto max-w-7xl px-6\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n            <div class=\"mb-16 grid grid-cols-1 gap-12 md:grid-cols-4\" data-kid=\"1-3-1-1\" data-name=\"footer top section grid\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n                    <a class=\"display mb-6 block text-5xl uppercase text-[#F91814]\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer brand link\" href=\"#inicio\">\n                        VILA\n                    </a>\n                    <p class=\"mb-6 text-sm font-medium leading-relaxed tracking-tight text-zinc-400\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer brand description\">\n                        Smash de verdade, feito na hora e servido com orgulho brasileiro.\n                    </p>\n                    <div class=\"flex items-center gap-4 text-zinc-400\" data-kid=\"1-3-1-1-1-3\" data-name=\"social media icons container\">\n                        <a aria-label=\"Instagram\" class=\"transition-colors hover:text-white\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"instagram link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-1-1\" data-name=\"instagram icon\" icon=\"mdi:instagram\" style=\"font-size:24px\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"Facebook\" class=\"transition-colors hover:text-white\" data-kid=\"1-3-1-1-1-3-2\" data-name=\"facebook link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-2-1\" data-name=\"facebook icon\" icon=\"mdi:facebook\" style=\"font-size:24px\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"TikTok\" class=\"transition-colors hover:text-white\" data-kid=\"1-3-1-1-1-3-3\" data-name=\"tiktok link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-3-1\" data-name=\"tiktok icon\" icon=\"mdi:music-note\" style=\"font-size:24px\">\n                            </iconify-icon>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"md:pl-8\" data-kid=\"1-3-1-1-2\" data-name=\"navigation links column\">\n                    <h4 class=\"mb-6 text-sm font-bold uppercase tracking-tight text-white\" data-kid=\"1-3-1-1-2-1\" data-name=\"navigation column title\">\n                        Navegação\n                    </h4>\n                    <div class=\"flex flex-col gap-4\" data-kid=\"1-3-1-1-2-2\" data-name=\"navigation links list\">\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"navigation inicio link\" href=\"#inicio\">\n                            Início\n                        </a>\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"navigation casa link\" href=\"#casa\">\n                            A casa\n                        </a>\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-3\" data-name=\"navigation ingredientes link\" href=\"#ingredientes\">\n                            Ingredientes\n                        </a>\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-4\" data-name=\"navigation lojas link\" href=\"#lojas\">\n                            Lojas\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"information links column\">\n                    <h4 class=\"mb-6 text-sm font-bold uppercase tracking-tight text-white\" data-kid=\"1-3-1-1-3-1\" data-name=\"information column title\">\n                        Informações\n                    </h4>\n                    <div class=\"flex flex-col gap-4\" data-kid=\"1-3-1-1-3-2\" data-name=\"information links list\">\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"information cardápio link\" href=\"#pedido\">\n                            Cardápio\n                        </a>\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"information faq link\" href=\"#footer\">\n                            FAQ\n                        </a>\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"information contato link\" href=\"#footer\">\n                            Contato\n                        </a>\n                        <a class=\"text-sm font-medium tracking-tight text-zinc-400 hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-4\" data-name=\"information trabalho link\" href=\"#footer\">\n                            Trabalhe conosco\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"newsletter signup column\">\n                    <h4 class=\"mb-6 text-sm font-bold uppercase tracking-tight text-white\" data-kid=\"1-3-1-1-4-1\" data-name=\"newsletter column title\">\n                        Clube da Vila\n                    </h4>\n                    <p class=\"mb-4 text-sm font-medium leading-relaxed tracking-tight text-zinc-400\" data-kid=\"1-3-1-1-4-2\" data-name=\"newsletter description\">\n                        Receba novidades, cupons e convites para os próximos rolês.\n                    </p>\n                    <form class=\"flex flex-col gap-3\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter form\" onsubmit=\"event.preventDefault()\">\n                        <input class=\"w-full rounded-full border border-[#583115] bg-[#40220D] px-5 py-3 text-sm text-white placeholder:text-zinc-500 focus:border-[#F91814] focus:outline-none\" data-kid=\"1-3-1-1-4-3-1\" data-name=\"email input field\" placeholder=\"Seu melhor e-mail\" required=\"\" type=\"email\"/>\n                        <button class=\"w-full rounded-full bg-[#F91814] px-5 py-3 text-xs font-semibold uppercase tracking-tight text-white transition-colors hover:bg-red-700\" data-kid=\"1-3-1-1-4-3-2\" data-name=\"subscribe button\">\n                            Quero entrar\n                        </button>\n                    </form>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center justify-between gap-4 border-t border-[#40220D] pt-8 md:flex-row\" data-kid=\"1-3-1-2\" data-name=\"footer bottom section\">\n                <p class=\"text-xs font-medium tracking-tight text-zinc-500\" data-kid=\"1-3-1-2-1\" data-name=\"copyright text\">\n                    © 2026 VILA SMASH — Todos os direitos reservados.\n                </p>\n                <div class=\"flex gap-4\" data-kid=\"1-3-1-2-2\" data-name=\"footer links container\">\n                    <a class=\"text-xs font-medium text-zinc-500 hover:text-zinc-300\" data-kid=\"1-3-1-2-2-1\" data-name=\"privacy link\" href=\"#\">\n                        Privacidade\n                    </a>\n                    <a class=\"text-xs font-medium text-zinc-500 hover:text-zinc-300\" data-kid=\"1-3-1-2-2-2\" data-name=\"terms link\" href=\"#\">\n                        Termos\n                    </a>\n                </div>\n            </div>\n            <div class=\"mt-16 flex justify-center overflow-hidden\" data-kid=\"1-3-1-3\" data-name=\"footer logo decoration wrapper\">\n                <h2 class=\"display select-none text-[25vw] leading-none tracking-tighter text-[#F91814] md:text-[15vw]\" data-kid=\"1-3-1-3-1\" data-name=\"footer decorative large text\">\n                    VILA\n                </h2>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)entry.target.classList.add('is-visible')}),{threshold:.12}); document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));\n  const hero=document.querySelector('.parallax'); window.addEventListener('scroll',()=>{if(hero)hero.style.transform=`translateY(${Math.min(window.scrollY*.08,42)}px)`},{passive:true});\n</script>\n",
      "comments": [],
      "created": "2026-08-31T17:41:12.992053+00:00",
      "modified": "2026-08-31T17:41:52.196498+00:00",
      "id": "var_297d4fa5a67b",
      "viewportScrollY": 0
    },
    "var_7b69335bbb0a": {
      "type": "variant",
      "label": "BRASA BRAVA — Brazilian Burger Case Study",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Modak&family=Mouse+Memoirs&display=swap');\nhtml{scroll-behavior:smooth} .bb-reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}.bb-reveal.is-visible{opacity:1;transform:none}\n</style>\n<script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\">\n</script>\n<div class=\"min-h-screen overflow-x-hidden bg-[#F4EBE1] text-zinc-800 antialiased selection:bg-[#F91814] selection:text-white\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:Inter, sans-serif\">\n    <nav class=\"fixed inset-x-0 top-0 z-50 bg-transparent\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <div class=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"navigation container\">\n            <a class=\"text-4xl uppercase text-[#F91814]\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#inicio\" style=\"font-family:Modak,system-ui\">\n                BRASA\n                <br class=\"hidden\" data-kid=\"1-1-1-1-1\" data-name=\"line break element\"/>\n                BRAVA\n            </a>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"nav links and cta container\">\n                <div class=\"hidden items-center gap-6 md:flex\" data-kid=\"1-1-1-2-1\" data-name=\"desktop navigation menu\">\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 hover:text-zinc-900\" data-kid=\"1-1-1-2-1-1\" data-name=\"nav link\" href=\"#inicio\">\n                        Início\n                    </a>\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 hover:text-zinc-900\" data-kid=\"1-1-1-2-1-2\" data-name=\"nav link\" href=\"#historia\">\n                        Nossa história\n                    </a>\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 hover:text-zinc-900\" data-kid=\"1-1-1-2-1-3\" data-name=\"nav link\" href=\"#ingredientes\">\n                        Ingredientes\n                    </a>\n                    <a class=\"text-xs font-medium uppercase tracking-tight text-zinc-500 hover:text-zinc-900\" data-kid=\"1-1-1-2-1-4\" data-name=\"nav link\" href=\"#locais\">\n                        Onde encontrar\n                    </a>\n                </div>\n                <a class=\"hidden rounded-full bg-[#F91814] px-5 py-2 text-xs font-medium uppercase tracking-tight text-white shadow-sm hover:bg-red-700 md:inline-flex\" data-kid=\"1-1-1-2-2\" data-name=\"primary cta button\" href=\"#pedir\">\n                    Pedir agora\n                </a>\n                <button aria-label=\"Abrir menu\" class=\"inline-flex rounded-full p-2 text-zinc-700 hover:bg-zinc-100 md:hidden\" data-kid=\"1-1-1-2-3\" data-name=\"mobile menu button\">\n                    <iconify-icon data-kid=\"1-1-1-2-3-1\" data-name=\"hamburger menu icon\" icon=\"solar:hamburger-menu-linear\" style=\"width:22px;height:22px;stroke-width:1.5\">\n                    </iconify-icon>\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"page main content\">\n        <section class=\"relative flex flex-col items-center overflow-hidden px-6 pb-20 pt-32 text-center md:pb-32 md:pt-40\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"inicio\">\n            <div class=\"pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-5\" data-kid=\"1-2-1-1\" data-name=\"decorative hero background text container\">\n                <span class=\"text-[25vw] leading-none text-[#F4A804]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1\" data-name=\"decorative hero background text\" data-reason=\"y-offset updated on scroll by script\" style=\"font-family:Modak,system-ui\">\n                    BRASA\n                </span>\n            </div>\n            <h1 class=\"text-6xl leading-none tracking-tighter text-[#F91814] drop-shadow-sm md:text-[10vw]\" data-kid=\"1-2-1-2\" data-name=\"hero headline\" style=\"font-family:Modak,system-ui\">\n                O BURGER\n            </h1>\n            <div class=\"mt-6 flex items-center justify-center gap-4 text-[#F4A804]\" data-kid=\"1-2-1-3\" data-name=\"hero subheadline container\">\n                <p class=\"text-xl uppercase tracking-tight md:text-3xl\" data-kid=\"1-2-1-3-1\" data-name=\"subheadline text\" style=\"font-family:'Mouse Memoirs',sans-serif\">\n                    Amassado na chapa\n                </p>\n                <span class=\"h-1.5 w-1.5 rounded-full bg-zinc-300\" data-kid=\"1-2-1-3-2\" data-name=\"subheadline separator dot\">\n                </span>\n                <p class=\"text-xl uppercase tracking-tight md:text-3xl\" data-kid=\"1-2-1-3-3\" data-name=\"subheadline text\" style=\"font-family:'Mouse Memoirs',sans-serif\">\n                    Sabor brasileiro\n                </p>\n            </div>\n            <div class=\"relative z-10 mt-12 mb-8 w-full max-w-4xl\" data-kid=\"1-2-1-4\" data-name=\"burger image container\">\n                <div class=\"absolute inset-x-0 top-1/2 z-10 h-1/2 bg-gradient-to-t from-[#FAFAFA] to-transparent\" data-kid=\"1-2-1-4-1\" data-name=\"burger image overlay gradient\">\n                </div>\n                <img alt=\"Burger artesanal da Brasa Brava\" class=\"w-full object-contain drop-shadow-2xl transition-transform duration-700 hover:scale-[1.02]\" data-kid=\"1-2-1-4-2\" data-name=\"hero burger image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/burgerH.webp\"/>\n            </div>\n            <div class=\"relative z-20 flex w-full max-w-4xl flex-col justify-between gap-8 px-6 text-left text-sm font-medium text-zinc-500 md:flex-row\" data-kid=\"1-2-1-5\" data-name=\"hero description text container\">\n                <p class=\"max-w-xs tracking-tight\" data-kid=\"1-2-1-5-1\" data-name=\"hero description text\">\n                    Carne bovina fresca, prensada na chapa bem quente para criar aquela crosta dourada e manter toda a suculência.\n                </p>\n                <p class=\"max-w-xs tracking-tight md:text-right\" data-kid=\"1-2-1-5-2\" data-name=\"hero description text\">\n                    Queijo derretido, molho da casa e ingredientes de verdade — feitos para matar a fome com personalidade.\n                </p>\n            </div>\n        </section>\n        <section class=\"bg-[#F4EBE1] py-24 md:py-32\" data-kid=\"1-2-2\" data-name=\"history section\" id=\"historia\">\n            <div class=\"mx-auto flex max-w-7xl flex-col items-center px-6 text-center\" data-kid=\"1-2-2-1\" data-name=\"history content container\">\n                <p class=\"mb-4 text-2xl uppercase tracking-tight text-[#F91814]\" data-kid=\"1-2-2-1-1\" data-name=\"section subheader text\" style=\"font-family:'Mouse Memoirs',sans-serif\">\n                    A nossa essência\n                </p>\n                <h2 class=\"mb-8 text-4xl leading-tight tracking-tighter text-[#F91814] md:text-6xl\" data-kid=\"1-2-2-1-2\" data-name=\"section title\" style=\"font-family:Modak,system-ui\">\n                    BRASA DE VERDADE\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"line break element\"/>\n                    SEM FRESCURA\n                </h2>\n                <p class=\"mx-auto mb-10 max-w-xl text-sm font-medium leading-relaxed tracking-tight text-zinc-500\" data-kid=\"1-2-2-1-3\" data-name=\"section description text\">\n                    A Brasa Brava nasceu para transformar o clássico em ritual brasileiro: chapa quente, pão macio, molho marcante e um sabor que reúne a cidade em volta da mesa.\n                </p>\n                <a class=\"inline-flex items-center gap-2 rounded-full bg-[#F91814] px-7 py-3 text-xs font-medium uppercase tracking-tight text-