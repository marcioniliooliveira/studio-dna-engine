      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Modak&family=Mouse+Memoirs&display=swap');\n  html { scroll-behavior: smooth; }\n  body { margin: 0; background:#F4EBE1; color:#27272a; font-family:'Inter',sans-serif; -webkit-font-smoothing:antialiased; }\n  .reveal { opacity:0; transform:translateY(24px); transition:opacity .7s ease, transform .7s ease; }\n  .reveal.is-visible { opacity:1; transform:none; }\n  .parallax { will-change:transform; }\n</style>\n<script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\">\n</script>\n<div class=\"min-h-screen overflow-x-hidden bg-[#F4EBE1] text-zinc-800 selection:bg-[#F91814] selection:text-white\" data-kid=\"1\" data-name=\"page layout container\">\n    <nav class=\"fixed top-0 inset-x-0 z-50 bg-transparent\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <div class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navigation container\">\n            <a class=\"uppercase text-4xl text-[#F91814]\" data-kid=\"1-1-1-1\" data-name=\"logo text link\" href=\"#começo\" style=\"font-family:'Modak',system-ui;\">\n                PONTO\n            </a>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"navigation right group\">\n                <div class=\"hidden md:flex items-center gap-6\" data-kid=\"1-1-1-2-1\" data-name=\"desktop navigation menu\">\n                    <a class=\"text-xs font-medium tracking-tight text-zinc-500 hover:text-zinc-900 transition-colors uppercase\" data-kid=\"1-1-1-2-1-1\" data-name=\"navigation link\" href=\"#começo\">\n                        Começo\n                    </a>\n                    <a class=\"text-xs font-medium tracking-tight text-zinc-500 hover:text-zinc-900 transition-colors uppercase\" data-kid=\"1-1-1-2-1-2\" data-name=\"navigation link\" href=\"#historia\">\n                        Nossa história\n                    </a>\n                    <a class=\"text-xs font-medium tracking-tight text-zinc-500 hover:text-zinc-900 transition-colors uppercase\" data-kid=\"1-1-1-2-1-3\" data-name=\"navigation link\" href=\"#ingredientes\">\n                        Ingredientes\n                    </a>\n                    <a class=\"text-xs font-medium tracking-tight text-zinc-500 hover:text-zinc-900 transition-colors uppercase\" data-kid=\"1-1-1-2-1-4\" data-name=\"navigation link\" href=\"#unidades\">\n                        Unidades\n                    </a>\n                </div>\n                <a class=\"hidden md:inline-flex items-center justify-center text-xs uppercase tracking-tight font-medium text-white bg-[#F91814] hover:bg-red-700 px-5 py-2 rounded-full transition-all shadow-sm\" data-kid=\"1-1-1-2-2\" data-name=\"primary call-to-action button\" href=\"#pedido\">\n                    Ver o cardápio\n                </a>\n                <button aria-label=\"Abrir menu\" class=\"inline-flex items-center justify-center p-2 rounded-full hover:bg-zinc-100 transition-colors text-zinc-700 md:hidden text-xl\" data-kid=\"1-1-1-2-3\" data-name=\"mobile menu button\">\n                    <iconify-icon data-kid=\"1-1-1-2-3-1\" data-name=\"hamburger icon\" icon=\"solar:hamburger-menu-linear\" style=\"stroke-width:1.5;\">\n                    </iconify-icon>\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"page main content\">\n        <section class=\"relative pt-32 pb-20 md:pt-40 md:pb-32 flex flex-col items-center text-center px-6 overflow-hidden\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"começo\">\n            <div class=\"absolute inset-0 flex items-center justify-center -z-10 opacity-5 pointer-events-none select-none\" data-kid=\"1-2-1-1\" data-name=\"hero decorative background container\">\n                <span class=\"text-[25vw] leading-none text-[#F4A804]\" data-kid=\"1-2-1-1-1\" data-name=\"background decorative text\" style=\"font-family:'Modak',system-ui;\">\n                    PONTO\n                </span>\n            </div>\n            <p class=\"reveal text-2xl md:text-3xl tracking-tight uppercase text-[#F4A804]\" data-kid=\"1-2-1-2\" data-name=\"hero subheadline\" style=\"font-family:'Mouse Memoirs',sans-serif;\">\n                Franquia brasileira desde 2018\n            </p>\n            <h1 class=\"reveal text-6xl md:text-[10vw] leading-none text-[#F91814] tracking-tighter max-w-5xl mx-auto drop-shadow-sm\" data-kid=\"1-2-1-3\" data-name=\"hero main headline\" style=\"font-family:'Modak',system-ui;\">\n                FEITO NA BRASA\n            </h1>\n            <div class=\"flex items-center justify-center gap-4 mt-6 text-[#F4A804]\" data-kid=\"1-2-1-4\" data-name=\"hero highlight text group\">\n                <p class=\"text-xl md:text-3xl tracking-tight uppercase\" data-kid=\"1-2-1-4-1\" data-name=\"highlight text\" style=\"font-family:'Mouse Memoirs',sans-serif;\">\n                    Chapa quente\n                </p>\n                <span class=\"w-1.5 h-1.5 rounded-full bg-zinc-300\" data-kid=\"1-2-1-4-2\" data-name=\"separator dot\">\n                </span>\n                <p class=\"text-xl md:text-3xl tracking-tight uppercase\" data-kid=\"1-2-1-4-3\" data-name=\"highlight text\" style=\"font-family:'Mouse Memoirs',sans-serif;\">\n                    Sabor de verdade\n                </p>\n            </div>\n            <div class=\"relative w-full max-w-4xl mt-12 mb-8 z-10 parallax\" data-dynamic=\"true\" data-kid=\"1-2-1-5\" data-name=\"parallax burger image container\" data-reason=\"transform property updated on scroll by script\">\n                <div class=\"absolute inset-0 bg-gradient-to-t from-[#FAFAFA] via-transparent to-transparent z-10 top-1/2\" data-kid=\"1-2-1-5-1\" data-name=\"image gradient overlay\">\n                </div>\n                <img alt=\"Hambúrguer artesanal do Ponto da Brasa\" class=\"w-full h-auto drop-shadow-2xl hover:scale-[1.02] transition-transform duration-700 object-contain\" data-kid=\"1-2-1-5-2\" data-name=\"hero burger image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/burgerH.webp\"/>\n            </div>\n            <div class=\"flex flex-col md:flex-row justify-between w-full max-w-4xl gap-8 text-sm font-medium text-zinc-500 text-left px-6 relative z-20\" data-kid=\"1-2-1-6\" data-name=\"description text group\">\n                <p class=\"max-w-xs tracking-tight\" data-kid=\"1-2-1-6-1\" data-name=\"description text\">\n                    Carne prensada na chapa, crosta dourada e suculência em cada mordida. O clássico brasileiro com atitude.\n                </p>\n                <p class=\"max-w-xs md:text-right tracking-tight\" data-kid=\"1-2-1-6-2\" data-name=\"description text\">\n                    Pão macio, queijo derretido e molho da casa: feito na hora para matar a fome de verdade.\n                </p>\n            </div>\n        </section>\n        <section class=\"py-24 md:py-32 bg-[#F4EBE1]\" data-kid=\"1-2-2\" data-name=\"history section\" id=\"historia\">\n            <div class=\"max-w-7xl mx-auto px-6 flex flex-col items-center text-center\" data-kid=\"1-2-2-1\" data-name=\"history content container\">\n                <p class=\"text-2xl tracking-tight mb-4 uppercase text-[#F91814]\" data-kid=\"1-2-2-1-1\" data-name=\"section overline text\" style=\"font-family:'Mouse Memoirs',sans-serif;\">\n                    O nosso ponto\n                </p>\n                <h2 class=\"reveal text-4xl md:text-6xl tracking-tighter leading-tight mb-8 text-[#F91814]\" data-kid=\"1-2-2-1-2\" data-name=\"section title text\" style=\"font-family:'Modak',system-ui;\">\n                    BRASA, BRASIL\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"line break\"/>\n                    DO NOSSO JEITO\n                </h2>\n                <p class=\"max-w-xl mx-auto text-zinc-500 mb-10 text-sm font-medium tracking-tight leading-relaxed\" data-kid=\"1-2-2-1-3\" data-name=\"section body text\">\n                    O Ponto da Brasa nasceu para transformar o hambúrguer de rua em um ritual brasileiro: ingredientes honestos, chapa quente e uma energia que reúne todo mundo ao redor da mesa.\n                </p>\n                <a class=\"inline-flex items-center gap-2 text-white px-7 py-3 rounded-full font-medium text-xs uppercase tracking-tight transition-colors shadow-sm bg-[#F91814] hover:bg-red-700\" data-kid=\"1-2-2-1-4\" data-name=\"section call-to-action link\" href=\"#pedido\">\n                    Conheça o cardápio\n                    <iconify-icon data-kid=\"1-2-2-1-4-1\" data-name=\"arrow right icon\" icon=\"solar:arrow-right-linear\" style=\"stroke-width:1.5;\">\n                    </iconify-icon>\n                </a>\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mt-24 w-full max-w-5xl\" data-kid=\"1-2-2-1-5\" data-name=\"history image gallery grid\">\n                    <div class=\"rounded-3xl overflow-hidden h-72 md:h-96 w-full shadow-sm border border-zinc-100 group\" data-kid=\"1-2-2-1-5-1\" data-name=\"gallery image container\">\n                        <img alt=\"Equipe preparando hambúrguer\" class=\"h-full w-full object-cover group-hover:scale-105 transition-transform duration-700\" data-kid=\"1-2-2-1-5-1-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-1.webp\"/>\n                    </div>\n                    <div class=\"rounded-3xl overflow-hidden h-72 md:h-96 w-full shadow-sm border border-zinc-100 md:-mt-8 group relative z-10\" data-kid=\"1-2-2-1-5-2\" data-name=\"gallery image container\">\n                        <img alt=\"Queijo derretido no hambúrguer\" class=\"h-full w-full object-cover group-hover:scale-105 transition-transform duration-700\" data-kid=\"1-2-2-1-5-2-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-2.webp\"/>\n                    </div>\n                    <div class=\"rounded-3xl overflow-hidden h-72 md:h-96 w-full shadow-sm border border-zinc-100 group\" data-kid=\"1-2-2-1-5-3\" data-name=\"gallery image container\">\n                        <img alt=\"Ambiente descontraído da hamburgueria\" class=\"h-full w-full object-cover group-hover:scale-105 transition-transform duration-700\" data-kid=\"1-2-2-1-5-3-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-3.webp\"/>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"py-24 md:py-32 relative overflow-hidden bg-[#F91814]\" data-kid=\"1-2-3\" data-name=\"experience section\">\n            <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"1-2-3-1\" data-name=\"experience content container\">\n                <div class=\"text-center mb-16\" data-kid=\"1-2-3-1-1\" data-name=\"section header container\">\n                    <p class=\"text-xl md:text-2xl tracking-tight mb-4 uppercase text-white\" data-kid=\"1-2-3-1-1-1\" data-name=\"section overline text\" style=\"font-family:'Mouse Memoirs',sans-serif;\">\n                        A experiência\n                    </p>\n                    <h2 class=\"text-4xl md:text-5xl tracking-tighter leading-tight text-white\" data-kid=\"1-2-3-1-1-2\" data-name=\"section title text\" style=\"font-family:'Modak',system-ui;\">\n                        UMA FOME QUE FAZ BEM\n                    </h2>\n                </div>\n                <div class=\"flex flex-col md:flex-row items-center justify-between gap-12 mt-12 relative\" data-kid=\"1-2-3-1-2\" data-name=\"experience features layout container\">\n                    <div class=\"flex flex-col gap-6 text-xs uppercase tracking-tight font-medium md:w-1/4 text-white\" data-kid=\"1-2-3-1-2-1\" data-name=\"feature list left column\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"feature item\">\n                            <iconify-icon class=\"text-lg text-white\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"feature icon\" icon=\"solar:fire-linear\">\n                            </iconify-icon>\n                            <span data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"feature label\">\n                                450 kcal de sabor\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"feature item\">\n                            <iconify-icon class=\"text-lg text-white\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"feature icon\" icon=\"solar:dumbbell-linear\">\n                            </iconify-icon>\n                            <span data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"feature label\">\n                                Proteína de verdade\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"feature item\">\n                            <iconify-icon class=\"text-lg text-white\" data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"feature icon\" icon=\"solar:leaf-linear\">\n                            </iconify-icon>\n                            <span data-kid=\"1-2-3-1-2-1-3-2\" data-name=\"feature label\">\n                                Ingredientes frescos\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"md:w-2/4 relative flex justify-center z-10\" data-kid=\"1-2-3-1-2-2\" data-name=\"center image container\">\n                        <img alt=\"Hambúrguer sendo servido\" class=\"w-full max-w-[280px] md:max-w-[400px] drop-shadow-xl\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"experience burger image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/burgerwithhands.webp\"/>\n                    </div>\n                    <div class=\"flex flex-col gap-6 text-xs uppercase tracking-tight font-medium md:w-1/4 md:items-end text-white\" data-kid=\"1-2-3-1-2-3\" data-name=\"feature list right column\">\n                        <div class=\"flex items-center gap-3 flex-row-reverse md:flex-row\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"feature item\">\n                            <span data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"feature label\">\n                                100% Brasil\n                            </span>\n                            <iconify-icon class=\"text-lg text-white\" data-kid=\"1-2-3-1-2-3-1-2\" data-name=\"feature icon\" icon=\"solar:shield-check-linear\">\n                            </iconify-icon>\n                        </div>\n                        <div class=\"flex items-center gap-3 flex-row-reverse md:flex-row\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"feature item\">\n                            <span data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"feature label\">\n                                Sem complicação\n                            </span>\n                            <iconify-icon class=\"text-lg text-white\" data-kid=\"1-2-3-1-2-3-2-2\" data-name=\"feature icon\" icon=\"solar:heart-linear\">\n                            </iconify-icon>\n                        </div>\n                        <div class=\"flex items-center gap-3 flex-row-reverse md:flex-row\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"feature item\">\n                            <span data-kid=\"1-2-3-1-2-3-3-1\" data-name=\"feature label\">\n                                Sabor marcante\n                            </span>\n                            <iconify-icon class=\"text-lg text-white\" data-kid=\"1-2-3-1-2-3-3-2\" data-name=\"feature icon\" icon=\"solar:star-linear\">\n                            </iconify-icon>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"py-24 md:py-32 bg-[#F4EBE1]\" data-kid=\"1-2-4\" data-name=\"ingredients section\" id=\"ingredientes\">\n            <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"1-2-4-1\" data-name=\"ingredients content container\">\n                <div class=\"text-center mb-16\" data-kid=\"1-2-4-1-1\" data-name=\"section header container\">\n                    <h2 class=\"text-4xl md:text-5xl tracking-tighter mb-4 text-[#F91814]\" data-kid=\"1-2-4-1-1-1\" data-name=\"section title text\" style=\"font-family:'Modak',system-ui;\">\n                        QUALIDADE NA BRASA\n                    </h2>\n                    <h3 class=\"text-xl md:text-2xl font-medium tracking-tight text-[#F91814]\" data-kid=\"1-2-4-1-1-2\" data-name=\"section subtitle text\">\n                        Cada camada tem uma história para contar\n                    </h3>\n                </div>\n                <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mt-12\" data-kid=\"1-2-4-1-2\" data-name=\"ingredients grid\">\n                    <div class=\"rounded-3xl p-8 flex flex-col items-center text-center\" data-kid=\"1-2-4-1-2-1\" data-name=\"ingredient card\">\n                        <img alt=\"Tomate fresco\" class=\"w-24 h-24 md:w-32 md:h-32 object-contain drop-shadow-md mb-6 hover:scale-110 transition-transform duration-500\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/tomato.webp\"/>\n                        <h4 class=\"tracking-tight text-[#F91814] font-bold text-lg\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"ingredient name\">\n                            Tomate da horta\n                        </h4>\n                    </div>\n                    <div class=\"rounded-3xl p-8 flex flex-col items-center text-center md:translate-y-4\" data-kid=\"1-2-4-1-2-2\" data-name=\"ingredient card\">\n                        <img alt=\"Queijo premium\" class=\"w-24 h-24 md:w-32 md:h-32 object-contain drop-shadow-md mb-6 hover:scale-110 transition-transform duration-500\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/cheese.webp\"/>\n                        <h4 class=\"tracking-tight text-[#F91814] font-bold text-lg\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"ingredient name\">\n                            Queijo bem cremoso\n                        </h4>\n                    </div>\n                    <div class=\"rounded-3xl p-8 flex flex-col items-center text-center\" data-kid=\"1-2-4-1-2-3\" data-name=\"ingredient card\">\n                        <img alt=\"Carne bovina prensada\" class=\"w-24 h-24 md:w-32 md:h-32 object-contain drop-shadow-md mb-6 hover:scale-110 transition-transform duration-500\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/meat.webp\"/>\n                        <h4 class=\"tracking-tight text-[#F91814] font-bold text-lg\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"ingredient name\">\n                            Blend da casa\n                        </h4>\n                    </div>\n                    <div class=\"rounded-3xl p-8 flex flex-col items-center text-center md:translate-y-4\" data-kid=\"1-2-4-1-2-4\" data-name=\"ingredient card\">\n                        <img alt=\"Alface crocante\" class=\"w-24 h-24 md:w-32 md:h-32 object-contain drop-shadow-md mb-6 hover:scale-110 transition-transform duration-500\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"ingredient image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/lettuce.webp\"/>\n                        <h4 class=\"tracking-tight text-[#F91814] font-bold text-lg\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"ingredient name\">\n                            Frescor crocante\n                        </h4>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"py-24 md:py-32 bg-[#F9CD25]\" data-kid=\"1-2-5\" data-name=\"locations section\" id=\"unidades\">\n            <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row gap-16 md:gap-8 items-start\" data-kid=\"1-2-5-1\" data-name=\"locations layout container\">\n                <div class=\"md:w-1/3 sticky top-32\" data-kid=\"1-2-5-1-1\" data-name=\"locations header container\">\n                    <p class=\"text-2xl uppercase tracking-tight mb-4 text-white\" data-kid=\"1-2-5-1-1-1\" data-name=\"section overline text\" style=\"font-family:'Mouse Memoirs',sans-serif;\">\n                        Chega mais\n                    </p>\n                    <h2 class=\"text-4xl md:text-5xl tracking-tighter mb-6 leading-tight text-white\" data-kid=\"1-2-5-1-1-2\" data-name=\"section title text\" style=\"font-family:'Modak',system-ui;\">\n                        UM PONTO PERTO DE VOCÊ\n                    </h2>\n                    <p class=\"text-sm font-medium leading-relaxed max-w-sm text-white font-semibold\" data-kid=\"1-2-5-1-1-3\" data-name=\"section description text\">\n                        Da primeira mordida ao último gole, encontre o Ponto da Brasa em cidades que sabem comer bem.\n                    </p>\n                </div>\n                <div class=\"md:w-2/3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\" data-kid=\"1-2-5-1-2\" data-name=\"locations grid\">\n                    <div class=\"rounded-[2rem] hover:-translate-y-1 transition-transform duration-300\" data-kid=\"1-2-5-1-2-1\" data-name=\"location card\">\n                        <img alt=\"Unidade Campinas\" class=\"rounded-3xl w-full aspect-[4/5] object-cover mb-4 shadow-sm\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"location image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/berlin.webp\"/>\n                        <p class=\"text-center text-xl tracking-tight pb-2 text-[#F91814]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"location name\" style=\"font-family:'Modak',system-ui;\">\n                            CAMPINAS\n                        </p>\n                    </div>\n                    <div class=\"rounded-[2rem] hover:-translate-y-1 transition-transform duration-300 md:mt-8\" data-kid=\"1-2-5-1-2-2\" data-name=\"location card\">\n                        <img alt=\"Unidade Salvador\" class=\"rounded-3xl w-full aspect-[4/5] object-cover mb-4 shadow-sm\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"location image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/london.webp\"/>\n                        <p class=\"text-center text-xl tracking-tight pb-2 text-[#F91814]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"location name\" style=\"font-family:'Modak',system-ui;\">\n                            SALVADOR\n                        </p>\n                    </div>\n                    <div class=\"rounded-[2rem] hover:-translate-y-1 transition-transform duration-300\" data-kid=\"1-2-5-1-2-3\" data-name=\"location card\">\n                        <img alt=\"Unidade Goiânia\" class=\"rounded-3xl w-full aspect-[4/5] object-cover mb-4 shadow-sm\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"location image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/newyork.webp\"/>\n                        <p class=\"text-center text-xl tracking-tight pb-2 text-[#F91814]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"location name\" style=\"font-family:'Modak',system-ui;\">\n                            GOIÂNIA\n                        </p>\n                    </div>\n                    <div class=\"rounded-[2rem] hover:-translate-y-1 transition-transform duration-300 md:-mt-8\" data-kid=\"1-2-5-1-2-4\" data-name=\"location card\">\n                        <img alt=\"Unidade Florianópolis\" class=\"rounded-3xl w-full aspect-[4/5] object-cover mb-4 shadow-sm\" data-kid=\"1-2-5-1-2-4-1\" data-name=\"location image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/sydney.webp\"/>\n                        <p class=\"text-center text-xl tracking-tight pb-2 text-[#F91814]\" data-kid=\"1-2-5-1-2-4-2\" data-name=\"location name\" style=\"font-family:'Modak',system-ui;\">\n                            FLORIPA\n                        </p>\n                    </div>\n                    <div class=\"rounded-[2rem] hover:-translate-y-1 transition-transform duration-300\" data-kid=\"1-2-5-1-2-5\" data-name=\"location card\">\n                        <img alt=\"Unidade Brasília\" class=\"rounded-3xl w-full aspect-[4/5] object-cover mb-4 shadow-sm\" data-kid=\"1-2-5-1-2-5-1\" data-name=\"location image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/tokyo.webp\"/>\n                        <p class=\"text-center text-xl tracking-tight pb-2 text-[#F91814]\" data-kid=\"1-2-5-1-2-5-2\" data-name=\"location name\" style=\"font-family:'Modak',system-ui;\">\n                            BRASÍLIA\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"py-24 md:py-32 relative overflow-hidden bg-[#F4EBE1]\" data-kid=\"1-2-6\" data-name=\"call-to-action section\" id=\"pedido\">\n            <div class=\"max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-center gap-12 md:gap-20\" data-kid=\"1-2-6-1\" data-name=\"cta content container\">\n                <div class=\"md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left\" data-kid=\"1-2-6-1-1\" data-name=\"cta text column\">\n                    <p class=\"text-xl md:text-2xl tracking-tight mb-4 uppercase text-[#F91814]\" data-kid=\"1-2-6-1-1-1\" data-name=\"section overline text\" style=\"font-family:'Mouse Memoirs',sans-serif;\">\n                        Bateu a fome?\n                    </p>\n                    <h2 class=\"text-5xl md:text-7xl tracking-tighter text-[#F91814] leading-none mb-8\" data-kid=\"1-2-6-1-1-2\" data-name=\"section title text\" style=\"font-family:'Modak',system-ui;\">\n                        SINTA A\n                        <br data-kid=\"1-2-6-1-1-2-1\" data-name=\"line break\"/>\n                        DIFERENÇA\n                    </h2>\n                    <p class=\"text-sm text-zinc-500 mb-10 font-medium leading-relaxed max-w-sm\" data-kid=\"1-2-6-1-1-3\" data-name=\"section description text\">\n                        Prensado para quem tem fome, criado para quem gosta de sabor. Seu próximo hambúrguer inesquecível começa aqui.\n                    </p>\n                    <a class=\"inline-flex items-center gap-2 bg-[#F91814] text-white px-8 py-3.5 rounded-full font-medium text-xs uppercase tracking-tight hover:bg-red-700 transition-colors shadow-md shadow-red-500/20\" data-kid=\"1-2-6-1-1-4\" data-name=\"primary call-to-action button\" href=\"#newsletter\">\n                        Pedir agora\n                        <iconify-icon data-kid=\"1-2-6-1-1-4-1\" data-name=\"arrow right icon\" icon=\"solar:arrow-right-linear\">\n                        </iconify-icon>\n                    </a>\n                </div>\n                <div class=\"md:w-1/2 w-full relative\" data-kid=\"1-2-6-1-2\" data-name=\"cta image column\">\n                    <div class=\"absolute inset-0 bg-gradient-to-tr from-zinc-100 to-transparent rounded-[2rem] -z-10 translate-x-4 translate-y-4\" data-kid=\"1-2-6-1-2-1\" data-name=\"decorative background layer\">\n                    </div>\n                    <img alt=\"Hambúrguer artesanal premium\" class=\"rounded-[2rem] shadow-xl object-cover aspect-[4/5] w-full border border-zinc-100\" data-kid=\"1-2-6-1-2-2\" data-name=\"cta image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/cta.webp\"/>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"pt-20 pb-12 mt-auto text-white border-t bg-[#2C1608] border-[#40220D]\" data-kid=\"1-3\" data-name=\"footer section\" id=\"newsletter\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"1-3-1\" data-name=\"footer content wrapper\">\n            <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 mb-16\" data-kid=\"1-3-1-1\" data-name=\"footer main grid\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n                    <a class=\"uppercase text-5xl text-[#F91814] block mb-6 drop-shadow-sm\" data-kid=\"1-3-1-1-1-1\" data-name=\"logo text link\" href=\"#começo\" style=\"font-family:'Modak',system-ui;\">\n                        PONTO\n                    </a>\n                    <p class=\"text-sm text-zinc-400 font-medium leading-relaxed tracking-tight mb-6\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer brand description\">\n                        Hambúrguer de verdade, feito na brasa e servido do nosso jeito desde 2018.\n                    </p>\n                    <div class=\"flex items-center gap-4 text-zinc-400\" data-kid=\"1-3-1-1-1-3\" data-name=\"social media links\">\n                        <a aria-label=\"Instagram\" class=\"hover:text-white transition-colors text-2xl\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"social media link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-1-1\" data-name=\"social icon\" icon=\"mdi:instagram\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"Facebook\" class=\"hover:text-white transition-colors text-2xl\" data-kid=\"1-3-1-1-1-3-2\" data-name=\"social media link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-2-1\" data-name=\"social icon\" icon=\"mdi:facebook\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"TikTok\" class=\"hover:text-white transition-colors text-2xl\" data-kid=\"1-3-1-1-1-3-3\" data-name=\"social media link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-3-1\" data-name=\"social icon\" icon=\"mdi:music-note\">\n                            </iconify-icon>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"md:pl-8\" data-kid=\"1-3-1-1-2\" data-name=\"footer navigation column\">\n                    <h4 class=\"text-white font-bold tracking-tight mb-6 uppercase text-sm\" data-kid=\"1-3-1-1-2-1\" data-name=\"column header\">\n                        Navegação\n                    </h4>\n                    <div class=\"flex flex-col gap-4\" data-kid=\"1-3-1-1-2-2\" data-name=\"navigation link list\">\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"footer navigation link\" href=\"#começo\">\n                            Começo\n                        </a>\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"footer navigation link\" href=\"#historia\">\n                            Nossa história\n                        </a>\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-2-2-3\" data-name=\"footer navigation link\" href=\"#ingredientes\">\n                            Ingredientes\n                        </a>\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-2-2-4\" data-name=\"footer navigation link\" href=\"#unidades\">\n                            Unidades\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"footer information column\">\n                    <h4 class=\"text-white font-bold tracking-tight mb-6 uppercase text-sm\" data-kid=\"1-3-1-1-3-1\" data-name=\"column header\">\n                        Informações\n                    </h4>\n                    <div class=\"flex flex-col gap-4\" data-kid=\"1-3-1-1-3-2\" data-name=\"footer navigation link list\">\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"footer navigation link\" href=\"#pedido\">\n                            Nosso cardápio\n                        </a>\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"footer navigation link\" href=\"#\">\n                            Perguntas frequentes\n                        </a>\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"footer navigation link\" href=\"#\">\n                            Contato\n                        </a>\n                        <a class=\"text-sm text-zinc-400 hover:text-[#F91814] transition-colors\" data-kid=\"1-3-1-1-3-2-4\" data-name=\"footer navigation link\" href=\"#\">\n                            Seja um franqueado\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"newsletter signup column\">\n                    <h4 class=\"text-white font-bold tracking-tight mb-6 uppercase text-sm\" data-kid=\"1-3-1-1-4-1\" data-name=\"column header\">\n                        Clube da Brasa\n                    </h4>\n                    <p class=\"text-sm text-zinc-400 font-medium leading-relaxed tracking-tight mb-4\" data-kid=\"1-3-1-1-4-2\" data-name=\"newsletter description\">\n                        Receba novidades, lançamentos e cupons direto no seu e-mail.\n                    </p>\n                    <form class=\"flex flex-col gap-3\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter form\" onsubmit=\"event.preventDefault();\">\n                        <input aria-label=\"Seu melhor e-mail\" class=\"w-full border rounded-full px-5 py-3 text-sm text-white placeholder:text-zinc-500 focus:outline-none focus:border-[#F91814] bg-[#40220D] border-[#583115]\" data-kid=\"1-3-1-1-4-3-1\" data-name=\"email input field\" placeholder=\"Seu melhor e-mail\" required=\"\" type=\"email\"/>\n                        <button class=\"w-full bg-[#F91814] text-white px-5 py-3 rounded-full font-semibold text-xs uppercase tracking-tight hover:bg-red-700 transition-colors shadow-sm\" data-kid=\"1-3-1-1-4-3-2\" data-name=\"newsletter subscribe button\" type=\"submit\">\n                            Quero participar\n                        </button>\n                    </form>\n                </div>\n            </div>\n            <div class=\"pt-8 border-t flex flex-col md:flex-row items-center justify-between gap-4 border-[#40220D]\" data-kid=\"1-3-1-2\" data-name=\"footer bottom row\">\n                <p class=\"text-xs font-medium tracking-tight text-zinc-500\" data-kid=\"1-3-1-2-1\" data-name=\"copyright text\">\n                    © 2026 PONTO DA BRASA — Todos os direitos reservados.\n                </p>\n                <div class=\"flex gap-4\" data-kid=\"1-3-1-2-2\" data-name=\"legal links container\">\n                    <a class=\"text-xs font-medium tracking-tight text-zinc-500 hover:text-zinc-300\" data-kid=\"1-3-1-2-2-1\" data-name=\"legal link\" href=\"#\">\n                        Privacidade\n                    </a>\n                    <a class=\"text-xs font-medium tracking-tight text-zinc-500 hover:text-zinc-300\" data-kid=\"1-3-1-2-2-2\" data-name=\"legal link\" href=\"#\">\n                        Termos\n                    </a>\n                </div>\n            </div>\n            <div class=\"mt-16 flex justify-center overflow-hidden\" data-kid=\"1-3-1-3\" data-name=\"footer background logo container\">\n                <h2 class=\"text-[25vw] md:text-[15vw] leading-none tracking-tighter select-none text-[#F91814]\" data-kid=\"1-3-1-3-1\" data-name=\"background logo text\" style=\"font-family:'Modak',system-ui;\">\n                    PONTO\n                </h2>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('is-visible'); }), { threshold: .12 });\n  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));\n  const hero = document.querySelector('.parallax');\n  window.addEventListener('scroll', () => { if (hero && window.scrollY < 900) hero.style.transform = `translateY(${window.scrollY * .06}px)`; }, { passive:true });\n</script>\n",
