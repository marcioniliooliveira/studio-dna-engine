        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Modak&family=Mouse+Memoirs&display=swap');\nhtml{scroll-behavior:smooth}body{margin:0;background:#F4EBE1;color:#2C1608;font-family:Inter, sans-serif}.display{font-family:Modak,system-ui}.accent{font-family:'Mouse Memoirs',sans-serif;letter-spacing:.02em}.copy{color:#5d5149;line-height:1.65}.focus-ring:focus-visible{outline:3px solid #F9CD25;outline-offset:4px}.reveal{transform:translateY(10px);transition:transform .55s ease}.reveal.is-visible{transform:none}.faq-answer{display:none}.faq-item.open .faq-answer{display:block}.faq-item.open .faq-chevron{transform:rotate(180deg)}#suporte [class~=\"text-white\"]{color:#2C1608!important}#suporte [class~=\"text-white/85\"]{color:rgba(44,22,8,.8)!important}#suporte [class~=\"text-white/80\"]{color:rgba(44,22,8,.76)!important}#onde-estamos p.font-bold{color:#2C1608!important}#candidatura input:not([type=\"checkbox\"]),#candidatura select{border-radius:12px!important;border-color:#b9a99b!important}#candidatura label.flex{font-size:.875rem;line-height:1.4}\n</style>\n<script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\">\n</script>\n<div class=\"min-h-screen overflow-x-hidden bg-[#F4EBE1]\" data-kid=\"1\" id=\"top\">\n    <nav class=\"fixed inset-x-0 top-0 z-50 bg-[#F4EBE1]/90 backdrop-blur-sm\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-20 max-w-7xl items-center justify-between px-6\" data-kid=\"1-1-1\">\n            <a class=\"display text-3xl uppercase text-[#F91814] focus-ring\" data-kid=\"1-1-1-1\" href=\"#top\">\n                VILA SMASH\n            </a>\n            <div class=\"hidden items-center gap-7 md:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"focus-ring text-xs font-semibold uppercase text-[#5d5149]\" data-kid=\"1-1-1-2-1\" href=\"#marca\">\n                    A marca\n                </a>\n                <a class=\"focus-ring text-xs font-semibold uppercase text-[#5d5149]\" data-kid=\"1-1-1-2-2\" href=\"#modelo\">\n                    Como funciona\n                </a>\n                <a class=\"focus-ring text-xs font-semibold uppercase text-[#5d5149]\" data-kid=\"1-1-1-2-3\" href=\"#suporte\">\n                    Suporte\n                </a>\n                <a class=\"focus-ring text-xs font-semibold uppercase text-[#5d5149]\" data-kid=\"1-1-1-2-4\" href=\"#onde-estamos\">\n                    Onde estamos\n                </a>\n                <a class=\"focus-ring rounded-full bg-[#F91814] px-5 py-3 text-xs font-bold uppercase text-white\" data-kid=\"1-1-1-2-5\" href=\"#candidatura\">\n                    Quero ser franqueado\n                </a>\n            </div>\n            <button aria-expanded=\"false\" aria-label=\"Abrir menu\" class=\"focus-ring rounded-full p-3 text-2xl md:hidden\" data-dynamic=\"true\" data-kid=\"1-1-1-3\" data-name=\"mobile menu toggle button\" data-reason=\"aria-expanded attribute toggled by script\" id=\"menu-toggle\">\n                <iconify-icon data-kid=\"1-1-1-3-1\" icon=\"solar:hamburger-menu-linear\">\n                </iconify-icon>\n            </button>\n        </div>\n        <div class=\"hidden border-t border-[#ead8c8] bg-[#F4EBE1] px-6 pb-6 md:hidden\" data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"mobile navigation menu\" data-reason=\"hidden class toggled by script\" id=\"mobile-menu\">\n            <div class=\"flex flex-col gap-4 pt-5\" data-kid=\"1-1-2-1\">\n                <a class=\"text-sm font-semibold uppercase\" data-kid=\"1-1-2-1-1\" href=\"#marca\">\n                    A marca\n                </a>\n                <a class=\"text-sm font-semibold uppercase\" data-kid=\"1-1-2-1-2\" href=\"#modelo\">\n                    Como funciona\n                </a>\n                <a class=\"text-sm font-semibold uppercase\" data-kid=\"1-1-2-1-3\" href=\"#suporte\">\n                    Suporte\n                </a>\n                <a class=\"text-sm font-semibold uppercase\" data-kid=\"1-1-2-1-4\" href=\"#onde-estamos\">\n                    Onde estamos\n                </a>\n                <a class=\"rounded-full bg-[#F91814] px-5 py-3 text-center text-xs font-bold uppercase text-white\" data-kid=\"1-1-2-1-5\" href=\"#candidatura\">\n                    Quero ser franqueado\n                </a>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\">\n        <section class=\"relative overflow-hidden px-6 pb-24 pt-36 text-center md:pb-28 md:pt-44\" data-kid=\"1-2-1\">\n            <div class=\"pointer-events-none absolute inset-0 flex items-center justify-center opacity-5\" data-kid=\"1-2-1-1\">\n                <span class=\"display text-[24vw] leading-none text-[#F4A804]\" data-kid=\"1-2-1-1-1\">\n                    VILA\n                </span>\n            </div>\n            <p class=\"accent relative mb-4 text-2xl uppercase text-[#F4A804]\" data-kid=\"1-2-1-2\">\n                Franquia fictícia para estudo de conceito\n            </p>\n            <h1 class=\"display relative mx-auto max-w-6xl text-6xl leading-none tracking-tight text-[#F91814] md:text-[9vw]\" data-kid=\"1-2-1-3\">\n                O SMASH QUE VIROU NEGÓCIO\n            </h1>\n            <p class=\"accent mt-7 text-2xl uppercase text-[#F4A804] md:text-4xl\" data-kid=\"1-2-1-4\">\n                Crosta dourada\n                <span class=\"text-[#d7c8bb]\" data-kid=\"1-2-1-4-1\">\n                    •\n                </span>\n                vontade de crescer\n            </p>\n            <div class=\"relative mx-auto mt-10 max-w-4xl\" data-kid=\"1-2-1-5\">\n                <img alt=\"Hambúrguer artesanal VILA SMASH\" class=\"w-full object-contain drop-shadow-xl\" data-kid=\"1-2-1-5-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/burgerH.webp\"/>\n            </div>\n            <div class=\"mx-auto mt-3 grid max-w-5xl gap-8 text-left md:grid-cols-2\" data-kid=\"1-2-1-6\">\n                <p class=\"copy text-sm\" data-kid=\"1-2-1-6-1\">\n                    A VILA nasceu para quem ama comida de verdade — e quer transformar esse amor em uma operação que cabe no dia a dia.\n                </p>\n                <p class=\"copy text-sm md:text-right\" data-kid=\"1-2-1-6-2\">\n                    Um modelo íntimo no balcão, claro nos processos e feito para repetir a experiência sem perder o gosto de casa.\n                </p>\n            </div>\n            <div class=\"mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row\" data-kid=\"1-2-1-7\">\n                <a class=\"focus-ring rounded-full bg-[#F91814] px-7 py-4 text-xs font-bold uppercase text-white\" data-kid=\"1-2-1-7-1\" data-name=\"hero primary call-to-action button\" href=\"#candidatura\">\n                    Quero abrir uma VILA\n                    <iconify-icon class=\"ml-2 align-middle\" data-kid=\"1-2-1-7-1-1\" icon=\"solar:arrow-right-linear\">\n                    </iconify-icon>\n                </a>\n                <a class=\"focus-ring px-4 py-3 text-xs font-bold uppercase text-[#F91814] underline decoration-[#F91814]/30 underline-offset-4\" data-kid=\"1-2-1-7-2\" href=\"#modelo\">\n                    Conhecer o modelo\n                </a>\n            </div>\n        </section>\n        <section class=\"px-6 py-20 md:py-24\" data-kid=\"1-2-2\" id=\"marca\">\n            <div class=\"mx-auto grid max-w-7xl gap-12 md:grid-cols-[.85fr_1.15fr] md:items-center\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <p class=\"accent mb-3 text-2xl uppercase text-[#F91814]\" data-kid=\"1-2-2-1-1-1\">\n                        A nossa casa\n                    </p>\n                    <h2 class=\"display text-5xl leading-none text-[#F91814] md:text-6xl\" data-kid=\"1-2-2-1-1-2\">\n                        UMA CASA GOSTOSA DE VISITAR. UM MODELO SIMPLES DE OPERAR.\n                    </h2>\n                    <p class=\"copy mt-7 max-w-lg text-base\" data-kid=\"1-2-2-1-1-3\">\n                        A VILA é pequena no gesto e grande na lembrança: cardápio que não confunde, montagem que se aprende e uma experiência que o cliente reconhece na próxima visita.\n                    </p>\n                    <p class=\"copy mt-4 max-w-lg text-base\" data-kid=\"1-2-2-1-1-4\">\n                        Para quem franqueia, isso significa menos improviso na rotina, mais clareza para treinar a equipe e um jeito consistente de cuidar de cada pedido.\n                    </p>\n                    <a class=\"focus-ring mt-7 inline-flex rounded-full border-2 border-[#F91814] px-6 py-3 text-xs font-bold uppercase text-[#F91814]\" data-kid=\"1-2-2-1-1-5\" href=\"#suporte\">\n                        Ver como a gente acompanha\n                        <iconify-icon class=\"ml-2\" data-kid=\"1-2-2-1-1-5-1\" icon=\"solar:arrow-right-linear\">\n                        </iconify-icon>\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-2 gap-4 md:grid-cols-3\" data-kid=\"1-2-2-1-2\">\n                    <img alt=\"Equipe preparando hambúrguer\" class=\"h-72 w-full rounded-3xl object-cover md:h-96\" data-kid=\"1-2-2-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-1.webp\"/>\n                    <img alt=\"Hambúrguer com queijo derretido\" class=\"mt-8 h-72 w-full rounded-3xl object-cover md:h-96\" data-kid=\"1-2-2-1-2-2\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-2.webp\"/>\n                    <img alt=\"Ambiente da hamburgueria\" class=\"col-span-2 h-64 w-full rounded-3xl object-cover md:col-span-1 md:h-96\" data-kid=\"1-2-2-1-2-3\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/about-3.webp\"/>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#F91814] px-6 py-20 text-white md:py-24\" data-kid=\"1-2-3\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-3-1\">\n                <div class=\"mx-auto max-w-3xl text-center\" data-kid=\"1-2-3-1-1\">\n                    <p class=\"accent text-2xl uppercase\" data-kid=\"1-2-3-1-1-1\">\n                        A oportunidade\n                    </p>\n                    <h2 class=\"display mt-3 text-5xl leading-none md:text-6xl\" data-kid=\"1-2-3-1-1-2\">\n                        UM NEGÓCIO COM CHEIRO DE CASA\n                    </h2>\n                    <p class=\"mt-5 text-sm text-white/85\" data-kid=\"1-2-3-1-1-3\">\n                        A força está no que é fácil de reconhecer e possível de repetir.\n                        <span class=\"font-semibold\" data-kid=\"1-2-3-1-1-3-1\">\n                            Indicadores abaixo são ilustrativos para este estudo.\n                        </span>\n                    </p>\n                </div>\n                <div class=\"mt-14 grid items-center gap-10 md:grid-cols-[1fr_1.1fr_1fr]\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"space-y-8\" data-kid=\"1-2-3-1-2-1\">\n                        <div class=\"flex gap-4\" data-kid=\"1-2-3-1-2-1-1\">\n                            <iconify-icon class=\"text-3xl\" data-kid=\"1-2-3-1-2-1-1-1\" icon=\"solar:checklist-minimalistic-linear\">\n                            </iconify-icon>\n                            <div data-kid=\"1-2-3-1-2-1-1-2\">\n                                <h3 class=\"font-bold uppercase\" data-kid=\"1-2-3-1-2-1-1-2-1\">\n                                    Cardápio enxuto\n                                </h3>\n                                <p class=\"mt-1 text-sm text-white/80\" data-kid=\"1-2-3-1-2-1-1-2-2\">\n                                    Menos itens parados, mais velocidade no pico.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex gap-4\" data-kid=\"1-2-3-1-2-1-2\">\n                            <iconify-icon class=\"text-3xl\" data-kid=\"1-2-3-1-2-1-2-1\" icon=\"solar:chef-hat-linear\">\n                            </iconify-icon>\n                            <div data-kid=\"1-2-3-1-2-1-2-2\">\n                                <h3 class=\"font-bold uppercase\" data-kid=\"1-2-3-1-2-1-2-2-1\">\n                                    Operação treinada\n                                </h3>\n                                <p class=\"mt-1 text-sm text-white/80\" data-kid=\"1-2-3-1-2-1-2-2-2\">\n                                    Rotina ensinada no detalhe, sem receita escondida.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <img alt=\"Hambúrguer nas mãos\" class=\"mx-auto w-full max-w-sm object-contain\" data-kid=\"1-2-3-1-2-2\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/burgerwithhands.webp\"/>\n                    <div class=\"space-y-8 md:text-right\" data-kid=\"1-2-3-1-2-3\">\n                        <div class=\"flex gap-4 md:flex-row-reverse\" data-kid=\"1-2-3-1-2-3-1\">\n                            <iconify-icon class=\"text-3xl\" data-kid=\"1-2-3-1-2-3-1-1\" icon=\"solar:refresh-circle-linear\">\n                            </iconify-icon>\n                            <div data-kid=\"1-2-3-1-2-3-1-2\">\n                                <h3 class=\"font-bold uppercase\" data-kid=\"1-2-3-1-2-3-1-2-1\">\n                                    Marca que chama de volta\n                                </h3>\n                                <p class=\"mt-1 text-sm text-white/80\" data-kid=\"1-2-3-1-2-3-1-2-2\">\n                                    Produto marcante para criar hábito, não só visita.\n                                </p>\n                            </div>\n                        </div>\n                        <a class=\"focus-ring inline-flex rounded-full bg-white px-6 py-3 text-xs font-bold uppercase text-[#F91814]\" data-kid=\"1-2-3-1-2-3-2\" href=\"#candidatura\">\n                            Quero entender a oportunidade\n                        </a>\n                    </div>\n                </div>\n                <div class=\"mt-14 grid gap-4 border-t border-white/35 pt-7 md:grid-cols-[1.25fr_1fr_1fr]\" data-kid=\"1-2-3-1-3\" data-name=\"investment and timeline stats container\">\n                    <div class=\"rounded-3xl bg-white p-6 text-[#2C1608] md:p-7\" data-kid=\"1-2-3-1-3-1\" data-name=\"investment card\">\n                        <p class=\"accent text-2xl uppercase text-[#F91814]\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"investment card label\">\n                            Ponto de partida\n                        </p>\n                        <p class=\"mt-2 text-4xl font-bold leading-none tracking-tight md:text-5xl\" data-kid=\"1-2-3-1-3-1-2\" data-name=\"investment card amount\">\n                            R$ 280 mil*\n                        </p>\n                        <p class=\"mt-2 text-xs font-semibold uppercase text-[#6d5e53]\" data-kid=\"1-2-3-1-3-1-3\" data-name=\"investment card subtext\">\n                            investimento estimado para uma unidade\n                        </p>\n                    </div>\n                    <div class=\"border-t border-white/35 pt-5 md:border-l md:border-t-0 md:pl-6 md:pt-0\" data-kid=\"1-2-3-1-3-2\" data-name=\"opening timeline stats\">\n                        <p class=\"text-3xl font-bold leading-none md:text-4xl\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"opening timeline value\">\n                            90 dias*\n                        </p>\n                        <p class=\"mt-2 text-sm text-white/85\" data-kid=\"1-2-3-1-3-2-2\" data-name=\"opening timeline label\">\n                            estimativa entre implantação e abertura\n                        </p>\n                    </div>\n                    <div class=\"border-t border-white/35 pt-5 md:border-l md:border-t-0 md:pl-6 md:pt-0\" data-kid=\"1-2-3-1-3-3\" data-name=\"pilot city stats\">\n                        <p class=\"text-3xl font-bold leading-none md:text-4xl\" data-kid=\"1-2-3-1-3-3-1\" data-name=\"pilot city value\">\n                            5 cidades*\n                        </p>\n                        <p class=\"mt-2 text-sm text-white/85\" data-kid=\"1-2-3-1-3-3-2\" data-name=\"pilot city label\">\n                            territórios atualmente em estudo\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-4 text-xs text-white/70\" data-kid=\"1-2-3-1-4\">\n                    *Números ilustrativos deste estudo. O investimento real varia conforme ponto, formato e praça.\n                </p>\n            </div>\n        </section>\n        <section class=\"px-6 py-20 md:py-24\" data-kid=\"1-2-4\" id=\"modelo\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-4-1\">\n                <div class=\"grid gap-12 md:grid-cols-[.8fr_1.2fr] md:items-end\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <p class=\"accent text-2xl uppercase text-[#F91814]\" data-kid=\"1-2-4-1-1-1-1\">\n                            Sem enrolação\n                        </p>\n                        <h2 class=\"display mt-3 text-5xl leading-none text-[#F91814] md:text-6xl\" data-kid=\"1-2-4-1-1-1-2\">\n                            O MODELO, SEM ENROLAÇÃO\n                        </h2>\n                    </div>\n                    <p class=\"copy max-w-xl text-base\" data-kid=\"1-2-4-1-1-2\">\n                        Você traz a vontade de fazer acontecer. A VILA entra com o caminho organizado — do primeiro ponto à primeira noite cheia.\n                    </p>\n                </div>\n                <div class=\"mt-12 grid gap-4 md:grid-cols-3\" data-kid=\"1-2-4-1-2\">\n                    <div class=\"border-t-4 border-[#F91814] pt-5\" data-kid=\"1-2-4-1-2-1\">\n                        <span class=\"accent text-2xl text-[#F91814]\" data-kid=\"1-2-4-1-2-1-1\">\n                            01\n                        </span>\n                        <h3 class=\"mt-3 text-xl font-bold\" data-kid=\"1-2-4-1-2-1-2\">\n                            Escolha do ponto\n                        </h3>\n                        <p class=\"copy mt-2 text-sm\" data-kid=\"1-2-4-1-2-1-3\">\n                            Leitura de região, fluxo e vizinhança para encontrar um endereço com potencial.\n                        </p>\n                    </div>\n                    <div class=\"border-t-4 border-[#F91814] pt-5\" data-kid=\"1-2-4-1-2-2\">\n                        <span class=\"accent text-2xl text-[#F91814]\" data-kid=\"1-2-4-1-2-2-1\">\n                            02\n                        </span>\n                        <h3 class=\"mt-3 text-xl font-bold\" data-kid=\"1-2-4-1-2-2-2\">\n                            Implantação acompanhada\n                        </h3>\n                        <p class=\"copy mt-2 text-sm\" data-kid=\"1-2-4-1-2-2-3\">\n                            Projeto, fornecedores e abertura lado a lado, sem deixar você sozinho no detalhe.\n                        </p>\n                    </div>\n                    <div class=\"border-t-4 border-[#F91814] pt-5\" data-kid=\"1-2-4-1-2-3\">\n                        <span class=\"accent text-2xl text-[#F91814]\" data-kid=\"1-2-4-1-2-3-1\">\n                            03\n                        </span>\n                        <h3 class=\"mt-3 text-xl font-bold\" data-kid=\"1-2-4-1-2-3-2\">\n                            Operação com suporte\n                        </h3>\n                        <p class=\"copy mt-2 text-sm\" data-kid=\"1-2-4-1-2-3-3\">\n                            Treino, rotina e conversa contínua para a casa ganhar ritmo.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-12 grid gap-4 border-y border-[#d8c7b8] py-7 sm:grid-cols-3\" data-kid=\"1-2-4-1-3\">\n                    <div data-kid=\"1-2-4-1-3-1\">\n                        <p class=\"text-3xl font-bold text-[#F91814]\" data-kid=\"1-2-4-1-3-1-1\">\n                            a partir de R$ 280 mil*\n                        </p>\n                        <p class=\"mt-1 text-xs uppercase text-[#6d5e53]\" data-kid=\"1-2-4-1-3-1-2\">\n                            estimativa de investimento\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-4-1-3-2\">\n                        <p class=\"text-3xl font-bold text-[#F91814]\" data-kid=\"1-2-4-1-3-2-1\">\n                            90 dias*\n                        </p>\n                        <p class=\"mt-1 text-xs uppercase text-[#6d5e53]\" data-kid=\"1-2-4-1-3-2-2\">\n                            estimativa para abrir\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-4-1-3-3\">\n                        <p class=\"text-3xl font-bold text-[#F91814]\" data-kid=\"1-2-4-1-3-3-1\">\n                            5 cidades-piloto*\n                        </p>\n                        <p class=\"mt-1 text-xs uppercase text-[#6d5e53]\" data-kid=\"1-2-4-1-3-3-2\">\n                            territórios em estudo\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-4 text-xs text-[#6d5e53]\" data-kid=\"1-2-4-1-4\">\n                    *Valores meramente ilustrativos para este estudo de conceito. Não constituem oferta ou promessa comercial.\n                </p>\n            </div>\n        </section>\n        <section class=\"bg-[#F9CD25] px-6 py-20 text-[#2C1608] md:py-24\" data-kid=\"1-2-5\" data-name=\"support section\" id=\"suporte\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-5-1\">\n                <div class=\"grid gap-12 md:grid-cols-[.85fr_1.15fr] md:items-end\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\" data-name=\"support section label\">\n                        <p class=\"accent text-2xl uppercase text-[#2C1608]\" data-kid=\"1-2-5-1-1-1-1\">\n                            Do seu lado\n                        </p>\n                        <h2 class=\"display mt-3 text-5xl leading-none text-[#2C1608] md:text-6xl\" data-kid=\"1-2-5-1-1-1-2\">\n                            VOCÊ NÃO ABRE SOZINHO\n                        </h2>\n                    </div>\n                    <p class=\"max-w-xl text-base font-semibold leading-relaxed text-[#2C1608]\" data-kid=\"1-2-5-1-1-2\" data-name=\"support section description\">\n                        Uma boa marca entrega mais do que um manual. Ela aparece nos momentos que mais pesam quando a porta abre.\n                    </p>\n                </div>\n                <div class=\"mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-2-5-1-2\">\n                    <div class=\"rounded-3xl border border-[#2C1608]/15 bg-[#F4EBE1] p-6\" data-kid=\"1-2-5-1-2-1\" data-name=\"support feature card\">\n                        <iconify-icon class=\"text-3xl text-[#F91814]\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"book icon\" icon=\"solar:book-2-linear\">\n                        </iconify-icon>\n                        <h3 class=\"mt-5 font-bold uppercase text-[#2C1608]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"support feature title\">\n                            Treinamento\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-relaxed text-[#2C1608]/80\" data-kid=\"1-2-5-1-2-1-3\" data-name=\"support feature description\">\n                            Time preparado para o produto e para a rotina real.\n                        </p>\n                    </div>\n                    <div class=\"rounded-3xl border border-[#2C1608]/15 bg-[#F4EBE1] p-6\" data-kid=\"1-2-5-1-2-2\" data-name=\"support feature card\">\n                        <iconify-icon class=\"text-3xl text-[#F91814]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"buildings icon\" icon=\"solar:buildings-2-linear\">\n                        </iconify-icon>\n                        <h3 class=\"mt-5 font-bold uppercase text-[#2C1608]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"support feature title\">\n                            Implantação\n                        </h3>\n                        <p class=\"mt-2 text-sm text-white/85\" data-kid=\"1-2-5-1-2-2-3\" data-name=\"support feature description\">\n                            Apoio para tirar a ideia do papel e colocar a chapa para rodar.\n                        </p>\n                    </div>\n                    <div class=\"rounded-3xl border border-[#2C1608]/15 bg-[#F4EBE1] p-6\" data-kid=\"1-2-5-1-2-3\" data-name=\"support feature card with icon\">\n                        <iconify-icon class=\"text-3xl text-[#F91814]\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"megaphone icon\" icon=\"solar:megaphone-linear\">\n                        </iconify-icon>\n                        <h3 class=\"mt-5 font-bold uppercase text-[#2C1608]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"support feature title\">\n                            Marketing local\n                        </h3>\n                        <p class=\"mt-2 text-sm text-white/85\" data-kid=\"1-2-5-1-2-3-3\" data-name=\"support feature description\">\n                            Campanhas com sotaque da cidade, sem perder a cara da VILA.\n                        </p>\n                    </div>\n                    <div class=\"rounded-3xl border border-[#2C1608]/15 bg-[#F4EBE1] p-6\" data-kid=\"1-2-5-1-2-4\" data-name=\"support feature card\">\n                        <iconify-icon class=\"text-3xl text-[#F91814]\" data-kid=\"1-2-5-1-2-4-1\" icon=\"solar:box-linear\">\n                        </iconify-icon>\n                        <h3 class=\"mt-5 font-bold uppercase text-[#2C1608]\" data-kid=\"1-2-5-1-2-4-2\">\n                            Compras e fornecedores\n                        </h3>\n                        <p class=\"mt-2 text-sm text-white/85\" data-kid=\"1-2-5-1-2-4-3\">\n                            Relações e padrões para o produto chegar igual em cada casa.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"px-6 py-20 md:py-24\" data-kid=\"1-2-6\">\n            <div class=\"mx-auto max-w-7xl\" data-kid=\"1-2-6-1\">\n                <div class=\"mx-auto max-w-3xl text-center\" data-kid=\"1-2-6-1-1\">\n                    <p class=\"accent text-2xl uppercase text-[#F91814]\" data-kid=\"1-2-6-1-1-1\">\n                        O produto sustenta a marca\n                    </p>\n                    <h2 class=\"display mt-3 text-5xl leading-none text-[#F91814] md:text-6xl\" data-kid=\"1-2-6-1-1-2\">\n                        CADA CAMADA TEM UM PAPEL\n                    </h2>\n                    <p class=\"copy mt-5\" data-kid=\"1-2-6-1-1-3\">\n                        A repetição que importa não é fazer tudo igual. É entregar o mesmo cuidado, mesmo quando a cidade muda.\n                    </p>\n                </div>\n                <div class=\"mt-12 grid grid-cols-2 gap-5 md:grid-cols-4\" data-kid=\"1-2-6-1-2\">\n                    <div class=\"text-center\" data-kid=\"1-2-6-1-2-1\">\n                        <img alt=\"Blend de carne\" class=\"mx-auto h-32 w-32 object-contain\" data-kid=\"1-2-6-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/meat.webp\"/>\n                        <h3 class=\"mt-4 font-bold text-[#F91814]\" data-kid=\"1-2-6-1-2-1-2\">\n                            Blend padronizado\n                        </h3>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-2-6-1-2-2\">\n                        <img alt=\"Queijo\" class=\"mx-auto h-32 w-32 object-contain\" data-kid=\"1-2-6-1-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/cheese.webp\"/>\n                        <h3 class=\"mt-4 font-bold text-[#F91814]\" data-kid=\"1-2-6-1-2-2-2\">\n                            Pão forneado\n                        </h3>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-2-6-1-2-3\">\n                        <img alt=\"Tomate\" class=\"mx-auto h-32 w-32 object-contain\" data-kid=\"1-2-6-1-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/tomato.webp\"/>\n                        <h3 class=\"mt-4 font-bold text-[#F91814]\" data-kid=\"1-2-6-1-2-3-2\">\n                            Molho proprietário\n                        </h3>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-2-6-1-2-4\">\n                        <img alt=\"Alface\" class=\"mx-auto h-32 w-32 object-contain\" data-kid=\"1-2-6-1-2-4-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/lettuce.webp\"/>\n                        <h3 class=\"mt-4 font-bold text-[#F91814]\" data-kid=\"1-2-6-1-2-4-2\">\n                            Montagem treinada\n                        </h3>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#F9CD25] px-6 py-20 text-[#2C1608] md:py-24\" data-kid=\"1-2-7\" id=\"onde-estamos\">\n            <div class=\"mx-auto grid max-w-7xl gap-12 md:grid-cols-[.75fr_1.25fr]\" data-kid=\"1-2-7-1\">\n                <div data-kid=\"1-2-7-1-1\">\n                    <p class=\"accent text-2xl uppercase text-[#2C1608]\" data-kid=\"1-2-7-1-1-1\">\n                        Territórios em estudo\n                    </p>\n                    <h2 class=\"display mt-3 text-5xl leading-none text-[#2C1608] md:text-6xl\" data-kid=\"1-2-7-1-1-2\">\n                        UMA REDE QUE AINDA TEM ESPAÇO\n                    </h2>\n                    <p class=\"mt-6 text-base font-semibold leading-relaxed text-[#2C1608]\" data-kid=\"1-2-7-1-1-3\" data-name=\"territory section description text\">\n                        São cidades-conceito para mostrar onde a VILA pode encontrar novas mesas, novas histórias e pessoas prontas para fazer junto.\n                    </p>\n                    <a class=\"focus-ring mt-7 inline-flex rounded-full bg-[#F91814] px-6 py-3 text-xs font-bold uppercase text-white\" data-kid=\"1-2-7-1-1-4\" href=\"#candidatura\">\n                        Levar a VILA para minha cidade\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-2 gap-4 md:grid-cols-3\" data-kid=\"1-2-7-1-2\">\n                    <div data-kid=\"1-2-7-1-2-1\">\n                        <img alt=\"São Paulo, território em estudo\" class=\"h-64 w-full rounded-3xl object-cover\" data-kid=\"1-2-7-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/berlin.webp\"/>\n                        <p class=\"mt-3 font-bold uppercase text-[#F91814]\" data-kid=\"1-2-7-1-2-1-2\">\n                            São Paulo\n                        </p>\n                    </div>\n                    <div class=\"mt-8\" data-kid=\"1-2-7-1-2-2\">\n                        <img alt=\"Rio de Janeiro, território em estudo\" class=\"h-64 w-full rounded-3xl object-cover\" data-kid=\"1-2-7-1-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/london.webp\"/>\n                        <p class=\"mt-3 font-bold uppercase text-[#F91814]\" data-kid=\"1-2-7-1-2-2-2\">\n                            Rio de Janeiro\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-7-1-2-3\">\n                        <img alt=\"Recife, território em estudo\" class=\"h-64 w-full rounded-3xl object-cover\" data-kid=\"1-2-7-1-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/newyork.webp\"/>\n                        <p class=\"mt-3 font-bold uppercase text-[#F91814]\" data-kid=\"1-2-7-1-2-3-2\">\n                            Recife\n                        </p>\n                    </div>\n                    <div class=\"md:-mt-8\" data-kid=\"1-2-7-1-2-4\">\n                        <img alt=\"Porto Alegre, território em estudo\" class=\"h-64 w-full rounded-3xl object-cover\" data-kid=\"1-2-7-1-2-4-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/sydney.webp\"/>\n                        <p class=\"mt-3 font-bold uppercase text-[#F91814]\" data-kid=\"1-2-7-1-2-4-2\">\n                            Porto Alegre\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-7-1-2-5\">\n                        <img alt=\"Brasília, território em estudo\" class=\"h-64 w-full rounded-3xl object-cover\" data-kid=\"1-2-7-1-2-5-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/tokyo.webp\"/>\n                        <p class=\"mt-3 font-bold uppercase text-[#F91814]\" data-kid=\"1-2-7-1-2-5-2\">\n                            Brasília\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"px-6 py-20 md:py-24\" data-kid=\"1-2-8\" id=\"candidatura\">\n            <div class=\"mx-auto grid max-w-7xl gap-12 md:grid-cols-[.9fr_1.1fr] md:items-start\" data-kid=\"1-2-8-1\">\n                <div data-kid=\"1-2-8-1-1\">\n                    <p class=\"accent text-2xl uppercase text-[#F91814]\" data-kid=\"1-2-8-1-1-1\">\n                        Vamos conversar?\n                    </p>\n                    <h2 class=\"display mt-3 text-5xl leading-none text-[#F91814] md:text-7xl\" data-kid=\"1-2-8-1-1-2\">\n                        SINTA A DIFERENÇA DE TER UM MAPA\n                    </h2>\n                    <p class=\"copy mt-7 max-w-lg\" data-kid=\"1-2-8-1-1-3\">\n                        Abrir uma VILA é colocar energia em uma casa que pode ser sua, com alguém do outro lado para dividir as decisões importantes.\n                    </p>\n                    <p class=\"mt-5 text-xs font-semibold uppercase text-[#F91814]\" data-kid=\"1-2-8-1-1-4\">\n                        Resposta simulada para este estudo de caso.\n                    </p>\n                </div>\n                <div class=\"rounded-3xl border border-[#d8c7b8] bg-white p-6 shadow-[0_20px_40px_-15px_rgba(44,22,8,0.12)] md:p-8\" data-kid=\"1-2-8-1-2\">\n                    <div class=\"mb-6 border-b border-[#ead8c8] pb-5\" data-kid=\"1-2-8-1-2-3\" data-name=\"franchise form header container\">\n                        <p class=\"text-xs font-bold uppercase text-[#F91814]\" data-kid=\"1-2-8-1-2-3-1\" data-name=\"franchise form subheadline\">\n                            Primeiro papo, sem compromisso\n                        </p>\n                        <p class=\"mt-2 text-sm leading-relaxed text-[#5d5149]\" data-kid=\"1-2-8-1-2-3-2\" data-name=\"franchise form description text\">\n                            Conte um pouco sobre você e a cidade. A conversa simulada começa por aqui.\n                        </p>\n                    </div>\n                    <form class=\"space-y-5\" data-dynamic=\"true\" data-kid=\"1-2-8-1-2-1\" data-name=\"franchise inquiry form\" data-reason=\"hidden class toggled by form submission script\" id=\"franchise-form\">\n                        <div data-kid=\"1-2-8-1-2-1-1\">\n                            <label class=\"mb-2 block text-xs font-bold uppercase\" data-kid=\"1-2-8-1-2-1-1-1\" for=\"nome\">\n                                Nome\n                            </label>\n                            <input class=\"focus-ring min-h-12 w-full rounded-2xl border border-[#d8c7b8] bg-[#F4EBE1] px-4 text-sm\" data-kid=\"1-2-8-1-2-1-1-2\" data-name=\"franchise name input field\" id=\"nome\" required=\"\" type=\"text\"/>\n                        </div>\n                        <div data-kid=\"1-2-8-1-2-1-2\">\n                            <label class=\"mb-2 block text-xs font-bold uppercase\" data-kid=\"1-2-8-1-2-1-2-1\" for=\"email\">\n                                E-mail\n                            </label>\n                            <input class=\"focus-ring min-h-12 w-full rounded-2xl border border-[#d8c7b8] bg-[#F4EBE1] px-4 text-sm\" data-kid=\"1-2-8-1-2-1-2-2\" data-name=\"franchise email input field\" id=\"email\" required=\"\" type=\"email\"/>\n                        </div>\n                        <div data-kid=\"1-2-8-1-2-1-3\">\n                            <label class=\"mb-2 block text-xs font-bold uppercase\" data-kid=\"1-2-8-1-2-1-3-1\" for=\"cidade\">\n                                Cidade e estado\n                            </label>\n                            <input class=\"focus-ring min-h-12 w-full rounded-2xl border border-[#d8c7b8] bg-[#F4EBE1] px-4 text-sm\" data-kid=\"1-2-8-1-2-1-3-2\" data-name=\"franchise city input field\" id=\"cidade\" required=\"\" type=\"text\"/>\n                        </div>\n                        <div class=\"grid gap-5 sm:grid-cols-2\" data-kid=\"1-2-8-1-2-1-4\">\n                            <div data-kid=\"1-2-8-1-2-1-4-1\">\n                                <label class=\"mb-2 block text-xs font-bold uppercase\" data-kid=\"1-2-8-1-2-1-4-1-1\" for=\"capital\">\n                                    Capital disponível\n                                </label>\n                                <select class=\"focus-ring min-h-12 w-full rounded-2xl border border-[#d8c7b8] bg-[#F4EBE1] px-4 text-sm\" data-kid=\"1-2-8-1-2-1-4-1-2\" data-name=\"franchise capital selection dropdown\" id=\"capital\" required=\"\">\n                                    <option data-kid=\"1-2-8-1-2-1-4-1-2-1\" value=\"\">\n                                        Selecione\n                                    </option>\n                                    <option data-kid=\"1-2-8-1-2-1-4-1-2-2\">\n                                        Até R$ 150 mil\n                                    </option>\n                                    <option data-kid=\"1-2-8-1-2-1-4-1-2-3\">\n                                        R$ 150–280 mil\n                                    </option>\n                                    <option data-kid=\"1-2-8-1-2-1-4-1-2-4\">\n                                        Acima de R$ 280 mil\n                                    </option>\n                                </select>\n                            </div>\n                            <div data-kid=\"1-2-8-1-2-1-4-2\">\n                                <label class=\"mb-2 block text-xs font-bold uppercase\" data-kid=\"1-2-8-1-2-1-4-2-1\" for=\"experiencia\">\n                                    Experiência em operação\n                                </label>\n                                <select class=\"focus-ring min-h-12 w-full rounded-2xl border border-[#d8c7b8] bg-[#F4EBE1] px-4 text-sm\" data-kid=\"1-2-8-1-2-1-4-2-2\" data-name=\"franchise experience selection dropdown\" id=\"experiencia\" required=\"\">\n                                    <option data-kid=\"1-2-8-1-2-1-4-2-2-1\" value=\"\">\n                                        Selecione\n                                    </option>\n                                    <option data-kid=\"1-2-8-1-2-1-4-2-2-2\">\n                                        Tenho experiência\n                                    </option>\n                                    <option data-kid=\"1-2-8-1-2-1-4-2-2-3\">\n                                        Estou começando\n                                    </option>\n                                    <option data-kid=\"1-2-8-1-2-1-4-2-2-4\">\n                                        Quero avaliar\n                                    </option>\n                                </select>\n                            </div>\n                        </div>\n                        <label class=\"flex items-start gap-3 text-xs text-[#5d5149]\" data-kid=\"1-2-8-1-2-1-5\" data-name=\"franchise form consent checkbox label\">\n                            <input class=\"focus-ring mt-1 h-5 w-5 accent-[#F91814]\" data-kid=\"1-2-8-1-2-1-5-1\" data-name=\"franchise form consent checkbox\" required=\"\" type=\"checkbox\"/>\n                            Aceito receber uma conversa simulada sobre o modelo VILA SMASH.\n                        </label>\n                        <button class=\"focus-ring min-h-12 w-full rounded-full bg-[#F91814] px-5 py-4 text-xs font-bold uppercase text-white\" data-kid=\"1-2-8-1-2-1-6\" data-name=\"franchise form submit button\" type=\"submit\">\n                            Quero conversar sobre uma unidade\n                        </button>\n                        <p class=\"text-center text-xs leading-relaxed text-[#6d5e53]\" data-kid=\"1-2-8-1-2-1-7\" data-name=\"franchise inquiry form legal notice text\">\n                            Depois do envio, o próximo passo seria uma conversa de qualificação. Seus dados ficam apenas neste estudo simulado.\n                        </p>\n                    </form>\n                    <div class=\"hidden text-center\" data-dynamic=\"true\" data-kid=\"1-2-8-1-2-2\" data-name=\"form submission success message\" data-reason=\"hidden class toggled by form submission script\" id=\"form-success\">\n                        <iconify-icon class=\"text-5xl text-[#F91814]\" data-kid=\"1-2-8-1-2-2-1\" icon=\"solar:check-circle-linear\">\n                        </iconify-icon>\n                        <h3 class=\"display mt-4 text-4xl text-[#F91814]\" data-kid=\"1-2-8-1-2-2-2\">\n                            CHEGOU NA VILA\n                        </h3>\n                        <p class=\"copy mt-3\" data-kid=\"1-2-8-1-2-2-3\">\n                            Recebemos seu interesse simulado. Em um projeto real, o próximo passo seria uma conversa de qualificação.\n                        </p>\n                        <a class=\"focus-ring mt-6 inline-flex rounded-full bg-[#F91814] px-6 py-3 text-xs font-bold uppercase text-white\" data-kid=\"1-2-8-1-2-2-4\" href=\"#top\">\n                            Voltar ao começo\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"px-6 pb-20\" data-kid=\"1-2-9\">\n            <div class=\"mx-auto max-w-4xl\" data-kid=\"1-2-9-1\">\n                <p class=\"accent text-center text-2xl uppercase text-[#F91814]\" data-kid=\"1-2-9-1-1\">\n                    Perguntas de quem está pensando\n                </p>\n                <div class=\"mt-6 divide-y divide-[#d8c7b8] border-y border-[#d8c7b8]\" data-kid=\"1-2-9-1-2\">\n                    <div class=\"faq-item\" data-dynamic=\"true\" data-kid=\"1-2-9-1-2-1\" data-name=\"faq item 1\" data-reason=\"open class toggled by script\">\n                        <button class=\"faq-toggle focus-ring flex min-h-16 w-full items-center justify-between text-left font-bold uppercase\" data-kid=\"1-2-9-1-2-1-1\" type=\"button\">\n                            <span data-kid=\"1-2-9-1-2-1-1-1\">\n                                Qual é o investimento?\n                            </span>\n                            <iconify-icon class=\"faq-chevron text-xl transition-transform\" data-kid=\"1-2-9-1-2-1-1-2\" icon=\"solar:alt-arrow-down-linear\">\n                            </iconify-icon>\n                        </button>\n                        <div class=\"faq-answer pb-5 text-sm text-[#5d5149]\" data-kid=\"1-2-9-1-2-1-2\">\n                            Os valores exibidos são ilustrativos para este estudo. Em uma operação real, o investimento dependeria do ponto, formato e praça.\n                        </div>\n                    </div>\n                    <div class=\"faq-item\" data-dynamic=\"true\" data-kid=\"1-2-9-1-2-2\" data-name=\"faq item 2\" data-reason=\"open class toggled by script\">\n                        <button class=\"faq-toggle focus-ring flex min-h-16 w-full items-center justify-between text-left font-bold uppercase\" data-kid=\"1-2-9-1-2-2-1\" type=\"button\">\n                            <span data-kid=\"1-2-9-1-2-2-1-1\">\n                                Que suporte a franquia oferece?\n                            </span>\n                            <iconify-icon class=\"faq-chevron text-xl transition-transform\" data-kid=\"1-2-9-1-2-2-1-2\" icon=\"solar:alt-arrow-down-linear\">\n                            </iconify-icon>\n                        </button>\n                        <div class=\"faq-answer pb-5 text-sm text-[#5d5149]\" data-kid=\"1-2-9-1-2-2-2\">\n                            O conceito prevê treinamento, implantação, marketing local e apoio em compras e fornecedores.\n                        </div>\n                    </div>\n                    <div class=\"faq-item\" data-dynamic=\"true\" data-kid=\"1-2-9-1-2-3\" data-name=\"faq item 3\" data-reason=\"open class toggled by script\">\n                        <button class=\"faq-toggle focus-ring flex min-h-16 w-full items-center justify-between text-left font-bold uppercase\" data-kid=\"1-2-9-1-2-3-1\" type=\"button\">\n                            <span data-kid=\"1-2-9-1-2-3-1-1\">\n                                Posso escolher a minha cidade?\n                            </span>\n                            <iconify-icon class=\"faq-chevron text-xl transition-transform\" data-kid=\"1-2-9-1-2-3-1-2\" icon=\"solar:alt-arrow-down-linear\">\n                            </iconify-icon>\n                        </button>\n                        <div class=\"faq-answer pb-5 text-sm text-[#5d5149]\" data-kid=\"1-2-9-1-2-3-2\">\n                            Sim. A conversa inicial serve para entender a cidade, o território e o momento certo para abrir uma unidade.\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#2C1608] px-6 pb-10 pt-16 text-white\" data-kid=\"1-3\" id=\"footer\">\n        <div class=\"mx-auto max-w-7xl\" data-kid=\"1-3-1\">\n            <div class=\"grid gap-12 md:grid-cols-4\" data-kid=\"1-3-1-1\">\n                <div data-kid=\"1-3-1-1-1\">\n                    <a class=\"display text-5xl text-[#F91814]\" data-kid=\"1-3-1-1-1-1\" href=\"#top\">\n                        VILA\n                    </a>\n                    <p class=\"mt-5 text-sm leading-relaxed text-white/65\" data-kid=\"1-3-1-1-1-2\">\n                        Smash de verdade, feito na hora e pensado para virar uma casa querida na cidade.\n                    </p>\n                    <div class=\"mt-5 flex gap-2\" data-kid=\"1-3-1-1-1-3\">\n                        <a aria-label=\"Instagram\" class=\"focus-ring flex h-11 w-11 items-center justify-center rounded-full text-2xl text-white/75\" data-kid=\"1-3-1-1-1-3-1\" href=\"#top\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-1-1\" icon=\"mdi:instagram\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"Facebook\" class=\"focus-ring flex h-11 w-11 items-center justify-center rounded-full text-2xl text-white/75\" data-kid=\"1-3-1-1-1-3-2\" href=\"#top\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-2-1\" icon=\"mdi:facebook\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"TikTok\" class=\"focus-ring flex h-11 w-11 items-center justify-center rounded-full text-2xl text-white/75\" data-kid=\"1-3-1-1-1-3-3\" href=\"#top\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-3-1\" icon=\"mdi:music-note\">\n                            </iconify-icon>\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-2\">\n                    <h3 class=\"text-sm font-bold uppercase\" data-kid=\"1-3-1-1-2-1\">\n                        Navegação\n                    </h3>\n                    <div class=\"mt-5 flex flex-col gap-3 text-sm text-white/65\" data-kid=\"1-3-1-1-2-2\">\n                        <a data-kid=\"1-3-1-1-2-2-1\" href=\"#marca\">\n                            A marca\n                        </a>\n                        <a data-kid=\"1-3-1-1-2-2-2\" href=\"#modelo\">\n                            Como funciona\n                        </a>\n                        <a data-kid=\"1-3-1-1-2-2-3\" href=\"#suporte\">\n                            Suporte\n                        </a>\n                        <a data-kid=\"1-3-1-1-2-2-4\" href=\"#onde-estamos\">\n                            Onde estamos\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\">\n                    <h3 class=\"text-sm font-bold uppercase\" data-kid=\"1-3-1-1-3-1\">\n                        Franquias\n                    </h3>\n                    <div class=\"mt-5 flex flex-col gap-3 text-sm text-white/65\" data-kid=\"1-3-1-1-3-2\">\n                        <a data-kid=\"1-3-1-1-3-2-1\" href=\"#modelo\">\n                            Modelo\n                        </a>\n                        <a data-kid=\"1-3-1-1-3-2-2\" href=\"#suporte\">\n                            Suporte\n                        </a>\n                        <a data-kid=\"1-3-1-1-3-2-3\" href=\"#candidatura\">\n                            Candidatura\n                        </a>\n                        <a data-kid=\"1-3-1-1-3-2-4\" href=\"#footer\">\n                            Perguntas frequentes\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\">\n                    <h3 class=\"text-sm font-bold uppercase\" data-kid=\"1-3-1-1-4-1\">\n                        Clube da VILA\n                    </h3>\n                    <p class=\"mt-5 text-sm leading-relaxed text-white/65\" data-kid=\"1-3-1-1-4-2\">\n                        Receba novidades do conceito e próximos estudos.\n                    </p>\n                    <form class=\"mt-4 flex flex-col gap-3\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter subscription form\" onsubmit=\"event.preventDefault();this.querySelector('button').textContent='Recebido';\">\n                        <label class=\"text-xs font-bold uppercase text-white/80\" data-kid=\"1-3-1-1-4-3-1\" for=\"newsletter\">\n                            Seu e-mail\n                        </label>\n                        <input class=\"focus-ring min-h-12 rounded-2xl border border-[#583115] bg-[#40220D] px-4 text-sm text-white\" data-kid=\"1-3-1-1-4-3-2\" id=\"newsletter\" required=\"\" type=\"email\"/>\n                        <button class=\"focus-ring min-h-12 rounded-full bg-[#F91814] px-5 text-xs font-bold uppercase text-white\" data-dynamic=\"true\" data-kid=\"1-3-1-1-4-3-3\" data-name=\"newsletter submit button\" data-reason=\"text content replaced on submission\" type=\"submit\">\n                            Quero receber\n                        </button>\n                    </form>\n                </div>\n            </div>\n            <div class=\"mt-14 border-t border-[#583115] pt-6 text-xs text-white/45\" data-kid=\"1-3-1-2\">\n                <p data-kid=\"1-3-1-2-1\">\n                    © 2026 VILA SMASH — Conceito fictício para estudo. Valores e indicadores são ilustrativos.\n                </p>\n                <div class=\"mt-3 flex gap-5\" data-kid=\"1-3-1-2-2\">\n                    <a data-kid=\"1-3-1-2-2-1\" href=\"#candidatura\">\n                        Privacidade\n                    </a>\n                    <a data-kid=\"1-3-1-2-2-2\" href=\"#candidatura\">\n                        Termos\n                    </a>\n                </div>\n            </div>\n            <div class=\"mt-12 overflow-hidden text-center\" data-kid=\"1-3-1-3\" data-name=\"footer background decorative text container\">\n                <div class=\"display text-[22vw] leading-none text-[#F91814]\" data-kid=\"1-3-1-3-1\" data-name=\"footer background decorative text\">\n                    VILA\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    const menuToggle=document.getElementById('menu-toggle');const mobileMenu=document.getElementById('mobile-menu');menuToggle.addEventListener('click',()=>{const open=menuToggle.getAttribute('aria-expanded')==='true';menuToggle.setAttribute('aria-expanded',String(!open));mobileMenu.classList.toggle('hidden',open)});mobileMenu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{mobileMenu.classList.add('hidden');menuToggle.setAttribute('aria-expanded','false')}));document.querySelectorAll('.faq-toggle').forEach(button=>button.addEventListener('click',()=>{button.parentElement.classList.toggle('open')}));const form=document.getElementById('franchise-form');const success=document.getElementById('form-success');form.addEventListener('submit',e=>{e.preventDefault();form.classList.add('hidden');success.classList.remove('hidden')});const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)entry.target.classList.add('is-visible')}),{threshold:.08});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));\n</script>\n",
