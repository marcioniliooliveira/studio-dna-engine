rc=\"https://www.cravburgers.shop/img-webp/tokyo.webp\"/>\n                        <p class=\"pb-2 text-center text-xl text-[#F91814]\" data-kid=\"1-2-5-1-2-5-2\" data-name=\"location city name\" style=\"font-family:Modak,system-ui\">\n                            BRASÍLIA\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[#F4EBE1] py-24 md:py-32\" data-kid=\"1-2-6\" data-name=\"call-to-action section\" id=\"pedir\">\n            <div class=\"mx-auto flex max-w-5xl flex-col items-center gap-12 px-6 md:flex-row md:gap-20\" data-kid=\"1-2-6-1\" data-name=\"cta content container\">\n                <div class=\"flex flex-col items-center text-center md:w-1/2 md:items-start md:text-left\" data-kid=\"1-2-6-1-1\" data-name=\"cta text container\">\n                    <p class=\"mb-4 text-xl uppercase tracking-tight text-[#F91814] md:text-2xl\" data-kid=\"1-2-6-1-1-1\" data-name=\"section subheader text\" style=\"font-family:'Mouse Memoirs',sans-serif\">\n                        Deu vontade?\n                    </p>\n                    <h2 class=\"mb-8 text-5xl leading-none tracking-tighter text-[#F91814] md:text-7xl\" data-kid=\"1-2-6-1-1-2\" data-name=\"section title\" style=\"font-family:Modak,system-ui\">\n                        SINTA A\n                        <br data-kid=\"1-2-6-1-1-2-1\" data-name=\"line break element\"/>\n                        BRASA\n                    </h2>\n                    <p class=\"mb-10 max-w-sm text-sm font-medium leading-relaxed text-zinc-500\" data-kid=\"1-2-6-1-1-3\" data-name=\"section description text\">\n                        Crocante por fora, suculento por dentro e impossível de esquecer. Seu próximo burger favorito está a um clique.\n                    </p>\n                    <a class=\"inline-flex items-center gap-2 rounded-full bg-[#F91814] px-8 py-3.5 text-xs font-medium uppercase tracking-tight text-white shadow-md hover:bg-red-700\" data-kid=\"1-2-6-1-1-4\" data-name=\"cta button\" href=\"#footer\">\n                        Pedir meu burger\n                        <iconify-icon data-kid=\"1-2-6-1-1-4-1\" data-name=\"arrow right icon\" icon=\"solar:arrow-right-linear\" style=\"width:18px;height:18px;stroke-width:1.5\">\n                        </iconify-icon>\n                    </a>\n                </div>\n                <div class=\"relative w-full md:w-1/2\" data-kid=\"1-2-6-1-2\" data-name=\"cta image container\">\n                    <div class=\"absolute inset-0 -z-10 translate-x-4 translate-y-4 rounded-[2rem] bg-gradient-to-tr from-zinc-100 to-transparent\" data-kid=\"1-2-6-1-2-1\" data-name=\"cta image background decorative layer\">\n                    </div>\n                    <img alt=\"Burger premium Brasa Brava\" class=\"aspect-[4/5] w-full rounded-[2rem] border border-zinc-100 object-cover shadow-xl\" data-kid=\"1-2-6-1-2-2\" data-name=\"cta burger image\" decoding=\"async\" loading=\"lazy\" src=\"https://www.cravburgers.shop/img-webp/cta.webp\"/>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"mt-auto border-t border-[#40220D] bg-[#2C1608] pb-12 pt-20 text-white\" data-kid=\"1-3\" data-name=\"footer section\" id=\"footer\">\n        <div class=\"mx-auto max-w-7xl px-6\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n            <div class=\"mb-16 grid grid-cols-1 gap-12 md:grid-cols-4\" data-kid=\"1-3-1-1\" data-name=\"footer grid container\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand container\">\n                    <a class=\"mb-6 block text-5xl uppercase text-[#F91814] drop-shadow-sm\" data-kid=\"1-3-1-1-1-1\" data-name=\"brand logo link\" href=\"#inicio\" style=\"font-family:Modak,system-ui\">\n                        BRASA\n                        <br data-kid=\"1-3-1-1-1-1-1\" data-name=\"line break element\"/>\n                        BRAVA\n                    </a>\n                    <p class=\"mb-6 text-sm font-medium leading-relaxed tracking-tight text-zinc-400\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer description text\">\n                        A hamburgueria brasileira que leva chapa, sabor e atitude para cada esquina.\n                    </p>\n                    <div class=\"flex items-center gap-4 text-zinc-400\" data-kid=\"1-3-1-1-1-3\" data-name=\"social links container\">\n                        <a aria-label=\"Instagram\" class=\"hover:text-white\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"social link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-1-1\" data-name=\"instagram icon\" icon=\"mdi:instagram\" style=\"width:24px;height:24px\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"Facebook\" class=\"hover:text-white\" data-kid=\"1-3-1-1-1-3-2\" data-name=\"social link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-2-1\" data-name=\"facebook icon\" icon=\"mdi:facebook\" style=\"width:24px;height:24px\">\n                            </iconify-icon>\n                        </a>\n                        <a aria-label=\"TikTok\" class=\"hover:text-white\" data-kid=\"1-3-1-1-1-3-3\" data-name=\"social link\" href=\"#\">\n                            <iconify-icon data-kid=\"1-3-1-1-1-3-3-1\" data-name=\"tiktok icon\" icon=\"mdi:music-note\" style=\"width:24px;height:24px\">\n                            </iconify-icon>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"md:pl-8\" data-kid=\"1-3-1-1-2\" data-name=\"footer navigation links column\">\n                    <h4 class=\"mb-6 text-sm font-bold uppercase tracking-tight text-white\" data-kid=\"1-3-1-1-2-1\" data-name=\"column title\">\n                        Navegação\n                    </h4>\n                    <div class=\"flex flex-col gap-4 text-sm font-medium tracking-tight text-zinc-400\" data-kid=\"1-3-1-1-2-2\" data-name=\"navigation links list\">\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"nav link\" href=\"#inicio\">\n                            Início\n                        </a>\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"nav link\" href=\"#historia\">\n                            Nossa história\n                        </a>\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-3\" data-name=\"nav link\" href=\"#ingredientes\">\n                            Ingredientes\n                        </a>\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-2-2-4\" data-name=\"nav link\" href=\"#locais\">\n                            Onde encontrar\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"footer info links column\">\n                    <h4 class=\"mb-6 text-sm font-bold uppercase tracking-tight text-white\" data-kid=\"1-3-1-1-3-1\" data-name=\"column title\">\n                        Informações\n                    </h4>\n                    <div class=\"flex flex-col gap-4 text-sm font-medium tracking-tight text-zinc-400\" data-kid=\"1-3-1-1-3-2\" data-name=\"info links list\">\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"nav link\" href=\"#pedir\">\n                            Nosso cardápio\n                        </a>\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"nav link\" href=\"#\">\n                            Perguntas frequentes\n                        </a>\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"nav link\" href=\"#\">\n                            Fale com a gente\n                        </a>\n                        <a class=\"hover:text-[#F91814]\" data-kid=\"1-3-1-1-3-2-4\" data-name=\"nav link\" href=\"#\">\n                            Seja franqueado\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"newsletter signup column\">\n                    <h4 class=\"mb-6 text-sm font-bold uppercase tracking-tight text-white\" data-kid=\"1-3-1-1-4-1\" data-name=\"column title\">\n                        Clube da brasa\n                    </h4>\n                    <p class=\"mb-4 text-sm font-medium leading-relaxed tracking-tight text-zinc-400\" data-kid=\"1-3-1-1-4-2\" data-name=\"newsletter description text\">\n                        Receba novidades, sabores secretos e ofertas no seu email.\n                    </p>\n                    <form class=\"flex flex-col gap-3\" data-kid=\"1-3-1-1-4-3\" data-name=\"newsletter form\" onsubmit=\"event.preventDefault()\">\n                        <input class=\"w-full rounded-full border border-[#583115] bg-[#40220D] px-5 py-3 text-sm text-white placeholder:text-zinc-500 focus:border-[#F91814] focus:outline-none\" data-kid=\"1-3-1-1-4-3-1\" data-name=\"newsletter email input\" placeholder=\"Seu melhor email\" required=\"\" type=\"email\"/>\n                        <button class=\"w-full rounded-full bg-[#F91814] px-5 py-3 text-xs font-semibold uppercase tracking-tight text-white hover:bg-red-700\" data-kid=\"1-3-1-1-4-3-2\" data-name=\"newsletter submit button\">\n                            Quero participar\n                        </button>\n                    </form>\n                </div>\n            </div>\n            <div class=\"flex flex-col items-center justify-between gap-4 border-t border-[#40220D] pt-8 text-xs font-medium tracking-tight text-zinc-500 md:flex-row\" data-kid=\"1-3-1-2\" data-name=\"copyright and legal links container\">\n                <p data-kid=\"1-3-1-2-1\" data-name=\"copyright notice text\">\n                    © 2026 BRASA BRAVA — Todos os direitos reservados.\n                </p>\n                <div class=\"flex gap-4\" data-kid=\"1-3-1-2-2\" data-name=\"legal links container\">\n                    <a class=\"hover:text-zinc-300\" data-kid=\"1-3-1-2-2-1\" data-name=\"legal link\" href=\"#\">\n                        Privacidade\n                    </a>\n                    <a class=\"hover:text-zinc-300\" data-kid=\"1-3-1-2-2-2\" data-name=\"legal link\" href=\"#\">\n                        Termos\n                    </a>\n                </div>\n            </div>\n            <div class=\"mt-16 flex justify-center overflow-hidden\" data-kid=\"1-3-1-3\" data-name=\"footer decorative element container\">\n                <h2 class=\"select-none text-[20vw] leading-none tracking-tighter text-[#F91814] md:text-[15vw]\" data-kid=\"1-3-1-3-1\" data-name=\"footer decorative brand text\" style=\"font-family:Modak,system-ui\">\n                    BRASA\n                </h2>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    const reveal=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('is-visible')}),{threshold:.12});document.querySelectorAll('section>div, footer>div').forEach(el=>{el.classList.add('bb-reveal');reveal.observe(el)});window.addEventListener('scroll',()=>{const w=document.querySelector('#inicio span');if(w)w.style.transform=`translateY(${window.scrollY*.08}px)`},{passive:true});\n</script>\n",
