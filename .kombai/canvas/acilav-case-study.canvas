"1-12-2-3\" data-name=\"changelog link\" href=\"#\">\n                Changelog\n            </a>\n            <a data-kid=\"1-12-2-4\" data-name=\"404 page link\" href=\"#\">\n                404\n            </a>\n            <a data-kid=\"1-12-2-5\" data-name=\"password page link\" href=\"#\">\n                Password\n            </a>\n        </div>\n        <div class=\"social-row wrap\" data-kid=\"1-12-3\" data-name=\"social media links row\">\n            <a data-kid=\"1-12-3-1\" data-name=\"facebook social link\" href=\"#\">\n                f\n            </a>\n            <a data-kid=\"1-12-3-2\" data-name=\"x social link\" href=\"#\">\n                𝕏\n            </a>\n            <a data-kid=\"1-12-3-3\" data-name=\"linkedin social link\" href=\"#\">\n                in\n            </a>\n            <a data-kid=\"1-12-3-4\" data-name=\"instagram social link\" href=\"#\">\n                ◎\n            </a>\n        </div>\n        <div class=\"footer-bottom\" data-kid=\"1-12-4\" data-name=\"footer copyright bottom text\">\n            © Copyright Acilav — Designed by Softvence — Powered by Webflow\n        </div>\n    </footer>\n    <style>\n        .site-footer{background:var(--paper);color:var(--ink);padding:110px 0 22px;border-top:1px solid var(--line)}\n      .footer-main{display:flex;justify-content:space-between;align-items:flex-start}.footer-brand{font:clamp(76px,10vw,150px)/.8 Anton;text-transform:uppercase}.footer-columns{display:flex;gap:90px;font-size:18px}.footer-columns>div{display:flex;flex-direction:column;gap:13px}.footer-columns h3{font:26px Anton;text-transform:uppercase;margin:0 0 12px}.footer-columns a,.footer-columns span{color:#666;line-height:1.35}.footer-links{display:flex;gap:72px;margin-top:86px;font-size:18px;color:#666}.social-row{display:grid;grid-template-columns:repeat(4,1fr);gap:38px;margin-top:55px}.social-row a{display:grid;place-items:center;height:118px;background:#fff9e9;box-shadow:0 10px 26px #0000000d;font:42px Inter}.footer-bottom{text-align:center;color:#888;font-size:18px;margin-top:44px}@media(max-width:760px){.site-footer{padding-top:70px}.footer-main{display:block}.footer-columns{margin-top:60px;gap:40px;flex-wrap:wrap}.footer-links{gap:18px;flex-wrap:wrap;margin-top:55px;font-size:14px}.social-row{gap:10px;margin-top:35px}.social-row a{height:72px;font-size:26px}.footer-bottom{font-size:12px;margin-top:28px}}\n    </style>\n</div>\n<script>\n    document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));t.classList.add('active')}));document.querySelectorAll('.price-tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.price-tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelector('#price').textContent=b.dataset.price}));document.querySelectorAll('.faq').forEach(f=>f.addEventListener('click',()=>f.classList.toggle('open')));const io=new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting&&e.target.classList.add('show')),{threshold:.12});document.querySelectorAll('.reveal').forEach(x=>io.observe(x));\n</script>\n",
