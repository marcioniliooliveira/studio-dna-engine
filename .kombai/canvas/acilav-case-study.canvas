=\"Client review\" data-kid=\"1-9-1-1-1\" data-name=\"client image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/copias/acilav-webflow-io/site/assets/69d88c4dc710fa8fc970ec04_review%20card%20image%201.avif\"/>\n                <div data-kid=\"1-9-1-1-2\" data-name=\"review content block\">\n                    <div class=\"label\" data-kid=\"1-9-1-1-2-1\" data-name=\"review label\">\n                        Review\n                    </div>\n                    <div class=\"quote\" data-kid=\"1-9-1-1-2-2\" data-name=\"client testimonial quote\">\n                        “SEO became our growth engine, not just another marketing task.”\n                    </div>\n                    <p class=\"sub\" data-kid=\"1-9-1-1-2-3\" data-name=\"author attribution\">\n                        — Happy client, Storey Creative\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section data-kid=\"1-10\" data-name=\"faq section\">\n        <div class=\"wrap\" data-kid=\"1-10-1\" data-name=\"faq wrapper\">\n            <div class=\"section-top\" data-kid=\"1-10-1-1\" data-name=\"faq header\">\n                <h2 class=\"heading\" data-kid=\"1-10-1-1-1\" data-name=\"faq heading\">\n                    FAQ\n                </h2>\n                <p class=\"sub\" data-kid=\"1-10-1-1-2\" data-name=\"faq sub-text\">\n                    Everything you need to know about working with us.\n                </p>\n            </div>\n            <div class=\"faq-list\" data-kid=\"1-10-1-2\" data-name=\"faq questions list\">\n                <div class=\"faq\" data-kid=\"1-10-1-2-1\" data-name=\"faq question 1\">\n                    <h3 data-kid=\"1-10-1-2-1-1\" data-name=\"faq question 1 heading\">\n                        How long does SEO take?\n                        <span data-kid=\"1-10-1-2-1-1-1\" data-name=\"faq 1 icon\">\n                            ＋\n                        </span>\n                    </h3>\n                    <p data-kid=\"1-10-1-2-1-2\" data-name=\"faq question 1 text\">\n                        Most campaigns begin showing meaningful movement within three to six months.\n                    </p>\n                </div>\n                <div class=\"faq\" data-kid=\"1-10-1-2-2\" data-name=\"faq question 2\">\n                    <h3 data-kid=\"1-10-1-2-2-1\" data-name=\"faq question 2 heading\">\n                        What makes your approach different?\n                        <span data-kid=\"1-10-1-2-2-1-1\" data-name=\"faq 2 icon\">\n                            ＋\n                        </span>\n                    </h3>\n                    <p data-kid=\"1-10-1-2-2-2\" data-name=\"faq question 2 text\">\n                        We combine technical clarity, strategic content and transparent reporting.\n                    </p>\n                </div>\n                <div class=\"faq\" data-kid=\"1-10-1-2-3\" data-name=\"faq question 3\">\n                    <h3 data-kid=\"1-10-1-2-3-1\" data-name=\"faq question 3 heading\">\n                        Do you work with small businesses?\n                        <span data-kid=\"1-10-1-2-3-1-1\" data-name=\"faq 3 icon\">\n                            ＋\n                        </span>\n                    </h3>\n                    <p data-kid=\"1-10-1-2-3-2\" data-name=\"faq question 3 text\">\n                        Yes. Our plans scale from small teams to enterprise organizations.\n                    </p>\n                </div>\n                <div class=\"faq\" data-kid=\"1-10-1-2-4\" data-name=\"faq question 4\">\n                    <h3 data-kid=\"1-10-1-2-4-1\" data-name=\"faq question 4 heading\">\n                        Can I cancel anytime?\n                        <span data-kid=\"1-10-1-2-4-1-1\" data-name=\"faq 4 icon\">\n                            ＋\n                        </span>\n                    </h3>\n                    <p data-kid=\"1-10-1-2-4-2\" data-name=\"faq question 4 text\">\n                        Plans are flexible and designed around long-term, measurable growth.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <style>\n        /* second fidelity pass: match the observed ACILAV reference proportions */\n      .nav img{width:132px}\n      .links{font-size:15px;text-transform:none;gap:38px}\n      .hero{min-height:820px;padding-top:150px}\n      .hero h1{text-align:center;font-size:clamp(125px,18vw,250px);line-height:.78}\n      .hero-art{height:500px;margin-top:-34px}\n      .hero-art img{width:420px;height:500px;object-fit:contain}\n      .hero-note{left:auto;right:38px;bottom:118px;max-width:245px;font-size:16px}\n      .scroll{left:26px;right:auto;bottom:78px}\n      .marquee{padding:24px 0}\n      @media(max-width:760px){\n        .nav img{width:104px}.links{display:none}\n        .hero{min-height:680px;padding-top:120px}\n        .hero h1{font-size:clamp(78px,22vw,150px)}\n        .hero-art{height:310px;margin-top:-12px}\n        .hero-art img{width:280px;height:320px}\n        .hero-note{right:20px;bottom:54px;font-size:12px}\n        .scroll{left:20px;bottom:34px}\n      }\n    </style>\n    <style>\n        /* hero composition fidelity: match the original horizontal lockup */\n      .hero h1{font-size:0;line-height:1;letter-spacing:-.045em;height:520px;position:relative;text-align:left}\n      .hero h1:before{content:'SEO';display:block;text-align:center;color:var(--ink);font:clamp(125px,34vw,430px)/.78 Anton,sans-serif;letter-spacing:-.045em}\n      .hero h1>br{display:none}\n      .hero h1>span{position:absolute;left:0;right:0;top:350px;display:block;white-space:nowrap;color:var(--ink);font:clamp(125px,18vw,250px)/.78 Anton,sans-serif;letter-spacing:-.045em}\n      .hero h1>span em{color:var(--yellow);font-style:normal}\n      .hero-art{margin-top:-172px;z-index:1}\n      .hero-art img{mask-image:linear-gradient(to bottom,#000 48%,rgba(0,0,0,.7) 80%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,#000 48%,rgba(0,0,0,.7) 80%,transparent 100%)}\n      @media(max-width:760px){\n        .hero h1{height:310px}\n        .hero h1:before{font-size:clamp(78px,22vw,150px)}\n        .hero h1>span{top:178px;font-size:clamp(78px,22vw,150px);white-space:normal;text-align:center}\n        .hero-art{margin-top:-38px}\n      }\n    </style>\n    <section class=\"cta\" data-kid=\"1-11\" data-name=\"call-to-action section\" id=\"contact\">\n        <h2 data-kid=\"1-11-1\" data-name=\"cta heading\">\n            Let's make\n            <br data-kid=\"1-11-1-1\" data-name=\"heading line break\"/>\n            <span data-kid=\"1-11-1-2\" data-name=\"heading highlighted span\">\n                impact\n            </span>\n        </h2>\n        <a class=\"btn\" data-kid=\"1-11-2\" data-name=\"footer contact button\" href=\"mailto:softvence@gmail.com\" style=\"background:var(--yellow);color:#111\">\n            Contact us\n        </a>\n    </section>\n    <footer class=\"site-footer\" data-kid=\"1-12\" data-name=\"site footer container\">\n        <div class=\"footer-main wrap\" data-kid=\"1-12-1\" data-name=\"footer main section\">\n            <div class=\"footer-brand\" data-kid=\"1-12-1-1\" data-name=\"footer logo text\">\n                ACILAV\n            </div>\n            <div class=\"footer-columns\" data-kid=\"1-12-1-2\" data-name=\"footer columns group\">\n                <div data-kid=\"1-12-1-2-1\" data-name=\"footer explore section\">\n                    <h3 data-kid=\"1-12-1-2-1-1\" data-name=\"footer explore heading\">\n                        Explore\n                    </h3>\n                    <a data-kid=\"1-12-1-2-1-2\" data-name=\"footer explore home link\" href=\"#top\">\n                        Home\n                    </a>\n                    <a data-kid=\"1-12-1-2-1-3\" data-name=\"footer explore about link\" href=\"#about\">\n                        About\n                    </a>\n 